+      const item = await api('POST', `${f.prefix}/items`, { name: `${days}`, expires_on: plus(date, days) }, f.token, 201);
+      assert.equal(item.days_left, days, zone);
+      items.push(item);
+    }
+    const noExpiry = await api('POST', `${f.prefix}/items`, { name: '永不过期' }, f.token, 201);
+    assert.equal(noExpiry.days_left, null);
+    const soon = (await api('GET', `${f.prefix}/items?expiring_within_days=3`, undefined, f.token)).items;
+    assert.deepEqual(soon.map((i) => i.days_left), [0, 1, 3]);
+    const expired = (await api('GET', `${f.prefix}/items?expired=true`, undefined, f.token)).items;
+    assert.deepEqual(expired.map((i) => i.days_left), [-2, -1]);
+    const dueToday = (await api('GET', `${f.prefix}/items?expiring_within_days=0`, undefined, f.token)).items;
+    assert.deepEqual(dueToday.map((i) => i.id), [items[2].id]);
+  }
+});
+
+test('limit、日期筛选与游标参数严格校验', async () => {
+  const f = await fixture();
+  for (const query of [
+    ...['0', '101', '-1', '1.5', 'abc', '', '1e1', 'NaN'].map((v) => `limit=${v}`),
+    ...['-1', '366', '1.5', 'abc', '', '1e2'].map((v) => `expiring_within_days=${v}`),
+    'expired=1', 'expired=TRUE', 'expired=', 'expired=true&expiring_within_days=3',
+    'cursor=', 'cursor=garbage', 'cursor=e30.invalid', 'limit=1&limit=2',
+  ]) await api('GET', `${f.prefix}/items?${query}`, undefined, f.token, 400);
+  for (const query of ['limit=1', 'limit=100', 'expiring_within_days=365', 'expired=false']) {
+    assert.deepEqual(await api('GET', `${f.prefix}/items?${query}`, undefined, f.token), { items: [], next_cursor: null });
+  }
+});
+
+for (const mode of ['all', 'within', 'expired']) {
+  test(`${mode} 分页排序稳定，删除前页和页尾后不重不漏`, async () => {
+    const f = await fixture();
+    const date = today(f.home.timezone);
+    const offsets = mode === 'expired' ? [-2, -4, -1, -3, -2, -4, -3, -1, -2] : [2, 0, 3, 1, 2, 0, 1, 3, 2];
+    const created = [];
+    for (const [i, offset] of offsets.entries()) created.push(await api('POST', `${f.prefix}/items`,
+      { name: `item-${i}`, expires_on: plus(date, offset) }, f.token, 201));
+    const expected = mode === 'all' ? created : [...created].sort((a, b) => a.expires_on.localeCompare(b.expires_on));
+    const query = mode === 'all' ? '' : mode === 'within' ? '&expiring_within_days=3' : '&expired=true';
+    let page = await api('GET', `${f.prefix}/items?limit=2${query}`, undefined, f.token);
+    const seen = [...page.items];
+    assert.ok(page.next_cursor);
+    const originalCursor = page.next_cursor;
+    for (const item of page.items) await api('DELETE', `${f.prefix}/items/${item.id}`, undefined, f.token, 204);
+    // Inserts during traversal are outside the first page's creation ceiling.
+    await api('POST', `${f.prefix}/items`, { name: 'new', expires_on: plus(date, offsets[0]) }, f.token, 201);
+    let pages = 1;
+    while (page.next_cursor) {
+      page = await api('GET', `${f.prefix}/items?limit=2${query}&cursor=${encodeURIComponent(page.next_cursor)}`, undefined, f.token);
+      seen.push(...page.items);
+      assert.ok(++pages < 10);
+    }
+    assert.deepEqual(seen.map((i) => i.id), expected.map((i) => i.id));
+    assert.equal(new Set(seen.map((i) => i.id)).size, created.length);
+    assert.equal(page.next_cursor, null);
+    await api('GET', `${f.prefix}/items?limit=2${query}&cursor=${originalCursor}x`, undefined, f.token, 400);
+    const another = await household(f.token);
+    await api('GET', `/v1/households/${another.id}/items?limit=2${query}&cursor=${originalCursor}`, undefined, f.token, 400);
+    const different = mode === 'all' ? '&expired=true' : '';
+    await api('GET', `${f.prefix}/items?limit=2${different}&cursor=${originalCursor}`, undefined, f.token, 400);
+  });
+}
+
+test('默认每页 20 条、并发创建的物品全部恰好返回一次', async () => {
+  const f = await fixture();
+  const created = await Promise.all(Array.from({ length: 25 }, (_, i) => api('POST', `${f.prefix}/items`, { name: `${i}` }, f.token, 201)));
+  const first = await api('GET', `${f.prefix}/items`, undefined, f.token);
+  assert.equal(first.items.length, 20);
+  assert.ok(first.next_cursor);
+  const second = await api('GET', `${f.prefix}/items?cursor=${first.next_cursor}`, undefined, f.token);
+  assert.equal(second.items.length, 5);
+  assert.equal(second.next_cursor, null);
+  assert.deepEqual([...first.items, ...second.items].map((i) => i.id).sort(), created.map((i) => i.id).sort());
+});
+
+test('定时处理使用 scheduledTime 和家庭日期，范围含 0/3 天，重复并发触发唯一', async () => {
+  const instant = '2026-11-18T10:30:00Z';
+  const cases = [];
+  for (const zone of ['Pacific/Kiritimati', 'Etc/GMT+12', 'Asia/Singapore', 'America/New_York']) {
+    const f = await fixture(zone);
+    const date = today(zone, Date.parse(instant));
+    const items = [];
+    for (const offset of [-1, 0, 1, 3, 4]) items.push(await api('POST', `${f.prefix}/items`,
+      { name: `milk-${offset}`, quantity: 0, expires_on: plus(date, offset) }, f.token, 201));
+    await api('POST', `${f.prefix}/items`, { name: 'no-expiry' }, f.token, 201);
+    cases.push({ f, date, items });
+  }
+  await Promise.all(Array.from({ length: 5 }, () => scheduled(instant)));
+  await scheduled('2026-11-18T11:30:00Z');
+  for (const { f, date, items } of cases) {
+    const reminders = (await api('GET', `${f.prefix}/reminders`, undefined, f.token)).reminders;
+    assert.equal(reminders.length, 3, f.home.timezone);
+    assert.deepEqual(reminders.map((r) => r.item_id), items.slice(1, 4).map((i) => i.id));
+    for (const r of reminders) {
+      assert.equal(typeof r.id, 'string');
+      assert.equal(r.remind_on, date);
+      const item = items.find((i) => i.id === r.item_id);
+      assert.equal(r.item_name, item.name);
+      assert.equal(r.expires_on, item.expires_on);
+    }
+  }
+  await scheduled('2026-11-19T10:30:00Z');
+  for (const { f, date, items } of cases) {
+    const reminders = (await api('GET', `${f.prefix}/reminders`, undefined, f.token)).reminders;
+    assert.equal(reminders.length, 6);
+    assert.deepEqual(reminders.slice(3).map((r) => r.item_id), items.slice(2, 5).map((i) => i.id));
+    assert.ok(reminders.slice(3).every((r) => r.remind_on === plus(date, 1)));
+    assert.deepEqual(reminders.map((r) => `${r.remind_on}:${r.expires_on}`),
+      reminders.map((r) => `${r.remind_on}:${r.expires_on}`).sort());
+    assert.equal(new Set(reminders.map((r) => `${r.item_id}:${r.remind_on}`)).size, 6);
+  }
+});
+
+test('定时提醒跨家庭当地午夜和夏令时跳时/回拨仍按日唯一', async () => {
+  const singapore = await fixture('Asia/Singapore');
+  await api('POST', `${singapore.prefix}/items`, { name: 'midnight', expires_on: '2028-01-03' }, singapore.token, 201);
+  await scheduled('2028-01-01T15:59:00Z');
+  await scheduled('2028-01-01T16:00:00Z');
+  assert.deepEqual((await api('GET', `${singapore.prefix}/reminders`, undefined, singapore.token)).reminders.map((r) => r.remind_on),
+    ['2028-01-01', '2028-01-02']);
+  for (const [expires, instants, expected] of [
+    ['2026-03-09', ['2026-03-08T06:59:00Z', '2026-03-08T07:01:00Z', '2026-03-09T03:59:00Z', '2026-03-09T04:01:00Z'], ['2026-03-08', '2026-03-09']],
+    ['2026-11-02', ['2026-11-01T05:30:00Z', '2026-11-01T06:30:00Z', '2026-11-02T04:59:00Z', '2026-11-02T05:01:00Z'], ['2026-11-01', '2026-11-02']],
+  ]) {
+    const f = await fixture('America/New_York');
+    await api('POST', `${f.prefix}/items`, { name: 'DST', expires_on: expires }, f.token, 201);
+    for (const instant of instants) await scheduled(instant);
+    assert.deepEqual((await api('GET', `${f.prefix}/reminders`, undefined, f.token)).reminders.map((r) => r.remind_on), expected);
+  }
+});
+
+test('物品删除级联清理提醒；数据库外键保持完整', async () => {
+  const f = await fixture('UTC');
+  const item = await api('POST', `${f.prefix}/items`, { name: 'delete', expires_on: '2035-01-01' }, f.token, 201);
+  await scheduled('2035-01-01T00:00:00Z');
+  assert.equal((await api('GET', `${f.prefix}/reminders`, undefined, f.token)).reminders.length, 1);
+  await api('DELETE', `${f.prefix}/items/${item.id}`, undefined, f.token, 204);
+  assert.deepEqual((await api('GET', `${f.prefix}/reminders`, undefined, f.token)).reminders, []);
+  assert.deepEqual(await sql('PRAGMA foreign_key_check'), []);
+});

+PRAGMA foreign_keys = ON;
+
+CREATE TABLE users (
+  id TEXT PRIMARY KEY,
+  email TEXT NOT NULL UNIQUE COLLATE NOCASE,
+  password_hash TEXT NOT NULL,
+  CHECK (email = lower(email))
+);
+
+CREATE TABLE households (
+  id TEXT PRIMARY KEY,
+  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
+  timezone TEXT NOT NULL
+);
+
+CREATE TABLE household_members (
+  household_id TEXT NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  role TEXT NOT NULL CHECK (role IN ('owner', 'member')),
+  PRIMARY KEY (household_id, user_id)
+);
+CREATE INDEX members_by_user ON household_members(user_id, household_id);
+CREATE UNIQUE INDEX one_owner_per_household ON household_members(household_id) WHERE role = 'owner';
+
+CREATE TABLE invites (
+  code TEXT PRIMARY KEY,
+  household_id TEXT NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  expires_at_ms INTEGER NOT NULL,
+  used_by TEXT REFERENCES users(id),
+  used_at_ms INTEGER,
+  CHECK ((used_by IS NULL) = (used_at_ms IS NULL))
+);
+CREATE INDEX invites_by_household ON invites(household_id);
+
+-- Consuming an invitation and adding the member are one atomic database write.
+-- A membership constraint failure rolls back the invitation update as well.
+CREATE TRIGGER accept_invite_membership
+AFTER UPDATE OF used_by ON invites
+WHEN OLD.used_by IS NULL AND NEW.used_by IS NOT NULL
+BEGIN
+  INSERT INTO household_members (household_id, user_id, role)
+  VALUES (NEW.household_id, NEW.used_by, 'member');
+END;
+
+CREATE TABLE locations (
+  id TEXT PRIMARY KEY,
+  household_id TEXT NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
+  parent_id TEXT,
+  depth INTEGER NOT NULL CHECK (depth BETWEEN 1 AND 3),
+  UNIQUE (household_id, id),
+  FOREIGN KEY (household_id, parent_id) REFERENCES locations(household_id, id) ON DELETE RESTRICT,
+  CHECK ((parent_id IS NULL AND depth = 1) OR (parent_id IS NOT NULL AND depth > 1))
+);
+CREATE INDEX locations_by_parent ON locations(household_id, parent_id);
+
+CREATE TABLE items (
+  seq INTEGER PRIMARY KEY AUTOINCREMENT,
+  id TEXT NOT NULL UNIQUE,
+  household_id TEXT NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  name TEXT NOT NULL CHECK (length(trim(name)) > 0),
+  quantity INTEGER NOT NULL DEFAULT 1 CHECK (typeof(quantity) = 'integer' AND quantity >= 0),
+  location_id TEXT,
+  expires_on TEXT,
+  UNIQUE (household_id, id),
+  FOREIGN KEY (household_id, location_id) REFERENCES locations(household_id, id) ON DELETE RESTRICT
+);
+CREATE INDEX items_by_creation ON items(household_id, seq);
+CREATE INDEX items_by_expiration ON items(household_id, expires_on, seq);
+CREATE INDEX items_by_location ON items(household_id, location_id);
+
+CREATE TABLE reminders (
+  id TEXT PRIMARY KEY,
+  household_id TEXT NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  item_id TEXT NOT NULL,
+  item_name TEXT NOT NULL,
+  expires_on TEXT NOT NULL,
+  remind_on TEXT NOT NULL,
+  FOREIGN KEY (household_id, item_id) REFERENCES items(household_id, id) ON DELETE CASCADE,
+  UNIQUE (item_id, remind_on)
+);
+CREATE INDEX reminders_by_day ON reminders(household_id, remind_on, expires_on, id);

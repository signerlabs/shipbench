+import { randomBytes } from 'node:crypto';
+import { writeFile } from 'node:fs/promises';
+
+try {
+  await writeFile(new URL('../.dev.vars', import.meta.url),
+    `TOKEN_SECRET=${randomBytes(48).toString('base64url')}\n`,
+    { flag: 'wx', mode: 0o600 });
+  console.log('已生成本地 .dev.vars（不会覆盖已有密钥）。');
+} catch (error) {
+  if (error.code !== 'EEXIST') throw error;
+  console.log('.dev.vars 已存在，保留原密钥。');
+}
diff --git a/src/auth.ts b/src/auth.ts
new file mode 100644
index 0000000..26f5dc2
--- /dev/null
+++ b/src/auth.ts
@@ -0,0 +1,47 @@
+import { fail, json } from './http';
+import { hashPassword, randomCode, sign, verify, verifyPassword } from './security';
+import type { Body, Env, User } from './types';
+
+function credentials(body: Body): { email: string; password: string } {
+  if (typeof body.email !== 'string' || !body.email.includes('@')) fail(400, '邮箱必须包含 @');
+  if (typeof body.password !== 'string' || [...body.password].length < 8) fail(400, '密码至少 8 个字符');
+  return { email: body.email.toLowerCase(), password: body.password };
+}
+
+async function tokenFor(env: Env, userId: string): Promise<string> {
+  return sign(env, 'auth', { v: 1, sub: userId, exp: Date.now() + 30 * 86_400_000, nonce: randomCode() });
+}
+
+export async function register(env: Env, body: Body): Promise<Response> {
+  const { email, password } = credentials(body);
+  const user = { id: crypto.randomUUID(), email };
+  const token = await tokenFor(env, user.id);
+  const passwordHash = await hashPassword(password);
+  const inserted = await env.DB.prepare(`INSERT INTO users (id, email, password_hash)
+    VALUES (?, ?, ?) ON CONFLICT(email) DO NOTHING RETURNING id`)
+    .bind(user.id, email, passwordHash).first();
+  if (!inserted) fail(409, '邮箱已注册');
+  return json({ user, token }, 201);
+}
+
+export async function login(env: Env, body: Body): Promise<Response> {
+  const { email, password } = credentials(body);
+  const row = await env.DB.prepare('SELECT id, email, password_hash FROM users WHERE email = ?')
+    .bind(email).first<User & { password_hash: string }>();
+  if (!row || !await verifyPassword(password, row.password_hash)) fail(401, '邮箱或密码错误');
+  const user = { id: row.id, email: row.email };
+  return json({ user, token: await tokenFor(env, user.id) });
+}
+
+export async function authenticate(request: Request, env: Env): Promise<User> {
+  const match = /^Bearer ([^\s]+)$/i.exec(request.headers.get('Authorization') ?? '');
+  if (!match) fail(401, '需要 Bearer token');
+  const payload = await verify(env, 'auth', match[1]) as Record<string, unknown> | null;
+  if (!payload || payload.v !== 1 || typeof payload.sub !== 'string'
+    || typeof payload.exp !== 'number' || !Number.isSafeInteger(payload.exp) || payload.exp <= Date.now()) {
+    fail(401, '令牌无效或已过期');
+  }
+  const user = await env.DB.prepare('SELECT id, email FROM users WHERE id = ?').bind(payload.sub).first<User>();
+  if (!user) fail(401, '令牌无效');
+  return user;
+}
diff --git a/src/dates.ts b/src/dates.ts
new file mode 100644
index 0000000..8840c74
--- /dev/null
+++ b/src/dates.ts
@@ -0,0 +1,47 @@
+import { fail } from './http';
+
+const DAY_MS = 86_400_000;
+
+export function validDate(value: unknown): value is string {
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
+  if (value.startsWith('0000')) return false;
+  const parsed = new Date(`${value}T00:00:00.000Z`);
+  return Number.isFinite(parsed.getTime()) && parsed.toISOString().slice(0, 10) === value;
+}
+
+export function expiration(value: unknown): string | null {
+  if (value === null) return null;
+  if (!validDate(value)) fail(400, '日期必须是有效的 YYYY-MM-DD');
+  return value;
+}
+
+export function timezone(value: unknown): string {
+  // Intl also accepts numeric offsets in newer runtimes; those are not IANA names.
+  if (typeof value !== 'string' || !value || /^[+-]/.test(value)) fail(400, '无效的 IANA 时区');
+  try {
+    new Intl.DateTimeFormat('en-US', { timeZone: value }).format(0);
+  } catch {
+    fail(400, '无效的 IANA 时区');
+  }
+  return value;
+}
+
+export function todayIn(timeZone: string, instant: number): string {
+  const parts = new Intl.DateTimeFormat('en-US', {
+    timeZone, year: 'numeric', month: '2-digit', day: '2-digit',
+    calendar: 'gregory', numberingSystem: 'latn',
+  }).formatToParts(new Date(instant));
+  const part = (type: string) => parts.find((p) => p.type === type)!.value;
+  return `${part('year').padStart(4, '0')}-${part('month')}-${part('day')}`;
+}
+
+// Calendar dates are converted to UTC midnights only for date arithmetic. This
+// deliberately avoids dividing local timestamps across 23/25-hour DST days.
+export function addDays(date: string, days: number): string {
+  return new Date(Date.parse(`${date}T00:00:00Z`) + days * DAY_MS).toISOString().slice(0, 10);
+}
+
+export function daysLeft(date: string | null, today: string): number | null {
+  if (date === null) return null;
+  return (Date.parse(`${date}T00:00:00Z`) - Date.parse(`${today}T00:00:00Z`)) / DAY_MS;
+}
diff --git a/src/db.ts b/src/db.ts
new file mode 100644
index 0000000..dedaff6
--- /dev/null
+++ b/src/db.ts
@@ -0,0 +1,34 @@
+import { fail } from './http';
+import type { Env, Household } from './types';
+
+export const MEMBER = `EXISTS (
+  SELECT 1 FROM household_members AS access
+  WHERE access.household_id = ?1 AND access.user_id = ?2
+)`;
+export const OWNER = `EXISTS (
+  SELECT 1 FROM household_members AS access
+  WHERE access.household_id = ?1 AND access.user_id = ?2 AND access.role = 'owner'
+)`;
+
+export class HouseholdDB {
+  constructor(readonly env: Env, readonly id: string, readonly userId: string) {}
+
+  // Every scoped statement reserves ?1 for household and ?2 for acting user.
+  prepare(sql: string, ...values: (string | number | null)[]): D1PreparedStatement {
+    return this.env.DB.prepare(sql).bind(this.id, this.userId, ...values);
+  }
+
+  async batch(statements: D1PreparedStatement[]): Promise<{ household: Household; results: D1Result[] }> {
+    // Authorization and the operation see the same database snapshot. Mutations
+    // also use MEMBER/OWNER predicates so a kicked user can never write data.
+    const [access, ...results] = await this.env.DB.batch([
+      this.prepare(`SELECT h.id, h.name, h.timezone, m.role FROM households h
+        JOIN household_members m ON m.household_id = h.id
+        WHERE h.id = ?1 AND m.user_id = ?2`),
+      ...statements,
+    ]);
+    const household = access.results[0] as unknown as Household | undefined;
+    if (!household) fail(404, '家庭不存在');
+    return { household, results };
+  }
+}
diff --git a/src/households.ts b/src/households.ts
new file mode 100644
index 0000000..4baa214
--- /dev/null
+++ b/src/households.ts
@@ -0,0 +1,84 @@
+import { HouseholdDB, MEMBER, OWNER } from './db';
+import { timezone } from './dates';
+import { empty, fail, json, name } from './http';
+import { randomCode } from './security';
+import type { Body, Env, Household } from './types';
+
+export async function createHousehold(env: Env, userId: string, body: Body): Promise<Response> {
+  const household: Household = {
+    id: crypto.randomUUID(), name: name(body.name), timezone: timezone(body.timezone), role: 'owner',
+  };
+  await env.DB.batch([
+    env.DB.prepare('INSERT INTO households (id, name, timezone) VALUES (?, ?, ?)')
+      .bind(household.id, household.name, household.timezone),
+    env.DB.prepare("INSERT INTO household_members (household_id, user_id, role) VALUES (?, ?, 'owner')")
+      .bind(household.id, userId),
+  ]);
+  return json(household, 201);
+}
+
+export async function listHouseholds(env: Env, userId: string): Promise<Response> {
+  const { results } = await env.DB.prepare(`SELECT h.id, h.name, h.timezone, m.role FROM households h
+    JOIN household_members m ON m.household_id = h.id WHERE m.user_id = ? ORDER BY h.id`)
+    .bind(userId).all();
+  return json({ households: results });
+}
+
+export async function createInvite(db: HouseholdDB): Promise<Response> {
+  const code = randomCode();
+  const expires_at_ms = Date.now() + 86_400_000;
+  const { household } = await db.batch([
+    db.prepare(`INSERT INTO invites (code, household_id, expires_at_ms)
+      SELECT ?3, ?1, ?4 WHERE ${OWNER}`, code, expires_at_ms),
+  ]);
+  if (household.role !== 'owner') fail(403, '只有 owner 可以邀请');
+  return json({ code, expires_at_ms }, 201);
+}
+
+export async function acceptInvite(env: Env, userId: string, code: string): Promise<Response> {
+  const now = Date.now();
+  const [before, accepted, after] = await env.DB.batch([
+    env.DB.prepare(`SELECT i.expires_at_ms, i.used_by,
+      EXISTS(SELECT 1 FROM household_members m WHERE m.household_id = i.household_id AND m.user_id = ?2) AS is_member
+      FROM invites i WHERE i.code = ?1`).bind(code, userId),
+    // The trigger inserts membership in this same transaction. The predicate is
+    // re-evaluated by SQLite; competing requests cannot both claim the code.
+    env.DB.prepare(`UPDATE invites SET used_by = ?2, used_at_ms = ?3
+      WHERE code = ?1 AND used_by IS NULL AND expires_at_ms > ?3
+      AND NOT EXISTS(SELECT 1 FROM household_members m
+        WHERE m.household_id = invites.household_id AND m.user_id = ?2)
+      RETURNING household_id`).bind(code, userId, now),
+    env.DB.prepare(`SELECT h.id, h.name, h.timezone, m.role FROM invites i
+      JOIN households h ON h.id = i.household_id
+      JOIN household_members m ON m.household_id = h.id AND m.user_id = ?2
+      WHERE i.code = ?1`).bind(code, userId),
+  ]);
+  const invite = before.results[0] as { expires_at_ms: number; used_by: string | null; is_member: number } | undefined;
+  if (!invite) fail(404, '邀请码不存在');
+  if (invite.used_by !== null || Number(invite.expires_at_ms) <= now) fail(410, '邀请码已使用或已过期');
+  if (invite.is_member) fail(409, '已经是家庭成员');
+  if (!accepted.results.length) throw new Error('Invitation acceptance invariant failed');
+  return json({ household: after.results[0] });
+}
+
+export async function listMembers(db: HouseholdDB): Promise<Response> {
+  const { results } = await db.batch([
+    db.prepare(`SELECT m.user_id, u.email, m.role FROM household_members m
+      JOIN users u ON u.id = m.user_id
+      WHERE m.household_id = ?1 AND ${MEMBER}
+      ORDER BY CASE m.role WHEN 'owner' THEN 0 ELSE 1 END, m.user_id`),
+  ]);
+  return json({ members: results[0].results });
+}
+
+export async function deleteMember(db: HouseholdDB, target: string): Promise<Response> {
+  const { household, results } = await db.batch([
+    db.prepare(`SELECT role FROM household_members WHERE household_id = ?1 AND user_id = ?3 AND ${MEMBER}`, target),
+    db.prepare(`DELETE FROM household_members WHERE household_id = ?1 AND user_id = ?3
+      AND role = 'member' AND ${MEMBER} AND (user_id = ?2 OR ${OWNER}) RETURNING user_id`, target),
+  ]);
+  if (!results[0].results.length) fail(404, '成员不存在');
+  if (household.role === 'owner' && target === db.userId) fail(400, 'owner 不能退出家庭');
+  if (household.role !== 'owner' && target !== db.userId) fail(403, '不能删除其他成员');
+  return empty();
+}
diff --git a/src/http.ts b/src/http.ts
new file mode 100644
index 0000000..231b4dd
--- /dev/null
+++ b/src/http.ts
@@ -0,0 +1,92 @@
+import type { Body } from './types';
+
+export class HttpError extends Error {
+  constructor(public status: number, message: string) {
+    super(message);
+  }
+}
+
+export function fail(status: number, message: string): never {
+  throw new HttpError(status, message);
+}
+
+export function json(data: unknown, status = 200): Response {
+  return Response.json(data, { status, headers: { 'Cache-Control': 'no-store' } });
+}
+
+export function empty(): Response {
+  return new Response(null, { status: 204 });
+}
+
+const MAX_BODY_BYTES = 64 * 1024;
+
+// Count actual streamed bytes, including when Content-Length is absent or false.
+export async function readBody(request: Request): Promise<Body | undefined> {
+  const length = request.headers.get('content-length');
+  if (length !== null && Number(length) > MAX_BODY_BYTES) fail(413, '请求体超过 64 KB');
+  if (!request.body) return undefined;
+  const reader = request.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.byteLength;
+      if (size > MAX_BODY_BYTES) {
+        await reader.cancel();
+        fail(413, '请求体超过 64 KB');
+      }
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  if (!size) return undefined;
+  const bytes = new Uint8Array(size);
+  let offset = 0;
+  for (const chunk of chunks) {
+    bytes.set(chunk, offset);
+    offset += chunk.length;
+  }
+  let value: unknown;
+  try {
+    value = JSON.parse(new TextDecoder('utf-8', { fatal: true, ignoreBOM: false }).decode(bytes));
+  } catch {
+    fail(400, '请求体必须是合法 JSON');
+  }
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) {
+    fail(400, '请求体必须是 JSON 对象');
+  }
+  return value as Body;
+}
+
+export function requiredBody(body: Body | undefined): Body {
+  if (!body) fail(400, '缺少 JSON 请求体');
+  return body;
+}
+
+export function name(value: unknown): string {
+  if (typeof value !== 'string' || !value.trim()) fail(400, 'name 必须为非空字符串');
+  return value.trim();
+}
+
+export function nullableId(value: unknown): string | null {
+  if (value === null) return null;
+  if (typeof value !== 'string' || !value.trim()) fail(400, 'id 必须为非空字符串或 null');
+  return value;
+}
+
+export function quantity(value: unknown): number {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0) {
+    fail(400, 'quantity 必须为非负安全整数');
+  }
+  return value;
+}
+
+export function integerParam(value: string, min: number, max: number): number {
+  if (!/^\d+$/.test(value)) fail(400, '查询参数必须为整数');
+  const n = Number(value);
+  if (!Number.isSafeInteger(n) || n < min || n > max) fail(400, '查询参数超出范围');
+  return n;
+}
diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..d603c12
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,72 @@
+import { authenticate, login, register } from './auth';
+import { HouseholdDB } from './db';
+import { acceptInvite, createHousehold, createInvite, deleteMember, listHouseholds, listMembers } from './households';
+import { HttpError, fail, json, readBody, requiredBody } from './http';
+import { createItem, deleteItem, getItem, listItems, patchItem } from './items';
+import { createLocation, deleteLocation, listLocations } from './locations';
+import { generateReminders, listReminders } from './reminders';
+import type { Env } from './types';
+
+async function route(request: Request, env: Env): Promise<Response> {
+  const url = new URL(request.url);
+  const method = request.method;
+  const isRegister = method === 'POST' && url.pathname === '/v1/auth/register';
+  const isLogin = method === 'POST' && url.pathname === '/v1/auth/login';
+  const user = isRegister || isLogin ? null : await authenticate(request, env);
+  const body = await readBody(request);
+  if (isRegister) return register(env, requiredBody(body));
+  if (isLogin) return login(env, requiredBody(body));
+  if (method === 'GET' && url.pathname === '/v1/me') return json(user);
+  if (url.pathname === '/v1/households') {
+    if (method === 'POST') return createHousehold(env, user!.id, requiredBody(body));
+    if (method === 'GET') return listHouseholds(env, user!.id);
+  }
+  let path: string[];
+  try { path = url.pathname.split('/').slice(1).map(decodeURIComponent); }
+  catch { fail(400, '无效的路径编码'); }
+  if (method === 'POST' && path.length === 4 && path[0] === 'v1' && path[1] === 'invites' && path[3] === 'accept') {
+    return acceptInvite(env, user!.id, path[2]);
+  }
+  if (path[0] !== 'v1' || path[1] !== 'households' || !path[2]) fail(404, '接口不存在');
+  const db = new HouseholdDB(env, path[2], user!.id);
+  // Hide inaccessible households before interpreting resource fields/cursors.
+  // Handlers still authorize inside their final transaction to cover revocation.
+  const { household } = await db.batch([]);
+  if (path.length === 3 && method === 'GET') return json(household);
+  if (path.length === 4) {
+    switch (`${method} ${path[3]}`) {
+      case 'POST invites': return createInvite(db);
+      case 'GET members': return listMembers(db);
+      case 'POST locations': return createLocation(db, requiredBody(body));
+      case 'GET locations': return listLocations(db);
+      case 'POST items': return createItem(db, requiredBody(body));
+      case 'GET items': return listItems(db, url.searchParams, household);
+      case 'GET reminders': return listReminders(db);
+    }
+  }
+  if (path.length === 5 && path[4]) {
+    switch (`${method} ${path[3]}`) {
+      case 'DELETE members': return deleteMember(db, path[4]);
+      case 'DELETE locations': return deleteLocation(db, path[4]);
+      case 'GET items': return getItem(db, path[4]);
+      case 'PATCH items': return patchItem(db, path[4], requiredBody(body));
+      case 'DELETE items': return deleteItem(db, path[4]);
+    }
+  }
+  fail(404, '接口不存在');
+}
+
+export default {
+  async fetch(request: Request, env: Env): Promise<Response> {
+    try {
+      return await route(request, env);
+    } catch (error) {
+      if (error instanceof HttpError) return json({ error: error.message }, error.status);
+      console.error('Request failed', error);
+      return json({ error: '服务暂时不可用' }, 500);
+    }
+  },
+  async scheduled(event: ScheduledController, env: Env): Promise<void> {
+    await generateReminders(env, event.scheduledTime);
+  },
+} satisfies ExportedHandler<Env>;
diff --git a/src/items.ts b/src/items.ts
new file mode 100644
index 0000000..1aaff0e
--- /dev/null
+++ b/src/items.ts
@@ -0,0 +1,139 @@
+import { HouseholdDB, MEMBER } from './db';
+import { addDays, daysLeft, expiration, todayIn, validDate } from './dates';
+import { empty, fail, integerParam, json, name, nullableId, quantity } from './http';
+import { sign, verify } from './security';
+import type { Body, Household, ItemRow } from './types';
+
+const COLUMNS = 'seq, id, name, quantity, location_id, expires_on';
+
+function present(row: ItemRow, today: string) {
+  const { seq: _seq, ...item } = row;
+  return { ...item, days_left: daysLeft(item.expires_on, today) };
+}
+
+export async function createItem(db: HouseholdDB, body: Body): Promise<Response> {
+  const item = {
+    id: crypto.randomUUID(), name: name(body.name),
+    quantity: 'quantity' in body ? quantity(body.quantity) : 1,
+    location_id: 'location_id' in body ? nullableId(body.location_id) : null,
+    expires_on: 'expires_on' in body ? expiration(body.expires_on) : null,
+  };
+  const { household, results } = await db.batch([
+    db.prepare(`INSERT INTO items (id, household_id, name, quantity, location_id, expires_on)
+      SELECT ?3, ?1, ?4, ?5, ?6, ?7 WHERE ${MEMBER}
+      AND (?6 IS NULL OR EXISTS(SELECT 1 FROM locations WHERE household_id = ?1 AND id = ?6))
+      RETURNING ${COLUMNS}`, item.id, item.name, item.quantity, item.location_id, item.expires_on),
+  ]);
+  if (!results[0].results.length) fail(400, 'location_id 不属于本家庭');
+  return json(present(results[0].results[0] as unknown as ItemRow, todayIn(household.timezone, Date.now())), 201);
+}
+
+export async function getItem(db: HouseholdDB, id: string): Promise<Response> {
+  const { household, results } = await db.batch([
+    db.prepare(`SELECT ${COLUMNS} FROM items WHERE household_id = ?1 AND id = ?3 AND ${MEMBER}`, id),
+  ]);
+  const item = results[0].results[0] as unknown as ItemRow | undefined;
+  if (!item) fail(404, '物品不存在');
+  return json(present(item, todayIn(household.timezone, Date.now())));
+}
+
+export async function patchItem(db: HouseholdDB, id: string, body: Body): Promise<Response> {
+  const target = await db.batch([
+    db.prepare(`SELECT id FROM items WHERE household_id = ?1 AND id = ?3 AND ${MEMBER}`, id),
+  ]);
+  if (!target.results[0].results.length) fail(404, '物品不存在');
+  const assignments: string[] = [];
+  const values: (string | number | null)[] = [id];
+  let locationGuard = '';
+  // Only supplied columns are updated, so concurrent disjoint patches do not
+  // overwrite each other with stale copies of unspecified fields.
+  for (const [field, validate] of Object.entries({ name, quantity, location_id: nullableId, expires_on: expiration })) {
+    if (!Object.hasOwn(body, field)) continue;
+    values.push(validate(body[field]));
+    const param = `?${values.length + 2}`;
+    assignments.push(`${field} = ${param}`);
+    if (field === 'location_id') locationGuard = ` AND (${param} IS NULL OR EXISTS(
+      SELECT 1 FROM locations WHERE household_id = ?1 AND id = ${param}))`;
+  }
+  const { household, results } = await db.batch([
+    db.prepare(`SELECT id FROM items WHERE household_id = ?1 AND id = ?3 AND ${MEMBER}`, id),
+    db.prepare(`UPDATE items SET ${assignments.length ? assignments.join(', ') : 'name = name'}
+      WHERE household_id = ?1 AND id = ?3 AND ${MEMBER}${locationGuard} RETURNING ${COLUMNS}`, ...values),
+  ]);
+  if (!results[0].results.length) fail(404, '物品不存在');
+  if (!results[1].results.length) fail(400, 'location_id 不属于本家庭');
+  return json(present(results[1].results[0] as unknown as ItemRow, todayIn(household.timezone, Date.now())));
+}
+
+export async function deleteItem(db: HouseholdDB, id: string): Promise<Response> {
+  const { results } = await db.batch([
+    db.prepare(`DELETE FROM items WHERE household_id = ?1 AND id = ?3 AND ${MEMBER} RETURNING id`, id),
+  ]);
+  if (!results[0].results.length) fail(404, '物品不存在');
+  return empty();
+}
+
+interface Cursor {
+  v: 1;
+  household: string;
+  filter: string;
+  today: string;
+  seq: number;
+  expires: string | null;
+  ceiling: number;
+}
+
+export async function listItems(db: HouseholdDB, params: URLSearchParams, household: Household): Promise<Response> {
+  for (const key of ['limit', 'cursor', 'expiring_within_days', 'expired']) {
+    if (params.getAll(key).length > 1) fail(400, '查询参数不能重复');
+  }
+  const limit = params.has('limit') ? integerParam(params.get('limit')!, 1, 100) : 20;
+  const within = params.has('expiring_within_days') ? integerParam(params.get('expiring_within_days')!, 0, 365) : null;
+  if (params.has('expired') && !['true', 'false'].includes(params.get('expired')!)) fail(400, 'expired 必须为 true 或 false');
+  const expired = params.get('expired') === 'true';
+  if (expired && within !== null) fail(400, '不能同时使用两种过期筛选');
+  const filter = expired ? 'expired' : within !== null ? `within:${within}` : 'all';
+  const sortedByDate = filter !== 'all';
+  let cursor: Cursor | null = null;
+  if (params.has('cursor')) {
+    const value = await verify(db.env, 'cursor', params.get('cursor')!) as Cursor | null;
+    if (!value || value.v !== 1 || value.household !== db.id || value.filter !== filter || !validDate(value.today)
+      || !Number.isSafeInteger(value.seq) || value.seq < 1 || !Number.isSafeInteger(value.ceiling) || value.ceiling < value.seq
+      || (sortedByDate ? !validDate(value.expires) : value.expires !== null)) fail(400, '无效的分页游标');
+    cursor = value;
+  }
+  const currentToday = todayIn(household.timezone, Date.now());
+  // Keep a traversal's filter date stable even if the family's midnight passes.
+  const today = cursor?.today ?? currentToday;
+  const values: (string | number | null)[] = [];
+  const bind = (value: string | number | null) => { values.push(value); return `?${values.length + 2}`; };
+  const conditions = [`household_id = ?1`, MEMBER];
+  if (expired) conditions.push(`expires_on < ${bind(today)}`);
+  if (within !== null) conditions.push(`expires_on BETWEEN ${bind(today)} AND ${bind(addDays(today, within))}`);
+  if (cursor) {
+    conditions.push(`seq <= ${bind(cursor.ceiling)}`);
+    if (sortedByDate) {
+      const dateParam = bind(cursor.expires);
+      conditions.push(`(expires_on > ${dateParam} OR (expires_on = ${dateParam} AND seq > ${bind(cursor.seq)}))`);
+    } else conditions.push(`seq > ${bind(cursor.seq)}`);
+  }
+  const limitParam = bind(limit + 1);
+  const { results } = await db.batch([
+    db.prepare(`SELECT coalesce(max(seq), 0) AS ceiling FROM items WHERE household_id = ?1 AND ${MEMBER}`),
+    db.prepare(`SELECT ${COLUMNS} FROM items WHERE ${conditions.join(' AND ')}
+      ORDER BY ${sortedByDate ? 'expires_on, ' : ''}seq LIMIT ${limitParam}`, ...values),
+  ]);
+  const rows = results[1].results as unknown as ItemRow[];
+  const page = rows.slice(0, limit);
+  let next_cursor: string | null = null;
+  if (rows.length > limit) {
+    const last = page[page.length - 1];
+    const next: Cursor = {
+      v: 1, household: db.id, filter, today, seq: last.seq,
+      expires: sortedByDate ? last.expires_on : null,
+      ceiling: cursor?.ceiling ?? (results[0].results[0] as { ceiling: number }).ceiling,
+    };
+    next_cursor = await sign(db.env, 'cursor', next);
+  }
+  return json({ items: page.map((item) => present(item, currentToday)), next_cursor });
+}
diff --git a/src/locations.ts b/src/locations.ts
new file mode 100644

@@ -0,0 +1,148 @@
+import assert from 'node:assert/strict';
+import { spawn, execFile } from 'node:child_process';
+import { randomBytes } from 'node:crypto';
+import { once } from 'node:events';
+import { mkdtemp, readFile, writeFile, rm } from 'node:fs/promises';
+import { createServer } from 'node:net';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { promisify } from 'node:util';
+import { setTimeout as delay } from 'node:timers/promises';
+
+const exec = promisify(execFile);
+const root = fileURLToPath(new URL('../', import.meta.url));
+const wrangler = path.join(root, 'node_modules/wrangler/bin/wrangler.js');
+const environment = { ...process.env, CI: '1', WRANGLER_SEND_METRICS: 'false', BROWSER: 'none' };
+let temporary;
+let config;
+let state;
+let processHandle;
+let output = '';
+let base;
+export const secret = randomBytes(48).toString('base64url');
+
+async function freePort() {
+  const server = createServer();
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  const port = server.address().port;
+  await new Promise((resolve) => server.close(resolve));
+  return port;
+}
+
+export async function start() {
+  temporary = await mkdtemp(path.join(tmpdir(), 'household-worker-test-'));
+  config = path.join(temporary, 'wrangler.jsonc');
+  state = path.join(temporary, 'state');
+  const settings = JSON.parse(await readFile(path.join(root, 'wrangler.jsonc'), 'utf8'));
+  delete settings.$schema;
+  settings.main = path.join(root, settings.main);
+  settings.d1_databases[0].migrations_dir = path.join(root, 'migrations');
+  await writeFile(config, JSON.stringify(settings));
+  await writeFile(path.join(temporary, '.dev.vars'), `TOKEN_SECRET=${secret}\n`, { mode: 0o600 });
+  await exec(process.execPath, [wrangler, 'd1', 'migrations', 'apply', 'DB', '--local', '--config', config, '--persist-to', state],
+    { cwd: root, env: environment, timeout: 30_000 });
+  const port = await freePort();
+  const inspectorPort = await freePort();
+  base = `http://127.0.0.1:${port}`;
+  processHandle = spawn(process.execPath, [wrangler, 'dev', '--local', '--config', config,
+    '--persist-to', state, '--ip', '127.0.0.1', '--port', String(port), '--inspector-port', String(inspectorPort)],
+  { cwd: root, env: environment, stdio: ['ignore', 'pipe', 'pipe'] });
+  processHandle.stdout.on('data', (data) => { output = (output + data).slice(-60_000); });
+  processHandle.stderr.on('data', (data) => { output = (output + data).slice(-60_000); });
+  for (let attempt = 0; attempt < 150; attempt++) {
+    if (processHandle.exitCode !== null) throw new Error(`Wrangler exited: ${output}`);
+    try {
+      const response = await fetch(`${base}/v1/me`, { signal: AbortSignal.timeout(300) });
+      if (response.status === 401) return;
+    } catch { /* Wait for workerd to bind its port. */ }
+    await delay(100);
+  }
+  throw new Error(`Wrangler did not start: ${output}`);
+}
+
+export async function stop() {
+  if (processHandle && processHandle.exitCode === null) {
+    const exited = once(processHandle, 'exit');
+    processHandle.kill('SIGTERM');
+    const killTimer = setTimeout(() => processHandle.kill('SIGKILL'), 5000);
+    await exited;
+    clearTimeout(killTimer);
+  }
+  if (temporary) await rm(temporary, { recursive: true, force: true });
+}
+
+export async function call(method, endpoint, body, token, extra = {}) {
+  const headers = { 'content-type': 'application/json', ...extra.headers };
+  if (token !== undefined) headers.authorization = `Bearer ${token}`;
+  const response = await fetch(`${base}${endpoint}`, {
+    method, headers, body: body === undefined ? undefined : JSON.stringify(body),
+    signal: AbortSignal.timeout(10_000), ...extra,
+  });
+  const text = await response.text();
+  let value;
+  try { value = text ? JSON.parse(text) : null; }
+  catch { throw new Error(`Non-JSON ${response.status}: ${text}\n${output}`); }
+  if (response.status >= 400) {
+    assert.deepEqual(Object.keys(value), ['error']);
+    assert.equal(typeof value.error, 'string');
+  }
+  if (response.status === 204) assert.equal(text, '');
+  return { status: response.status, body: value, headers: response.headers };
+}
+
+export async function api(method, endpoint, body, token, status = 200) {
+  const result = await call(method, endpoint, body, token);
+  assert.equal(result.status, status, `${method} ${endpoint}: ${JSON.stringify(result.body)}\n${result.status === 500 ? output : ''}`);
+  return result.body;
+}
+
+export async function account(label = 'user') {
+  return api('POST', '/v1/auth/register', {
+    email: `${label}-${randomBytes(8).toString('hex')}@example.com`, password: 'testing-password',
+  }, undefined, 201);
+}
+
+export async function household(token, timezone = 'Asia/Singapore') {
+  return api('POST', '/v1/households', { name: '我家', timezone }, token, 201);
+}
+
+export async function fixture(timezone = 'Asia/Singapore') {
+  const owner = await account('owner');
+  const home = await household(owner.token, timezone);
+  return { ...owner, home, prefix: `/v1/households/${home.id}` };
+}
+
+export async function join(owner, member) {
+  const invite = await api('POST', `${owner.prefix}/invites`, undefined, owner.token, 201);
+  await api('POST', `/v1/invites/${invite.code}/accept`, undefined, member.token);
+  return invite;
+}
+
+export async function scheduled(instant) {
+  const time = typeof instant === 'number' ? instant : Date.parse(instant);
+  const response = await fetch(`${base}/cdn-cgi/handler/scheduled?cron=0+*+*+*+*&time=${time}`, {
+    signal: AbortSignal.timeout(30_000),
+  });
+  const result = await response.text();
+  assert.equal(response.status, 200, `Scheduled handler: ${result}\n${output}`);
+}
+
+export async function sql(command) {
+  const { stdout } = await exec(process.execPath, [wrangler, 'd1', 'execute', 'DB', '--local',
+    '--config', config, '--persist-to', state, '--command', command, '--json'],
+  { cwd: root, env: environment, timeout: 30_000 });
+  return JSON.parse(stdout)[0].results;
+}
+
+export function today(timezone, instant = Date.now()) {
+  const values = new Intl.DateTimeFormat('en-CA', {
+    timeZone: timezone, year: 'numeric', month: '2-digit', day: '2-digit',
+  }).formatToParts(instant);
+  return ['year', 'month', 'day'].map((key) => values.find((part) => part.type === key).value).join('-');
+}
+
+export function plus(date, days) {
+  return new Date(Date.parse(`${date}T00:00:00Z`) + days * 86400000).toISOString().slice(0, 10);
+}

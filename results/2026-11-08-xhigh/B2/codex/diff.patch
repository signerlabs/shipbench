@@ -0,0 +1,53 @@
+import { HouseholdDB, MEMBER } from './db';
+import { empty, fail, json, name, nullableId } from './http';
+import type { Body } from './types';
+
+interface Location {
+  id: string;
+  name: string;
+  parent_id: string | null;
+}
+interface LocationNode extends Location {
+  children: LocationNode[];
+}
+
+export async function createLocation(db: HouseholdDB, body: Body): Promise<Response> {
+  const location = { id: crypto.randomUUID(), name: name(body.name), parent_id: nullableId(body.parent_id ?? null) };
+  const { results } = await db.batch([
+    db.prepare(`INSERT INTO locations (id, household_id, name, parent_id, depth)
+      SELECT ?3, ?1, ?4, ?5,
+        CASE WHEN ?5 IS NULL THEN 1 ELSE (SELECT depth + 1 FROM locations WHERE household_id = ?1 AND id = ?5) END
+      WHERE ${MEMBER} AND (?5 IS NULL OR EXISTS (
+        SELECT 1 FROM locations WHERE household_id = ?1 AND id = ?5 AND depth < 3))
+      RETURNING id, name, parent_id`, location.id, location.name, location.parent_id),
+  ]);
+  if (!results[0].results.length) fail(400, '父位置不存在于本家庭或已经是第三层');
+  return json(results[0].results[0], 201);
+}
+
+export async function listLocations(db: HouseholdDB): Promise<Response> {
+  const { results } = await db.batch([
+    db.prepare(`SELECT id, name, parent_id FROM locations WHERE household_id = ?1 AND ${MEMBER} ORDER BY rowid`),
+  ]);
+  const nodes = new Map<string, LocationNode>();
+  for (const row of results[0].results as unknown as Location[]) nodes.set(row.id, { ...row, children: [] });
+  const roots: LocationNode[] = [];
+  for (const node of nodes.values()) {
+    if (node.parent_id === null) roots.push(node);
+    else nodes.get(node.parent_id)!.children.push(node);
+  }
+  return json({ locations: roots });
+}
+
+export async function deleteLocation(db: HouseholdDB, id: string): Promise<Response> {
+  const { results } = await db.batch([
+    db.prepare(`SELECT id FROM locations WHERE household_id = ?1 AND id = ?3 AND ${MEMBER}`, id),
+    db.prepare(`DELETE FROM locations WHERE household_id = ?1 AND id = ?3 AND ${MEMBER}
+      AND NOT EXISTS(SELECT 1 FROM locations child WHERE child.household_id = ?1 AND child.parent_id = ?3)
+      AND NOT EXISTS(SELECT 1 FROM items WHERE household_id = ?1 AND location_id = ?3)
+      RETURNING id`, id),
+  ]);
+  if (!results[0].results.length) fail(404, '位置不存在');
+  if (!results[1].results.length) fail(409, '位置中仍有子位置或物品');
+  return empty();
+}

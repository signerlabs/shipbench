+import { HouseholdDB, MEMBER } from './db';
+import { addDays, todayIn } from './dates';
+import { json } from './http';
+import type { Env } from './types';
+
+export async function generateReminders(env: Env, scheduledTime: number): Promise<void> {
+  let after = '';
+  while (true) {
+    const { results: households } = await env.DB.prepare(
+      'SELECT id, timezone FROM households WHERE id > ? ORDER BY id LIMIT 100',
+    ).bind(after).all<{ id: string; timezone: string }>();
+    if (!households.length) return;
+    // Bound the batch and memory usage; each INSERT selects all eligible items
+    // directly in D1, without loading their contents into the Worker.
+    await env.DB.batch(households.map((household) => {
+      const today = todayIn(household.timezone, scheduledTime);
+      return env.DB.prepare(`INSERT INTO reminders (id, household_id, item_id, item_name, expires_on, remind_on)
+        SELECT lower(hex(randomblob(16))), household_id, id, name, expires_on, ?2
+        FROM items WHERE household_id = ?1 AND expires_on BETWEEN ?2 AND ?3
+        ON CONFLICT(item_id, remind_on) DO NOTHING`)
+        .bind(household.id, today, addDays(today, 3));
+    }));
+    after = households[households.length - 1].id;
+  }
+}
+
+export async function listReminders(db: HouseholdDB): Promise<Response> {
+  const { results } = await db.batch([
+    db.prepare(`SELECT id, item_id, item_name, expires_on, remind_on FROM reminders
+      WHERE household_id = ?1 AND ${MEMBER} ORDER BY remind_on, expires_on, id`),
+  ]);
+  return json({ reminders: results[0].results });
+}
diff --git a/src/security.ts b/src/security.ts
new file mode 100644
index 0000000..ca223d5
--- /dev/null
+++ b/src/security.ts
@@ -0,0 +1,68 @@
+import type { Env } from './types';
+
+const encoder = new TextEncoder();
+const ITERATIONS = 100_000;
+
+function base64url(bytes: Uint8Array): string {
+  return btoa(String.fromCharCode(...bytes)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+}
+
+function decode(value: string): Uint8Array {
+  if (!/^[A-Za-z0-9_-]+$/.test(value)) throw new Error('Invalid base64url');
+  const bytes = Uint8Array.from(atob(value.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0));
+  if (base64url(bytes) !== value) throw new Error('Noncanonical base64url');
+  return bytes;
+}
+
+export function randomCode(): string {
+  return base64url(crypto.getRandomValues(new Uint8Array(24)));
+}
+
+async function signingKey(env: Env): Promise<CryptoKey> {
+  if (typeof env.TOKEN_SECRET !== 'string' || !env.TOKEN_SECRET) {
+    throw new Error('TOKEN_SECRET is required; run npm run setup');
+  }
+  return crypto.subtle.importKey('raw', encoder.encode(env.TOKEN_SECRET),
+    { name: 'HMAC', hash: 'SHA-256' }, false, ['sign', 'verify']);
+}
+
+export async function sign(env: Env, purpose: string, payload: unknown): Promise<string> {
+  const encoded = base64url(encoder.encode(JSON.stringify(payload)));
+  const signature = await crypto.subtle.sign('HMAC', await signingKey(env), encoder.encode(`${purpose}.${encoded}`));
+  return `${encoded}.${base64url(new Uint8Array(signature))}`;
+}
+
+export async function verify(env: Env, purpose: string, token: string): Promise<unknown> {
+  const key = await signingKey(env);
+  try {
+    if (token.length > 4096) return null;
+    const parts = token.split('.');
+    if (parts.length !== 2) return null;
+    const [encoded, signature] = parts;
+    if (!await crypto.subtle.verify('HMAC', key, decode(signature), encoder.encode(`${purpose}.${encoded}`))) return null;
+    return JSON.parse(new TextDecoder('utf-8', { fatal: true, ignoreBOM: false }).decode(decode(encoded)));
+  } catch {
+    return null;
+  }
+}
+
+async function derive(password: string, salt: Uint8Array, iterations: number): Promise<Uint8Array> {
+  const key = await crypto.subtle.importKey('raw', encoder.encode(password), 'PBKDF2', false, ['deriveBits']);
+  return new Uint8Array(await crypto.subtle.deriveBits(
+    { name: 'PBKDF2', hash: 'SHA-256', salt, iterations }, key, 256));
+}
+
+export async function hashPassword(password: string): Promise<string> {
+  const salt = crypto.getRandomValues(new Uint8Array(16));
+  return `pbkdf2-sha256$${ITERATIONS}$${base64url(salt)}$${base64url(await derive(password, salt, ITERATIONS))}`;
+}
+
+export async function verifyPassword(password: string, encoded: string): Promise<boolean> {
+  const [algorithm, iterations, salt, hash] = encoded.split('$');
+  if (algorithm !== 'pbkdf2-sha256' || Number(iterations) !== ITERATIONS) return false;
+  const actual = await derive(password, decode(salt), Number(iterations));
+  const expected = decode(hash);
+  let difference = actual.length ^ expected.length;
+  for (let i = 0; i < actual.length; i++) difference |= actual[i] ^ (expected[i] ?? 0);
+  return difference === 0;
+}

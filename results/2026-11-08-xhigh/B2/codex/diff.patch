+++ b/tests/api.test.mjs
@@ -0,0 +1,490 @@
+import assert from 'node:assert/strict';
+import { createHmac } from 'node:crypto';
+import { before, after, test } from 'node:test';
+import { start, stop, call, api, account, household, fixture, join, scheduled, sql, today, plus, secret } from './harness.mjs';
+
+before(start, { timeout: 60_000 });
+after(stop, { timeout: 15_000 });
+
+test('注册、大小写不敏感登录、me、错误密码与重复邮箱', async () => {

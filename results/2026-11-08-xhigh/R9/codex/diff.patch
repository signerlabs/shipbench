diff --git a/Tests/ExpenseFeatureChecks.swift b/Tests/ExpenseFeatureChecks.swift
new file mode 100644
index 0000000..43133c8
--- /dev/null
+++ b/Tests/ExpenseFeatureChecks.swift
@@ -0,0 +1,167 @@
+import Foundation
+
+// Standalone checks, so the app's project and build settings need no test-target changes.
+// Run the command documented in Tests/README.md.
+@main
+struct ExpenseFeatureChecks {
+    @MainActor
+    static func main() async throws {
+        try checkRegionalAmounts()
+        try checkCalendarDays()
+        try await checkStore()
+        print("Expense checks passed: regional money, local calendar days, monthly totals, and API state transitions.")
+    }
+
+    static func expect(_ condition: @autoclosure () -> Bool, _ message: String) throws {
+        if !condition() { throw CheckFailure(message: message) }
+    }
+
+    static func money(_ value: String) -> Decimal {
+        Decimal(string: value, locale: Locale(identifier: "en_US_POSIX"))!
+    }
+
+    static func checkRegionalAmounts() throws {
+        let cases: [(String, [String], [String], String)] = [
+            ("en_US", ["19.99", "1,234.56", ".50", "12."],
+             ["19,99", "12,34.56", "1.234,56", "19.99abc"], "$1,234.56"),
+            ("de_DE", ["19,99", "1.234,56", ",50", "12,"],
+             ["19.99", "12.34,56", "1,234.56", "19,99abc"], "1.234,56 €"),
+            ("fr_FR", ["19,99", "1 234,56", ",50", "12,"],
+             ["19.99", "12 34,56", "1,234.56", "19,99abc"], "1 234,56 €")
+        ]
+        for (identifier, valid, invalid, currency) in cases {
+            let formatting = ExpenseFormatting(locale: Locale(identifier: identifier))
+            let expected = ["19.99", "1234.56", "0.5", "12"].map { money($0) }
+            for (input, amount) in zip(valid, expected) {
+                let actual = try formatting.amount(from: input)
+                try expect(actual == amount, "\(identifier) misparsed \(input): \(actual)")
+            }
+            for input in invalid + ["", " ", "0", "-1", "NaN", "inf", "1e3", "12\n34", "1/2", "1+2"] {
+                do {
+                    _ = try formatting.amount(from: input)
+                    throw CheckFailure(message: "\(identifier) accepted invalid amount: \(input)")
+                } catch ExpenseAPIError.invalidAmount {
+                    // Expected: no partial or nonpositive amounts.
+                }
+            }
+            try expect(formatting.currency(money("1234.56")) == currency, "Wrong currency format for \(identifier)")
+            let sum = try formatting.amount(from: identifier == "en_US" ? "0.10" : "0,10")
+                + formatting.amount(from: identifier == "en_US" ? "0.20" : "0,20")
+            try expect(sum == Decimal(string: "0.30"), "Money lost decimal precision")
+        }
+        let french = ExpenseFormatting(locale: Locale(identifier: "fr_FR"))
+        for input in ["1 234,56", "1 234,56", "1 234,56", " 19,99 "] {
+            let actual = try french.amount(from: input)
+            try expect(actual == money(input.contains("234") ? "1234.56" : "19.99"), "French spaces: \(input)")
+        }
+    }
+
+    static func checkCalendarDays() throws {
+        let regions = [
+            ("en_US", "America/Los_Angeles", "Nov 20"),
+            ("en_US", "America/New_York", "Nov 20"),
+            ("de_DE", "Europe/Berlin", "20. Nov."),
+            ("fr_FR", "Europe/Paris", "20 nov.")
+        ]
+        for (locale, zone, label) in regions {
+            let formatting = ExpenseFormatting(locale: Locale(identifier: locale), timeZone: TimeZone(identifier: zone)!)
+            for day in ["2026-11-20", "2026-11-01", "2026-03-08", "2026-03-29", "2026-10-25", "2028-02-29"] {
+                guard let date = formatting.date(from: day) else { throw CheckFailure(message: "Could not parse \(day)") }
+                try expect(formatting.calendar.component(.hour, from: date) == 12, "Date must be local noon")
+                try expect(formatting.dayString(date) == day, "Date shifted in \(zone)")
+                try expect(formatting.isToday(day, now: date), "Today label missing in \(zone)")
+            }
+            try expect(formatting.dateLabel("2026-11-20") == label, "Wrong date label for \(locale): \(formatting.dateLabel("2026-11-20"))")
+            for day in ["2026-02-29", "2026-02-30", "2026-13-01", "2026-11-00", "2026-1-1", "2026-11-20junk"] {
+                try expect(formatting.date(from: day) == nil, "Invalid server date accepted: \(day)")
+            }
+            let expenses = [
+                Expense(id: "1", amount: money("10.10"), date: "2026-11-01", note: ""),
+                Expense(id: "2", amount: money("20.20"), date: "2026-11-30", note: ""),
+                Expense(id: "3", amount: 500, date: "2026-10-31", note: ""),
+                Expense(id: "4", amount: 500, date: "2026-12-01", note: ""),
+                Expense(id: "5", amount: 500, date: "2025-11-20", note: "")
+            ]
+            let now = formatting.date(from: "2026-11-20")!
+            try expect(formatting.monthlyTotal(expenses, now: now) == money("30.30"), "Month/year boundary failed in \(zone)")
+            try expect(!formatting.isToday("2026-11-19", now: now), "Yesterday marked Today")
+        }
+
+        // At 00:30 UTC on December 1, the user's day and month are still November in California.
+        let instant = ISO8601DateFormatter().date(from: "2026-12-01T00:30:00Z")!
+        let california = ExpenseFormatting(timeZone: TimeZone(identifier: "America/Los_Angeles")!)
+        try expect(california.dayString(instant) == "2026-11-30", "Saving used the UTC day")
+        try expect(california.isToday("2026-11-30", now: instant), "Today used the UTC day")
+        let expense = Expense(id: "boundary", amount: 7, date: "2026-11-30", note: "")
+        try expect(california.monthlyTotal([expense], now: instant) == 7, "Total used the UTC month")
+    }
+
+    @MainActor
+    static func checkStore() async throws {
+        let formatting = ExpenseFormatting(locale: Locale(identifier: "de_DE"), timeZone: TimeZone(identifier: "Europe/Berlin")!)
+        let now = formatting.date(from: "2026-11-20")!
+        let seed = Expense(id: "seed", amount: 10, date: "2026-11-19", note: "Gym")
+        var saved: [Expense] = []
+        var failFetch = false
+        var failAdd = false
+        let store = ExpenseStore(fetch: {
+            if failFetch { throw ExpenseAPIError.network }
+            return [seed]
+        }, add: { expense in
+            if failAdd { throw ExpenseAPIError.network }
+            saved.append(expense)
+        })
+
+        try await store.load()
+        try expect(store.hasLoaded && store.expenses == [seed], "Fetch did not populate state")
+        let added = try await store.log("19,99", formatting: formatting, now: now)
+        try expect(added && saved.count == 1 && store.expenses.count == 2, "Save did not immediately publish")
+        try expect(saved[0].date == "2026-11-20" && saved[0].amount == money("19.99"), "Incorrect API payload")
+        try expect(store.expenses.first == saved.first, "New expense was not sorted first")
+        try expect(formatting.monthlyTotal(store.expenses, now: now) == money("29.99"), "Total did not update")
+        do {
+            _ = try await store.log("19,99abc", formatting: formatting, now: now)
+            throw CheckFailure(message: "Invalid input was logged")
+        } catch ExpenseAPIError.invalidAmount {}
+        try expect(saved.count == 1 && store.expenses.count == 2, "Invalid input called add or mutated the list")
+
+        failAdd = true
+        do {
+            _ = try await store.log("30", formatting: formatting, now: now)
+            throw CheckFailure(message: "Add failure was swallowed")
+        } catch ExpenseAPIError.network {
+            try expect(ExpenseAPIError.network.localizedDescription == "Network error. Please try again.", "Wrong error description")
+        }
+        try expect(!store.isSaving && store.expenses.count == 2, "Failed save changed data or left saving active")
+        failFetch = true
+        do {
+            try await store.load()
+            throw CheckFailure(message: "Fetch failure was swallowed")
+        } catch ExpenseAPIError.network {}
+        try expect(!store.isLoading && store.expenses.count == 2, "Failed refresh discarded existing data")
+
+        var releaseSave: CheckedContinuation<Void, Never>?
+        var addCalls = 0
+        var fetchCalls = 0
+        let delayed = ExpenseStore(fetch: {
+            fetchCalls += 1
+            return []
+        }, add: { _ in
+            addCalls += 1
+            await withCheckedContinuation { releaseSave = $0 }
+        })
+        let first = Task { try await delayed.log("10", formatting: formatting, now: now) }
+        while releaseSave == nil { await Task.yield() }
+        let duplicate = try await delayed.log("10", formatting: formatting, now: now)
+        try await delayed.load()
+        try expect(!duplicate && addCalls == 1 && fetchCalls == 0, "Concurrent actions duplicated or raced a save")
+        try expect(delayed.expenses.isEmpty, "Unconfirmed save appeared in list")
+        releaseSave?.resume()
+        let firstSucceeded = try await first.value
+        try expect(firstSucceeded && delayed.expenses.count == 1 && !delayed.isSaving, "Completed save did not publish once")
+    }
+}
+
+private struct CheckFailure: Error {
+    let message: String
+}

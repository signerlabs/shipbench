+import Foundation
+import Observation
+
+@MainActor
+@Observable
+final class ExpenseStore {
+    private(set) var expenses: [Expense] = []
+    private(set) var isLoading = false
+    private(set) var isSaving = false
+    private(set) var hasLoaded = false
+
+    private let fetchExpenses: () async throws -> [Expense]
+    private let addExpense: (Expense) async throws -> Void
+
+    init(
+        fetch: @escaping () async throws -> [Expense] = { try await ExpenseAPI.shared.fetch() },
+        add: @escaping (Expense) async throws -> Void = { try await ExpenseAPI.shared.add($0) }
+    ) {
+        fetchExpenses = fetch
+        addExpense = add
+    }
+
+    func load() async throws {
+        guard !isLoading, !isSaving else { return }
+        isLoading = true
+        defer { isLoading = false }
+        let fetched = try await fetchExpenses()
+        try Task.checkCancellation()
+        expenses = fetched.sorted { $0.date > $1.date }
+        hasLoaded = true
+    }
+
+    /// Returns false for a duplicate tap while another operation is running.
+    func log(_ text: String, formatting: ExpenseFormatting, now: Date = .now) async throws -> Bool {
+        guard !isLoading, !isSaving else { return false }
+        let amount = try formatting.amount(from: text)
+        let expense = Expense(
+            id: UUID().uuidString,
+            amount: amount,
+            date: formatting.dayString(now),
+            note: ""
+        )
+        isSaving = true
+        defer { isSaving = false }
+        try await addExpense(expense)
+        // Publish only after the API succeeds, without waiting for another fetch.
+        let index = expenses.firstIndex { $0.date <= expense.date } ?? expenses.endIndex
+        expenses.insert(expense, at: index)
+        return true
+    }
+}

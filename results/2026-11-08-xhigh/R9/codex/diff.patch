+++ b/Sprout/Models/ExpenseFormatting.swift
@@ -0,0 +1,96 @@
+import Foundation
+
+/// Keeps server calendar days separate from instants, and money in Decimal throughout.
+struct ExpenseFormatting {
+    var locale: Locale = .current
+    var timeZone: TimeZone = .current
+
+    var calendar: Calendar {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = timeZone
+        return calendar
+    }
+
+    var currencyCode: String { locale.currency?.identifier ?? "XXX" }
+
+    func currency(_ amount: Decimal) -> String {
+        amount.formatted(.currency(code: currencyCode).locale(locale))
+    }
+
+    func amount(from text: String) throws -> Decimal {
+        let formatter = NumberFormatter()
+        formatter.locale = locale
+        formatter.numberStyle = .decimal
+        let decimalSeparator = formatter.decimalSeparator ?? "."
+        let groupingSeparator = formatter.groupingSeparator ?? ","
+        var input = text.trimmingCharacters(in: .whitespacesAndNewlines)
+
+        // French keyboards and pasted amounts may use any of these space separators.
+        if groupingSeparator.trimmingCharacters(in: .whitespaces).isEmpty {
+            for space in [" ", "\u{00A0}", "\u{202F}"] {
+                input = input.replacingOccurrences(of: space, with: groupingSeparator)
+            }
+        }
+
+        let decimal = NSRegularExpression.escapedPattern(for: decimalSeparator)
+        let grouping = NSRegularExpression.escapedPattern(for: groupingSeparator)
+        let integer = "(?:[0-9]+|[0-9]{1,3}(?:\(grouping)[0-9]{3})+)"
+        let pattern = "\\A\\+?(?:\(integer)(?:\(decimal)[0-9]*)?|\(decimal)[0-9]+)\\z"
+        // Foundation's number parsers can accept a valid prefix; validate the entire input first.
+        guard input.range(of: pattern, options: .regularExpression) != nil else {
+            throw ExpenseAPIError.invalidAmount
+        }
+
+        let normalized = input
+            .replacingOccurrences(of: groupingSeparator, with: "")
+            .replacingOccurrences(of: decimalSeparator, with: ".")
+        let significantDigits = normalized.filter { $0.isNumber }.drop { $0 == "0" }
+        guard significantDigits.count <= 38,
+              let amount = Decimal(string: normalized, locale: Locale(identifier: "en_US_POSIX")),
+              !amount.isNaN, amount > 0 else {
+            throw ExpenseAPIError.invalidAmount
+        }
+        return amount
+    }
+
+    func date(from day: String) -> Date? {
+        guard day.range(of: #"\A[0-9]{4}-[0-9]{2}-[0-9]{2}\z"#,
+                        options: .regularExpression) != nil else { return nil }
+        let parts = day.split(separator: "-").compactMap { Int($0) }
+        guard parts.count == 3, parts[0] > 0 else { return nil }
+        // Local noon avoids the previous-day shift caused by parsing at UTC midnight.
+        let components = DateComponents(
+            year: parts[0], month: parts[1], day: parts[2], hour: 12
+        )
+        guard let date = calendar.date(from: components), dayString(date) == day else { return nil }
+        return date
+    }
+
+    func dayString(_ date: Date) -> String {
+        let parts = calendar.dateComponents([.year, .month, .day], from: date)
+        return String(format: "%04d-%02d-%02d", parts.year ?? 0, parts.month ?? 0, parts.day ?? 0)
+    }
+
+    func dateLabel(_ day: String) -> String {
+        guard let date = date(from: day) else { return day }
+        let formatter = DateFormatter()
+        formatter.locale = locale
+        formatter.calendar = calendar
+        formatter.timeZone = timeZone
+        formatter.setLocalizedDateFormatFromTemplate("MMMd")
+        return formatter.string(from: date)
+    }
+
+    func isToday(_ day: String, now: Date) -> Bool {
+        guard let date = date(from: day) else { return false }
+        return calendar.isDate(date, inSameDayAs: now)
+    }
+
+    func monthlyTotal(_ expenses: [Expense], now: Date) -> Decimal {
+        expenses.reduce(Decimal.zero) { total, expense in
+            guard let date = date(from: expense.date),
+                  calendar.isDate(date, equalTo: now, toGranularity: .month) else { return total }
+            return total + expense.amount
+        }
+    }
+}

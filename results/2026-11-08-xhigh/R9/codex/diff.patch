+import SwiftUI
+
+struct ExpenseListView: View {
+    @Environment(\.locale) private var locale
+    @Environment(\.timeZone) private var timeZone
+    @State private var store = ExpenseStore()
+    @State private var showAddSheet = false
+
+    private var formatting: ExpenseFormatting {
+        ExpenseFormatting(locale: locale, timeZone: timeZone)
+    }
+
+    var body: some View {
+        TimelineView(.periodic(from: .now, by: 60)) { context in
+            List {
+                Section {
+                    SWKPICard(
+                        title: "This Month",
+                        value: store.hasLoaded
+                            ? formatting.currency(formatting.monthlyTotal(store.expenses, now: context.date))
+                            : "—",
+                        icon: "creditcard.fill",
+                        tint: .green
+                    )
+                    .listRowInsets(EdgeInsets())
+                    .listRowBackground(Color.clear)
+                }
+
+                Section("Expenses") {
+                    ForEach(store.expenses) { expense in
+                        ExpenseRow(expense: expense, formatting: formatting, now: context.date)
+                    }
+                    if store.expenses.isEmpty, !store.isLoading {
+                        if store.hasLoaded {
+                            Text("No expenses yet. Tap + to log today's spending.")
+                                .foregroundStyle(.secondary)
+                        } else {
+                            Button("Retry Loading Expenses") {
+                                Task { await loadExpenses() }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        .navigationTitle("Fitness Expenses")
+        .toolbar {
+            ToolbarItem(placement: .topBarTrailing) {
+                Button {
+                    showAddSheet = true
+                } label: {
+                    Label("Log Expense", systemImage: "plus")
+                }
+                .disabled(!store.hasLoaded || store.isLoading || store.isSaving)
+            }
+        }
+        .sheet(isPresented: $showAddSheet) {
+            SWAddSheet(
+                isPresented: $showAddSheet,
+                title: "Log Today's Expense",
+                placeHolderText: "Amount (\(formatting.currencyCode))",
+                minLines: 1
+            ) { text in
+                Task { await logExpense(text) }
+            }
+            .keyboardType(.decimalPad)
+        }
+        .swPageLoading(.expenses)
+        .task { await loadExpenses() }
+        .refreshable { await loadExpenses() }
+    }
+
+    private func loadExpenses() async {
+        guard !store.isLoading, !store.isSaving else { return }
+        SWLoadingManager.shared.show(page: .expenses, message: "Loading expenses...")
+        defer { SWLoadingManager.shared.hide(page: .expenses) }
+        do {
+            try await store.load()
+        } catch is CancellationError {
+            // Navigation away cancels the view's loading task.
+        } catch {
+            SWAlertManager.shared.show(.error, message: error.localizedDescription)
+        }
+    }
+
+    private func logExpense(_ text: String) async {
+        guard !store.isLoading, !store.isSaving else { return }
+        SWLoadingManager.shared.show(page: .expenses, message: "Saving expense...")
+        defer { SWLoadingManager.shared.hide(page: .expenses) }
+        do {
+            if try await store.log(text, formatting: formatting) {
+                SWAlertManager.shared.show(.success, message: "Logged")
+            }
+        } catch {
+            SWAlertManager.shared.show(.error, message: error.localizedDescription)
+        }
+    }
+}
+
+private struct ExpenseRow: View {
+    let expense: Expense
+    let formatting: ExpenseFormatting
+    let now: Date
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            ViewThatFits(in: .horizontal) {
+                HStack(alignment: .firstTextBaseline) {
+                    dateAndBadge
+                    Spacer(minLength: 12)
+                    amountAndBadge
+                }
+                VStack(alignment: .leading, spacing: 8) {
+                    dateAndBadge
+                    amountAndBadge
+                }
+            }
+            if expense.note.isEmpty {
+                Text("Fitness expense")
+                    .foregroundStyle(.secondary)
+            } else {
+                Text(verbatim: expense.note)
+                    .foregroundStyle(.secondary)
+            }
+        }
+        .padding(.vertical, 4)
+        .accessibilityElement(children: .combine)
+    }
+
+    private var dateAndBadge: some View {
+        HStack(spacing: 6) {
+            Text(verbatim: formatting.dateLabel(expense.date))
+            if formatting.isToday(expense.date, now: now) {
+                SWStatusBadge(text: "Today", style: .info)
+            }
+        }
+        .fixedSize(horizontal: true, vertical: false)
+    }
+
+    private var amountAndBadge: some View {
+        HStack(spacing: 6) {
+            Text(verbatim: formatting.currency(expense.amount))
+                .fontWeight(.semibold)
+            if expense.amount > 50 {
+                SWStatusBadge(text: "Large", style: .error)
+            }
+        }
+        .fixedSize(horizontal: true, vertical: false)
+    }
+}

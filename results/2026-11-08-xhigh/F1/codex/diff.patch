+private struct PaperGrain: View {
+    var body: some View {
+        Canvas { context, size in
+            for index in 0..<170 {
+                let x = CGFloat((index * 73 + 13) % 997) / 997 * size.width
+                let y = CGFloat((index * 139 + 37) % 991) / 991 * size.height
+                let width = index % 5 == 0 ? 1.5 : 0.6
+                context.fill(Path(ellipseIn: CGRect(x: x, y: y, width: width, height: 0.6)), with: .color(.brown.opacity(0.045)))
+            }
+            for y in [85.0, 117.5, 150.0] {
+                var line = Path()
+                line.move(to: CGPoint(x: 16, y: y))
+                line.addLine(to: CGPoint(x: size.width - 16, y: y))
+                context.stroke(line, with: .color(.brown.opacity(0.07)), lineWidth: 0.6)
+            }
+        }
+    }
+}

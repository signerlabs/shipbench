diff --git a/Replica/OnboardingView.swift b/Replica/OnboardingView.swift
new file mode 100644
index 0000000..15ce7e1
--- /dev/null
+++ b/Replica/OnboardingView.swift
@@ -0,0 +1,188 @@
+import SwiftUI
+
+enum WelcomeStyle {
+    static let background = rgb(252, 249, 248)
+    static let green = rgb(0, 129, 90)
+    static let orange = rgb(244, 131, 61)
+    static let ink = rgb(30, 26, 22)
+    static let secondary = rgb(116, 113, 111)
+    static let paper = rgb(252, 244, 234)
+
+    static func rgb(_ r: Double, _ g: Double, _ b: Double) -> Color {
+        Color(.sRGB, red: r / 255, green: g / 255, blue: b / 255)
+    }
+
+    static func title(_ size: CGFloat) -> Font { .custom("SmileySans-Oblique", size: size) }
+    static func body(_ size: CGFloat) -> Font { .custom("LXGWMarkerGothic-Regular", size: size) }
+    static func number(_ size: CGFloat) -> Font { .custom("BarlowCondensed-Bold", size: size) }
+}
+
+struct OnboardingView: View {
+    @State private var step = 0
+    @State private var starts: [Date?] = [nil, nil, nil]
+    @State private var finished = false
+
+    var body: some View {
+        GeometryReader { geometry in
+            let scale = geometry.size.width / 440
+            let height = geometry.size.height / scale
+            ZStack(alignment: .topLeading) {
+                WelcomeStyle.background
+
+                TimelineView(.animation(minimumInterval: 1.0 / 60.0)) { timeline in
+                    HStack(spacing: 0) {
+                        ForEach(0..<3) { page in
+                            let elapsed = starts[page].map { timeline.date.timeIntervalSince($0) } ?? -10
+                            ZStack(alignment: .topLeading) {
+                                Group {
+                                    switch page {
+                                    case 0: RecommendationIllustration(time: elapsed)
+                                    case 1: MapIllustration(time: elapsed)
+                                    default: NavigationIllustration(time: elapsed)
+                                    }
+                                }
+                                .frame(width: 440, height: 500)
+                                .offset(y: 130)
+
+                                explanation(page)
+                                    .offset(x: 20, y: height * 0.6755)
+                            }
+                            .frame(width: 440, height: height, alignment: .topLeading)
+                            .clipped()
+                        }
+                    }
+                    .offset(x: -CGFloat(step) * 440)
+                }
+
+                header
+                    .offset(x: 20, y: 70)
+
+                Button(action: advance) {
+                    Text(step == 2 ? "继续" : "下一步")
+                        .font(WelcomeStyle.title(20))
+                        .foregroundStyle(.white)
+                        .frame(width: 400, height: 56)
+                        .background(WelcomeStyle.green, in: Capsule())
+                        .contentShape(Capsule())
+                }
+                .buttonStyle(WelcomeButtonStyle())
+                .accessibilityIdentifier("onboarding.next")
+                .offset(x: 20, y: height - 102)
+            }
+            .frame(width: 440, height: height, alignment: .topLeading)
+            .scaleEffect(scale, anchor: .topLeading)
+        }
+        .ignoresSafeArea()
+        .background(WelcomeStyle.background)
+        .onAppear { if starts[0] == nil { starts[0] = Date() } }
+        .fullScreenCover(isPresented: $finished) {
+            WelcomeCompletion {
+                starts[0] = Date()
+                step = 0
+                finished = false
+            }
+        }
+    }
+
+    private var header: some View {
+        HStack(spacing: 14) {
+            Button { select(step - 1) } label: {
+                Image(systemName: "chevron.left")
+                    .font(.system(size: 16, weight: .semibold))
+                    .foregroundStyle(WelcomeStyle.ink)
+                    .frame(width: 44, height: 44)
+                    .background(WelcomeStyle.rgb(242, 238, 234), in: Circle())
+            }
+            .opacity(step == 0 ? 0 : 1)
+            .disabled(step == 0)
+            .accessibilityLabel("上一步")
+            .buttonStyle(WelcomeButtonStyle())
+
+            HStack(spacing: 6) {
+                ForEach(0..<3) { index in
+                    Capsule()
+                        .fill(WelcomeStyle.rgb(230, 227, 226))
+                        .overlay(alignment: .leading) {
+                            Capsule()
+                                .fill(WelcomeStyle.orange)
+                                .frame(width: index <= step ? 92.67 : 0)
+                        }
+                        .frame(width: 92.67, height: 5)
+                }
+            }
+            .accessibilityLabel("第 \(step + 1) 步，共 3 步")
+
+            Button { finished = true } label: {
+                Text("跳过")
+                    .font(.system(size: 15))
+                    .foregroundStyle(WelcomeStyle.secondary)
+                    .frame(width: 38, height: 44)
+            }
+            .buttonStyle(WelcomeButtonStyle())
+        }
+    }
+
+    private func explanation(_ page: Int) -> some View {
+        let titles = ["跟着推荐者去吃", "世界各地都有好店", "一键导航到门口"]
+        let details = [
+            "关注你喜欢的推荐者，跟着他们一家家吃过去",
+            "遍布 200 多座城市，出差旅行走到哪儿都能吃上",
+            "看中的店点一下，直接导航带你过去"
+        ]
+        return VStack(alignment: .leading, spacing: 8) {
+            HStack(alignment: .firstTextBaseline, spacing: 12) {
+                Text("\(page + 1)")
+                    .font(WelcomeStyle.number(46))
+                    .foregroundStyle(WelcomeStyle.orange)
+                    .offset(y: -1)
+                Text(titles[page])
+                    .font(WelcomeStyle.title(30))
+                    .foregroundStyle(WelcomeStyle.ink)
+            }
+            Text(details[page])
+                .font(WelcomeStyle.body(17))
+                .foregroundStyle(WelcomeStyle.secondary)
+                .fixedSize(horizontal: true, vertical: false)
+        }
+    }
+
+    private func select(_ newStep: Int) {
+        guard (0..<3).contains(newStep), newStep != step else { return }
+        starts[newStep] = Date()
+        withAnimation(.spring(response: 0.46, dampingFraction: 0.94)) {
+            step = newStep
+        }
+    }
+
+    private func advance() {
+        if step < 2 { select(step + 1) } else { finished = true }
+    }
+}
+
+private struct WelcomeButtonStyle: ButtonStyle {
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .scaleEffect(configuration.isPressed ? 0.975 : 1)
+            .opacity(configuration.isPressed ? 0.86 : 1)
+            .animation(.easeOut(duration: 0.14), value: configuration.isPressed)
+    }
+}
+
+private struct WelcomeCompletion: View {
+    var replay: () -> Void
+
+    var body: some View {
+        ZStack {
+            WelcomeStyle.background.ignoresSafeArea()
+            VStack(spacing: 24) {
+                Image("welcome-shop").resizable().scaledToFit().frame(width: 240, height: 240)
+                Text("烟火小店").font(WelcomeStyle.title(36))
+                Text("跟着推荐者，发现街巷里的好味道")
+                    .font(WelcomeStyle.body(17)).foregroundStyle(WelcomeStyle.secondary)
+                Button("再看一次", action: replay)
+                    .font(WelcomeStyle.title(20)).foregroundStyle(WelcomeStyle.green)
+            }
+            .foregroundStyle(WelcomeStyle.ink)
+        }
+    }
+}
diff --git a/Replica/ReplicaApp.swift b/Replica/ReplicaApp.swift
index 220aa8c..1548de3 100644

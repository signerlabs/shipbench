@@ -1,10 +1,34 @@
 import SwiftUI
+import CoreText
 
 @main
 struct ReplicaApp: App {
+    init() {
+        for name in ["SmileySans-Oblique", "LXGWMarkerGothic-Regular", "BarlowCondensed-Bold"] {
+            if let url = Bundle.main.url(forResource: name, withExtension: "ttf") {
+                CTFontManagerRegisterFontsForURL(url as CFURL, .process, nil)
+            }
+        }
+    }
+
     var body: some Scene {
         WindowGroup {
-            Text("Replace me with the onboarding")
+            OnboardingHost()
+                .ignoresSafeArea()
+                .preferredColorScheme(.light)
         }
     }
 }
+
+private struct OnboardingHost: UIViewControllerRepresentable {
+    func makeUIViewController(context: Context) -> OnboardingController {
+        OnboardingController(rootView: OnboardingView())
+    }
+
+    func updateUIViewController(_ uiViewController: OnboardingController, context: Context) {}
+}
+
+private final class OnboardingController: UIHostingController<OnboardingView> {
+    override var prefersHomeIndicatorAutoHidden: Bool { true }
+    override var preferredStatusBarStyle: UIStatusBarStyle { .darkContent }
+}
diff --git a/Replica/WelcomeIllustrations.swift b/Replica/WelcomeIllustrations.swift
new file mode 100644
index 0000000..b4ccbea
--- /dev/null
+++ b/Replica/WelcomeIllustrations.swift
@@ -0,0 +1,338 @@
+import SwiftUI
+
+// All illustration coordinates use the reference device's 440-point canvas.
+// A shared clock keeps the staggered entrances and the drawn route in sync.
+private func progress(_ time: Double, after delay: Double, duration: Double) -> Double {
+    min(1, max(0, (time - delay) / duration))
+}
+
+private func ease(_ value: Double) -> Double {
+    value * value * (3 - 2 * value)
+}
+
+private func spring(_ time: Double, after delay: Double, speed: Double = 15) -> Double {
+    let t = max(0, time - delay)
+    guard t > 0 else { return 0 }
+    return 1 - exp(-speed * 0.7 * t) * (cos(speed * t) + 0.7 * sin(speed * t))
+}
+
+struct RecommendationIllustration: View {
+    let time: Double
+
+    var body: some View {
+        ZStack(alignment: .topLeading) {
+            recommender("welcome-suipo", name: "特厨隋坡", size: 88, selected: false, delay: -0.08)
+                .position(x: 103, y: 114)
+            recommender("welcome-wulala", name: "特别乌啦啦", size: 114, selected: true, delay: 0.04)
+                .position(x: 220, y: 84)
+            recommender("welcome-jason", name: "刘雨鑫JASON", size: 88, selected: false, delay: 0.16)
+                .position(x: 337, y: 114)
+
+            RecommendationCard(time: time)
+                .frame(width: 340, height: 204)
+                .rotationEffect(.degrees(-1.5))
+                .scaleEffect(0.96 + 0.04 * spring(time, after: 0.35))
+                .opacity(ease(progress(time, after: 0.35, duration: 0.18)))
+                .position(x: 220, y: 273 + 34 * (1 - spring(time, after: 0.35)))
+
+            Image("welcome-noodles")
+                .resizable().scaledToFit()
+                .frame(width: 140, height: 140)
+                .shadow(color: .brown.opacity(0.14), radius: 9, x: 0, y: 9)
+                .scaleEffect(spring(time, after: 2.05, speed: 14))
+                .opacity(progress(time, after: 2.05, duration: 0.12))
+                .rotationEffect(.degrees(-7 * (1 - spring(time, after: 2.05))))
+                .position(x: 340, y: 421 + sin(max(0, time - 2.2) * 2.4) * 2.5)
+        }
+        .frame(width: 440, height: 500)
+        .accessibilityElement(children: .combine)
+    }
+
+    private func recommender(_ asset: String, name: String, size: CGFloat, selected: Bool, delay: Double) -> some View {
+        let arrival = spring(time, after: delay)
+        return ZStack(alignment: .topLeading) {

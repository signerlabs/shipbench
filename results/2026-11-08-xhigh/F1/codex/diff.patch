+private enum NavigationRoute {
+    static let points: [CGPoint] = {
+        var result: [CGPoint] = []
+        func curve(_ p0: CGPoint, _ p1: CGPoint, _ p2: CGPoint, _ p3: CGPoint) {
+            for i in 0...80 {
+                let t = Double(i) / 80
+                let s = 1 - t
+                result.append(CGPoint(
+                    x: s*s*s*p0.x + 3*s*s*t*p1.x + 3*s*t*t*p2.x + t*t*t*p3.x,
+                    y: s*s*s*p0.y + 3*s*s*t*p1.y + 3*s*t*t*p2.y + t*t*t*p3.y
+                ))
+            }
+        }
+        curve(CGPoint(x: 86, y: 430), CGPoint(x: 145, y: 434), CGPoint(x: 216, y: 439), CGPoint(x: 201, y: 391))
+        curve(CGPoint(x: 201, y: 391), CGPoint(x: 187, y: 346), CGPoint(x: 158, y: 298), CGPoint(x: 212, y: 275))
+        curve(CGPoint(x: 212, y: 275), CGPoint(x: 225, y: 268), CGPoint(x: 246, y: 265), CGPoint(x: 264, y: 262))
+        return result
+    }()
+
+    static let lengths: [CGFloat] = {
+        var result: [CGFloat] = [0]
+        for index in 1..<points.count {
+            result.append(result[index - 1] + hypot(points[index].x - points[index - 1].x, points[index].y - points[index - 1].y))
+        }
+        return result
+    }()
+
+    static var path: Path {
+        Path { path in
+            path.move(to: points[0])
+            path.addLines(Array(points.dropFirst()))
+        }
+    }
+
+    static func location(at progress: Double) -> CGPoint {
+        let distance = progress * (lengths.last ?? 0)
+        guard let index = lengths.firstIndex(where: { $0 >= distance }), index > 0 else { return points[0] }
+        let fraction = (distance - lengths[index - 1]) / max(0.0001, lengths[index] - lengths[index - 1])
+        return CGPoint(x: points[index - 1].x + (points[index].x - points[index - 1].x) * fraction,
+                       y: points[index - 1].y + (points[index].y - points[index - 1].y) * fraction)
+    }
+}

+import Foundation
+
+/// One slice of the "By category" donut.
+struct CategoryStat: Identifiable, Hashable {
+    let name: String
+    let count: Int
+    let value: Int
+    /// Rooms (on the home report) or containers (on a room report) that hold this category.
+    let groups: Int
+    var id: String { name }
+}
+
+/// One bar of the "Value by room / location" chart.
+struct BarEntry: Identifiable, Hashable {
+    let label: String
+    let value: Int
+    var id: String { label }
+}
+
+struct ListRow: Identifiable, Hashable {
+    let id: String
+    /// Asset catalog image name.
+    var image: String?
+    /// SF Symbol used when there is no photo.
+    var symbol: String?
+    /// Room photos are cropped into a rounded square; item cut-outs are fitted.
+    var isPhoto: Bool = false
+    let title: String
+    let subtitle: String
+    let value: Int
+    /// Room id to push when the row is tapped.
+    var destination: String?
+}
+
+struct ListSection: Identifiable, Hashable {
+    let title: String
+    var trailing: String?
+    let rows: [ListRow]
+    var id: String { title }
+}
+
+/// Everything one report page needs.
+struct Report: Identifiable, Hashable {
+    let id: String
+    let title: String
+    let itemCount: Int
+    let groupCount: Int
+    let groupLabel: String
+    let totalValue: Int
+    let categories: [CategoryStat]
+    let barTitle: String
+    let bars: [BarEntry]
+    let sections: [ListSection]
+}
+
+// MARK: - Sample data (hard-coded, offline)
+
+enum SampleData {
+    /// Stable order used to break ties when sorting categories by count.
+    static let categoryOrder = [
+        "Electronics", "Clothing", "Home", "Sports", "Accessories", "Outdoor", "Grocery",
+        "Books", "Tools", "Care", "Container", "Kitchen", "Other", "Documents",
+    ]

+    private static func sortedCategories(_ stats: [CategoryStat]) -> [CategoryStat] {
+        stats.sorted { a, b in
+            if a.count != b.count { return a.count > b.count }
+            let ia = categoryOrder.firstIndex(of: a.name) ?? .max
+            let ib = categoryOrder.firstIndex(of: b.name) ?? .max
+            return ia < ib
+        }
+    }
+
+    private static func containerSummary(_ count: Int) -> String {
+        switch count {
+        case 0: return ""
+        case 1: return " · 1 container"
+        default: return " · \(count) containers"
+        }
+    }
+
+    /// Whole-home report (the launch screen).
+    static let home: Report = {
+        var totals: [String: (count: Int, value: Int, rooms: Int)] = [:]
+        for room in rooms {
+            for (name, count, value, _) in room.categories where count > 0 {
+                var t = totals[name] ?? (0, 0, 0)
+                t.count += count
+                t.value += value
+                t.rooms += 1
+                totals[name] = t
+            }
+        }
+        let categories = sortedCategories(totals.map {
+            CategoryStat(name: $0.key, count: $0.value.count, value: $0.value.value, groups: $0.value.rooms)
+        })
+        let bars = rooms
+            .map { BarEntry(label: $0.name, value: $0.totalValue) }
+            .sorted { $0.value > $1.value }
+        let rows = rooms.map { room in
+            ListRow(
+                id: room.id,
+                image: room.image,
+                isPhoto: true,
+                title: room.name,
+                subtitle: "\(room.itemCount) items" + containerSummary(room.containers.count),
+                value: room.totalValue,
+                destination: room.id
+            )
+        }
+        return Report(
+            id: "home",
+            title: "Home",
+            itemCount: rooms.reduce(0) { $0 + $1.itemCount },
+            groupCount: rooms.count,
+            groupLabel: "Rooms",
+            totalValue: rooms.reduce(0) { $0 + $1.totalValue },
+            categories: categories,
+            barTitle: "Value by room",
+            bars: bars,
+            sections: [ListSection(title: "By room", rows: rows)]
+        )
+    }()
+
+    static func room(_ id: String) -> Report? {
+        guard let room = rooms.first(where: { $0.id == id }) else { return nil }
+        let categories = sortedCategories(room.categories.map {
+            CategoryStat(name: $0.0, count: $0.1, value: $0.2, groups: $0.3)
+        })
+        let bars = ([BarEntry(label: "In room", value: room.inRoomValue)]
+            + room.containers.map { BarEntry(label: $0.name, value: $0.value) })
+            .sorted { $0.value > $1.value }
+        var sections = [ListSection(title: "In room", trailing: Format.money(room.inRoomValue), rows: room.items)]
+        if !room.containerRows.isEmpty {
+            let containersValue = room.containers.reduce(0) { $0 + $1.value }
+            sections.append(ListSection(title: "Containers", trailing: Format.money(containersValue), rows: room.containerRows))
+        }
+        return Report(
+            id: room.id,
+            title: room.name,
+            itemCount: room.itemCount,
+            groupCount: room.containers.count,
+            groupLabel: "Containers",
+            totalValue: room.totalValue,
+            categories: categories,
+            barTitle: "Value by location",
+            bars: bars,
+            sections: sections
+        )
+    }
+}

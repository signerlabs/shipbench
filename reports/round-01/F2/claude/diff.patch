diff --git a/Replica/ReportView.swift b/Replica/ReportView.swift
new file mode 100644
index 0000000..4941541
--- /dev/null
+++ b/Replica/ReportView.swift
@@ -0,0 +1,281 @@
+import SwiftUI
+
+/// The "统计报表" page. Used for the whole home (root) and for a single room (pushed).
+struct ReportView: View {
+    let report: Report
+    let isRoot: Bool
+
+    @State private var selection: String?
+    /// Pushed reports start empty and fill in on first appearance.
+    @State private var revealed: Bool
+
+    init(report: Report, isRoot: Bool) {
+        self.report = report
+        self.isRoot = isRoot
+        _revealed = State(initialValue: isRoot)
+    }
+
+    private var selectedStat: CategoryStat? {
+        report.categories.first { $0.name == selection }
+    }
+
+    private var reveal: Double { revealed ? 1 : 0 }
+
+    var body: some View {
+        ScrollView {
+            VStack(spacing: Theme.cardSpacing) {
+                summaryCard
+                categoryCard
+                valueCard
+                ForEach(report.sections) { section in
+                    ListCard(section: section)
+                }
+            }
+            .padding(.horizontal, Theme.pagePadding)
+            .padding(.top, Layout.topPadding)
+            .padding(.bottom, Layout.bottomPadding)
+        }
+        .background { DottedBackground() }
+        .navigationTitle(report.title)
+        .navigationBarTitleDisplayMode(.inline)
+        .toolbar {
+            if isRoot {
+                ToolbarItem(placement: .topBarLeading) {
+                    Button {
+                        // The home report is the app's entry point; nothing to go back to.
+                    } label: {
+                        Image(systemName: "chevron.left")
+                    }
+                    .accessibilityLabel("Back")
+                }
+            }
+            ToolbarItem(placement: .topBarTrailing) {
+                ShareLink(item: shareText) {
+                    Image(systemName: "square.and.arrow.up")
+                        .foregroundStyle(Theme.brown)
+                }
+                .accessibilityLabel("Share")
+            }
+        }
+        .onAppear {
+            guard !revealed else { return }
+            withAnimation(Theme.revealAnimation) {
+                revealed = true
+            }
+        }
+    }
+
+    // MARK: Cards
+
+    private var summaryCard: some View {
+        let items = (selectedStat?.count ?? report.itemCount) * (revealed ? 1 : 0)
+        let groups = (selectedStat?.groups ?? report.groupCount) * (revealed ? 1 : 0)
+        let value = (selectedStat?.value ?? report.totalValue) * (revealed ? 1 : 0)
+        return HStack(spacing: 0) {
+            SummaryStat(value: items, text: Format.number(items), label: "Items")
+            SummaryStat(value: groups, text: Format.number(groups), label: report.groupLabel)
+            SummaryStat(value: value, text: Format.money(value), label: "Total value")
+        }
+        .padding(.vertical, Layout.summaryVerticalPadding)
+        .card()
+    }
+
+    private var categoryCard: some View {
+        let centerCount = (selectedStat?.count ?? report.itemCount) * (revealed ? 1 : 0)
+        return VStack(alignment: .leading, spacing: Layout.titleSpacing) {
+            CardTitle(text: "By category")
+            HStack(spacing: 12) {
+                ZStack {
+                    DonutChart(
+                        categories: report.categories,
+                        selection: $selection,
+                        reveal: reveal
+                    )
+                    VStack(spacing: 1.8) {
+                        Text(Format.number(centerCount))
+                            .font(.system(size: 22, weight: .bold))
+                            .foregroundStyle(Theme.ink)
+                            .contentTransition(.numericText(value: Double(centerCount)))
+                        Text(selectedStat?.name ?? "All items")
+                            .font(Theme.captionFont)
+                            .foregroundStyle(Theme.inkSecondary)
+                    }
+                    .allowsHitTesting(false)
+                }
+                .frame(maxWidth: .infinity)
+                .frame(height: 190)
+
+                ChartLegend(names: report.categories.map(\.name))
+            }
+        }
+        .padding(.horizontal, Layout.chartCardPadding)
+        .padding(.top, Layout.categoryTopPadding)
+        .padding(.bottom, Layout.categoryBottomPadding)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .card()
+    }
+
+    private var valueCard: some View {
+        VStack(alignment: .leading, spacing: Layout.barTitleSpacing) {
+            CardTitle(text: report.barTitle)
+            ValueBarChart(bars: report.bars, reveal: reveal)
+        }
+        .padding(.horizontal, Layout.chartCardPadding)
+        .padding(.top, Layout.chartCardPadding)
+        .padding(.bottom, Layout.barCardBottomPadding)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .card()
+    }
+
+    private var shareText: String {
+        "\(report.title): \(report.itemCount) items · \(Format.money(report.totalValue)) total value"
+    }
+}
+
+/// Fine-tuned spacing (points) matched against the reference recording.
+enum Layout {
+    static let topPadding: CGFloat = 8
+    /// Sets the scroll extent so the page bottoms out exactly where the reference does.
+    static let bottomPadding: CGFloat = 39
+    static let summaryVerticalPadding: CGFloat = 13.7
+    static let chartCardPadding: CGFloat = 14
+    static let titleSpacing: CGFloat = 10
+    static let categoryTopPadding: CGFloat = 14
+    static let categoryBottomPadding: CGFloat = 13.9
+    static let barTitleSpacing: CGFloat = 2.3
+    static let barCardBottomPadding: CGFloat = 18
+}
+
+struct CardTitle: View {
+    let text: String
+
+    var body: some View {
+        Text(text)
+            .font(.system(size: 13, weight: .semibold))
+            .foregroundStyle(Theme.inkHeader)
+    }
+}
+
+struct SummaryStat: View {
+    let value: Int
+    let text: String
+    let label: String
+
+    var body: some View {
+        VStack(spacing: 2.9) {
+            Text(text)
+                .font(.system(size: 19, weight: .semibold))
+                .foregroundStyle(Theme.ink)
+                .contentTransition(.numericText(value: Double(value)))
+            Text(label)
+                .font(Theme.captionFont)
+                .foregroundStyle(Theme.inkSecondary)
+        }
+        .frame(maxWidth: .infinity)
+    }
+}
+
+/// "By room" / "In room" list card.
+struct ListCard: View {
+    let section: ListSection
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            HStack(alignment: .firstTextBaseline) {
+                CardTitle(text: section.title)
+                Spacer(minLength: 8)
+                if let trailing = section.trailing {
+                    Text(trailing)
+                        .font(.system(size: 12.2, weight: .semibold))
+                        .foregroundStyle(Theme.inkSecondary)
+                }
+            }
+            .padding(.horizontal, 12)
+            .padding(.top, 10)
+            .padding(.bottom, 10)
+
+            ForEach(Array(section.rows.enumerated()), id: \.element.id) { index, row in
+                if index > 0 {
+                    Rectangle()
+                        .fill(Color.black.opacity(0.14))
+                        .frame(height: 1 / 3)
+                        .padding(.leading, 68)
+                }
+                if let destination = row.destination {
+                    NavigationLink(value: destination) {
+                        ListRowView(row: row)
+                    }
+                    .buttonStyle(FlatButtonStyle())
+                } else {
+                    ListRowView(row: row)
+                }
+            }
+        }
+        .padding(.bottom, 6)
+        .frame(maxWidth: .infinity, alignment: .leading)
+        .card()
+    }
+}
+
+struct ListRowView: View {
+    let row: ListRow
+
+    var body: some View {
+        HStack(spacing: 12) {
+            thumbnail
+                .frame(width: 44, height: 44)
+
+            VStack(alignment: .leading, spacing: 2) {
+                Text(row.title)
+                    .font(.system(size: 15, weight: .medium))
+                    .foregroundStyle(Theme.ink)
+                    .lineLimit(1)
+                Text(row.subtitle)
+                    .font(.system(size: 11))
+                    .foregroundStyle(Theme.inkSecondary)
+                    .lineLimit(1)
+            }
+
+            Spacer(minLength: 8)
+
+            Text(Format.money(row.value))
+                .font(.system(size: 13.5, weight: .medium))
+                .foregroundStyle(Theme.inkHeader)
+
+            Image(systemName: "chevron.right")
+                .font(.system(size: 11, weight: .semibold))
+                .foregroundStyle(Theme.inkTertiary)
+        }
+        .padding(.horizontal, 12)
+        .padding(.vertical, 9)
+        .contentShape(Rectangle())
+    }
+
+    @ViewBuilder
+    private var thumbnail: some View {
+        if let image = row.image {
+            if row.isPhoto {
+                Image(image)
+                    .resizable()
+                    .scaledToFill()
+                    .frame(width: 44, height: 44)
+                    .clipShape(RoundedRectangle(cornerRadius: 10, style: .continuous))
+            } else {
+                Image(image)
+                    .resizable()
+                    .scaledToFit()
+            }
+        } else if let symbol = row.symbol {
+            Image(systemName: symbol)
+                .font(.system(size: 22))
+                .foregroundStyle(Theme.inkHeader)
+        }
+    }
+}
+
+/// Plain tappable row with no pressed highlight (matches the reference).
+struct FlatButtonStyle: ButtonStyle {
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+    }
+}

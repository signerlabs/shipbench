index 0000000..cd076b0
--- /dev/null
+++ b/Replica/DonutChart.swift
@@ -0,0 +1,253 @@
+import SwiftUI
+
+/// A donut sector with constant-width gaps and rounded corners
+/// (same look as a Swift Charts `SectorMark` with `angularInset` + `cornerRadius`).
+///
+/// Angles are expressed as fractions of the full circle, measured clockwise from 12 o'clock.
+/// `reveal` compresses the whole ring into an arc centred on 6 o'clock: at 0 nothing is
+/// visible, at 1 the ring is complete. This reproduces the fan-out entrance animation.
+struct DonutSectorShape: Shape {
+    var startFraction: Double
+    var endFraction: Double
+    var outerRadius: CGFloat
+    var reveal: Double
+    var innerRatio: CGFloat = 0.6
+    var gap: CGFloat = 2.3
+    var cornerRadius: CGFloat = 6
+
+    var animatableData: AnimatablePair<CGFloat, Double> {
+        get { AnimatablePair(outerRadius, reveal) }
+        set {
+            outerRadius = newValue.first
+            reveal = newValue.second
+        }
+    }
+
+    func path(in rect: CGRect) -> Path {
+        let center = CGPoint(x: rect.midX, y: rect.midY)
+        let span = 2 * Double.pi * max(0, min(1, reveal))
+        guard span > 0.0001 else { return Path() }
+        let base = Double.pi - span / 2
+        let a1 = base + startFraction * span
+        let a2 = base + endFraction * span
+        return Self.sectorPath(
+            center: center,
+            a1: a1, a2: a2,
+            outer: outerRadius,
+            inner: outerRadius * innerRatio,
+            gap: gap,
+            corner: cornerRadius
+        )
+    }
+
+    // MARK: Geometry
+
+    /// Point at clockwise angle `a` (radians from 12 o'clock) and radius `r`.
+    private static func point(_ c: CGPoint, _ a: Double, _ r: Double) -> CGPoint {
+        CGPoint(x: c.x + r * sin(a), y: c.y - r * cos(a))
+    }
+
+    private static func appendArc(
+        _ pts: inout [CGPoint], center: CGPoint, radius: Double, from: Double, to: Double, maxStep: Double
+    ) {
+        let delta = to - from
+        let steps = max(2, Int(ceil(abs(delta) / maxStep)))
+        for i in 0...steps {
+            let a = from + delta * Double(i) / Double(steps)
+            pts.append(point(center, a, radius))
+        }
+    }
+
+    /// Angle (clockwise from 12 o'clock) of `p` around `c`.
+    private static func angle(of p: CGPoint, around c: CGPoint) -> Double {
+        atan2(Double(p.x - c.x), Double(c.y - p.y))
+    }
+
+    /// Appends the fillet arc around `fc` from `p` to `q`, going the short way.
+    private static func appendFillet(_ pts: inout [CGPoint], fc: CGPoint, r: Double, from p: CGPoint, to q: CGPoint) {
+        guard r > 0.01 else {
+            pts.append(p)
+            pts.append(q)
+            return
+        }
+        let s = angle(of: p, around: fc)
+        var e = angle(of: q, around: fc)
+        var d = e - s
+        while d > .pi { d -= 2 * .pi }
+        while d < -.pi { d += 2 * .pi }
+        e = s + d
+        appendArc(&pts, center: fc, radius: r, from: s, to: e, maxStep: .pi / 16)
+    }
+
+    static func sectorPath(center c: CGPoint, a1: Double, a2: Double, outer R: Double, inner r: Double, gap: Double, corner: Double) -> Path {
+        let theta = a2 - a1
+        guard theta > 0, R > r else { return Path() }
+        let half = gap / 2
+        let s = sin(min(theta / 2, .pi / 2))
+        // Edges are lines parallel to the radial boundaries, offset inwards by `half`.
+        // Where the two edges meet (apex) — sectors thinner than the gap disappear.
+        let apexRadius = s > 0 ? half / s : .infinity
+        if apexRadius >= R - 0.05 { return Path() }
+
+        let u1 = (x: sin(a1), y: -cos(a1)), n1 = (x: cos(a1), y: sin(a1))   // radial dir / inward normal (edge 1)
+        let u2 = (x: sin(a2), y: -cos(a2)), n2 = (x: -cos(a2), y: -sin(a2)) // edge 2 normal points back inside
+
+        func foot(_ p: CGPoint, _ u: (x: Double, y: Double), _ n: (x: Double, y: Double)) -> CGPoint {
+            let px = Double(p.x - c.x), py = Double(p.y - c.y)
+            let t = px * u.x + py * u.y
+            return CGPoint(x: c.x + t * u.x + half * n.x, y: c.y + t * u.y + half * n.y)
+        }
+
+        // Clamp the corner radius so fillets fit inside the sector.
+        var cr = min(corner, (R - r) / 2 - 0.01)
+        cr = min(cr, (R * s - half) / (1 + s))
+        let innerVisible = r * s - half > 0
+        if innerVisible, s < 1 {
+            cr = min(cr, (r * s - half) / (1 - s))
+        }
+        cr = max(0, cr)
+
+        var pts: [CGPoint] = []
+
+        // Outer corners.
+        let dO = asin(min(1, (half + cr) / (R - cr)))
+        let co1 = point(c, a1 + dO, R - cr)
+        let co2 = point(c, a2 - dO, R - cr)
+        let to1Line = foot(co1, u1, n1)
+        let to1Arc = point(c, a1 + dO, R)
+        let to2Arc = point(c, a2 - dO, R)
+        let to2Line = foot(co2, u2, n2)
+
+        if innerVisible {
+            let dI = asin(min(1, (half + cr) / (r + cr)))
+            let ci1 = point(c, a1 + dI, r + cr)
+            let ci2 = point(c, a2 - dI, r + cr)
+            let ti1Line = foot(ci1, u1, n1)
+            let ti1Arc = point(c, a1 + dI, r)
+            let ti2Line = foot(ci2, u2, n2)
+            let ti2Arc = point(c, a2 - dI, r)
+
+            pts.append(ti1Line)
+            pts.append(to1Line)
+            appendFillet(&pts, fc: co1, r: cr, from: to1Line, to: to1Arc)
+            appendArc(&pts, center: c, radius: R, from: a1 + dO, to: a2 - dO, maxStep: .pi / 180)
+            appendFillet(&pts, fc: co2, r: cr, from: to2Arc, to: to2Line)
+            pts.append(ti2Line)
+            appendFillet(&pts, fc: ci2, r: cr, from: ti2Line, to: ti2Arc)
+            appendArc(&pts, center: c, radius: r, from: a2 - dI, to: a1 + dI, maxStep: .pi / 180)
+            appendFillet(&pts, fc: ci1, r: cr, from: ti1Arc, to: ti1Line)
+        } else {
+            // Thin wedge: the two edges meet before reaching the inner radius.
+            let mid = (a1 + a2) / 2
+            pts.append(point(c, mid, apexRadius))
+            pts.append(to1Line)
+            appendFillet(&pts, fc: co1, r: cr, from: to1Line, to: to1Arc)
+            appendArc(&pts, center: c, radius: R, from: a1 + dO, to: a2 - dO, maxStep: .pi / 180)
+            appendFillet(&pts, fc: co2, r: cr, from: to2Arc, to: to2Line)
+        }
+
+        var path = Path()
+        path.addLines(pts)
+        path.closeSubpath()
+        return path
+    }
+}
+
+/// "By category" donut: tap a slice to focus it, tap it again (or the hole) to clear.
+struct DonutChart: View {
+    let categories: [CategoryStat]
+    @Binding var selection: String?
+    /// 0 → collapsed, 1 → full ring.
+    let reveal: Double
+
+    /// Ratio of the resting outer radius to the plot radius (selected slices use the full radius).
+    private let restingRatio: CGFloat = 0.9
+
+    private var fractions: [(start: Double, end: Double)] {
+        let total = Double(max(1, categories.reduce(0) { $0 + $1.count }))
+        var acc = 0.0
+        return categories.map { cat in
+            let start = acc / total
+            acc += Double(cat.count)
+            return (start, acc / total)
+        }
+    }
+
+    var body: some View {
+        GeometryReader { geo in
+            let plotRadius = min(geo.size.width, geo.size.height) / 2
+            let frac = fractions
+            ZStack {
+                ForEach(Array(categories.enumerated()), id: \.element.id) { index, cat in
+                    let isSelected = selection == cat.name
+                    DonutSectorShape(
+                        startFraction: frac[index].start,
+                        endFraction: frac[index].end,
+                        outerRadius: isSelected ? plotRadius : plotRadius * restingRatio,
+                        reveal: reveal
+                    )
+                    .fill(Theme.color(at: index))
+                    .opacity(selection == nil || isSelected ? 1 : 0.3)
+                }
+            }
+            .contentShape(Rectangle())
+            .onTapGesture(coordinateSpace: .local) { location in
+                handleTap(at: location, size: geo.size, plotRadius: plotRadius)
+            }
+        }
+    }
+
+    private func handleTap(at location: CGPoint, size: CGSize, plotRadius: CGFloat) {
+        let dx = Double(location.x - size.width / 2)
+        let dy = Double(location.y - size.height / 2)
+        let distance = hypot(dx, dy)
+        var angle = atan2(dx, -dy) / (2 * .pi)
+        if angle < 0 { angle += 1 }
+
+        let resting = Double(plotRadius * restingRatio)
+        let innerLimit = resting * 0.6 * 0.8
+        var target: String?
+        if distance >= innerLimit && distance <= Double(plotRadius) * 1.12 {
+            for (index, f) in fractions.enumerated() where angle >= f.start && angle < f.end {
+                target = categories[index].name
+            }
+        }
+        withAnimation(Theme.selectionAnimation) {
+            if let target, target != selection {
+                selection = target
+            } else {
+                selection = nil
+            }
+        }
+    }
+}
+
+/// Two-column legend, filled column by column (9 rows per column).
+struct ChartLegend: View {
+    let names: [String]
+    private let rowsPerColumn = 9
+
+    var body: some View {
+        let columns = stride(from: 0, to: names.count, by: rowsPerColumn).map { start in
+            Array(names.indices[start..<min(start + rowsPerColumn, names.count)])
+        }
+        HStack(alignment: .top, spacing: 8) {
+            ForEach(columns.indices, id: \.self) { col in
+                VStack(alignment: .leading, spacing: 8) {
+                    ForEach(columns[col], id: \.self) { index in
+                        HStack(spacing: 4.8) {
+                            Circle()
+                                .fill(Theme.color(at: index))
+                                .frame(width: 8, height: 8)
+                            Text(names[index])
+                                .font(.system(size: 11))
+                                .foregroundStyle(Theme.inkLegend)
+                                .lineLimit(1)
+                                .fixedSize()
+                        }
+                    }
+                }
+            }
+        }
+    }
+}

index 0000000..6caa096
--- /dev/null
+++ b/Replica/Theme.swift
@@ -0,0 +1,147 @@
+import SwiftUI
+
+/// Visual constants measured from the reference recording (iPhone 18 Pro Max, @3x).
+enum Theme {
+    // MARK: Colors
+
+    /// Page background (#F5F0E7).
+    static let background = Color(red: 245 / 255, green: 240 / 255, blue: 231 / 255)
+    /// Card fill.
+    static let cardFill = Color(red: 252 / 255, green: 249 / 255, blue: 248 / 255)
+    static let backgroundDotOpacity = 0.074
+    static let cardDotOpacity = 0.036
+    static let cardStroke = Color(red: 231 / 255, green: 228 / 255, blue: 223 / 255)
+    /// Brand brown used for bars and tinted icons (#553829).
+    static let brown = Color(red: 85 / 255, green: 56 / 255, blue: 41 / 255)
+
+    /// Primary text (#2E2A25).
+    static let ink = Color(red: 46 / 255, green: 42 / 255, blue: 37 / 255)
+    /// Section headers, list values.
+    static let inkHeader = Color(red: 111 / 255, green: 110 / 255, blue: 106 / 255)
+    /// Secondary labels.
+    static let inkSecondary = Color(red: 132 / 255, green: 132 / 255, blue: 129 / 255)
+    /// Legend labels.
+    static let inkLegend = Color(red: 135 / 255, green: 136 / 255, blue: 133 / 255)
+    /// Chevrons.
+    static let inkTertiary = Color(red: 199 / 255, green: 199 / 255, blue: 196 / 255)
+
+    /// Categorical palette (iOS 26 system colors, in chart order).
+    static let palette: [Color] = [
+        Color(red: 0 / 255, green: 136 / 255, blue: 255 / 255),   // blue
+        Color(red: 52 / 255, green: 199 / 255, blue: 89 / 255),   // green
+        Color(red: 255 / 255, green: 141 / 255, blue: 40 / 255),  // orange
+        Color(red: 203 / 255, green: 48 / 255, blue: 224 / 255),  // purple
+        Color(red: 255 / 255, green: 56 / 255, blue: 60 / 255),   // red
+        Color(red: 0 / 255, green: 195 / 255, blue: 208 / 255),   // teal
+        Color(red: 255 / 255, green: 204 / 255, blue: 0 / 255),   // yellow
+    ]
+
+    static func color(at index: Int) -> Color {
+        palette[index % palette.count]
+    }
+
+    // MARK: Fonts
+
+    /// Small gray captions under numbers ("Items", "All items"): between regular and medium.
+    static let captionFont = Font(UIFont.systemFont(ofSize: 11.25, weight: UIFont.Weight(rawValue: 0.13)))
+
+    // MARK: Layout
+
+    static let pagePadding: CGFloat = 16
+    static let cardSpacing: CGFloat = 14
+    static let cardRadius: CGFloat = 16
+
+    // MARK: Animations
+
+    /// Tap-to-select on the donut (fitted to the recording: ~0.5 s spring with a small overshoot).
+    static let selectionAnimation = Animation.spring(response: 0.53, dampingFraction: 0.68)
+    /// First-appearance reveal of a pushed report (fitted: ease-out, 1 s).
+    static let revealAnimation = Animation.easeOut(duration: 1.0)
+}
+
+enum Format {
+    private static let formatter: NumberFormatter = {
+        let f = NumberFormatter()
+        f.locale = Locale(identifier: "en_US")
+        f.numberStyle = .decimal
+        f.usesGroupingSeparator = true
+        f.maximumFractionDigits = 0
+        return f
+    }()
+
+    static func number(_ value: Int) -> String {
+        formatter.string(from: NSNumber(value: value)) ?? "\(value)"
+    }
+
+    static func money(_ value: Int) -> String {
+        "$" + number(value)
+    }
+}
+
+/// Rounded card used by every section on the report pages.
+/// The page's dot grid faintly shows through the card (aligned to the screen grid).
+struct CardBackground: ViewModifier {
+    func body(content: Content) -> some View {
+        content
+            .background {
+                let shape = RoundedRectangle(cornerRadius: Theme.cardRadius, style: .continuous)
+                shape
+                    .fill(Theme.cardFill)
+                    .overlay {
+                        DotGrid(opacity: Theme.cardDotOpacity)
+                            .clipShape(shape)
+                    }
+            }
+            .overlay {
+                RoundedRectangle(cornerRadius: Theme.cardRadius, style: .continuous)
+                    .strokeBorder(Theme.cardStroke, lineWidth: 1)
+                    .shadow(color: .black.opacity(0.03), radius: 1.5)
+            }
+    }
+}
+
+extension View {
+    func card() -> some View { modifier(CardBackground()) }
+}
+
+/// Dot grid aligned to screen coordinates (24 pt pitch), so it stays put while content scrolls.
+struct DotGrid: View {
+    let opacity: Double
+
+    var body: some View {
+        GeometryReader { proxy in
+            let origin = proxy.frame(in: .global).origin
+            Canvas { context, size in
+                let spacing: CGFloat = 24
+                let diameter: CGFloat = 1.75
+                let color = Color.black.opacity(opacity)
+                func firstPosition(_ phase: CGFloat, _ offset: CGFloat) -> CGFloat {
+                    // Smallest local coordinate >= -spacing whose screen position matches the grid phase.
+                    let local = phase - offset
+                    return local - (local / spacing).rounded(.down) * spacing - spacing
+                }
+                var y = firstPosition(22.17, origin.y)
+                while y < size.height + spacing {
+                    var x = firstPosition(16, origin.x)
+                    while x < size.width + spacing {
+                        let rect = CGRect(x: x - diameter / 2, y: y - diameter / 2, width: diameter, height: diameter)
+                        context.fill(Path(ellipseIn: rect), with: .color(color))
+                        x += spacing
+                    }
+                    y += spacing
+                }
+            }
+        }
+        .allowsHitTesting(false)
+    }
+}
+
+/// Warm paper background with a faint dot grid that stays fixed to the screen.
+struct DottedBackground: View {
+    var body: some View {
+        DotGrid(opacity: Theme.backgroundDotOpacity)
+            .background(Theme.background)
+            .ignoresSafeArea()
+            .allowsHitTesting(false)
+    }
+}
diff --git a/Replica/ValueBarChart.swift b/Replica/ValueBarChart.swift
new file mode 100644
index 0000000..e776685
--- /dev/null
+++ b/Replica/ValueBarChart.swift
@@ -0,0 +1,103 @@
+import SwiftUI
+
+/// Horizontal bar chart ("Value by room" / "Value by location").
+///
+/// Geometry mirrors the reference: each category label sits above its bar and
+/// the bar band overlaps the next label slightly; values trail the bar end.
+struct ValueBarChart: View {
+    let bars: [BarEntry]
+    /// 0 → empty bars, 1 → full length (entrance animation).
+    let reveal: Double
+
+    /// Space kept on the trailing side for the value label of the longest bar.
+    private let trailingReserve: CGFloat = 49.67
+    private let labelInset: CGFloat = 4
+    /// Labels sit slightly lower than the band top.
+    private let labelDrop: CGFloat = 1.2
+    /// Distance from a label's frame top to its bar's top.
+    private let labelToBar: CGFloat = 29.2
+
+    private var band: CGFloat {
+        let n = CGFloat(max(1, bars.count))
+        return 39.93 + 16.13 / n
+    }
+
+    private var barHeight: CGFloat {
+        let n = CGFloat(max(1, bars.count))
+        return 15.78 + 11.1 / n
+    }
+
+    /// Fewer bars get slightly more breathing room above and below (as in the reference).
+    private var bandInset: CGFloat {
+        max(0, (band - 43.156) * 0.14)
+    }
+
+    /// Total height from the first label's top to just below the last bar.
+    var contentHeight: CGFloat {
+        let n = CGFloat(max(1, bars.count))
+        return bandInset * 2 + labelToBar + (n - 1) * band + barHeight
+    }
+
+    var body: some View {
+        GeometryReader { geo in
+            let maxValue = CGFloat(bars.map(\.value).max() ?? 1)
+            let maxWidth = max(0, geo.size.width - trailingReserve)
+            let progress = CGFloat(max(0, min(1, reveal)))
+            ZStack(alignment: .topLeading) {
+                ForEach(Array(bars.enumerated()), id: \.element.id) { index, bar in
+                    let top = CGFloat(index) * band
+                    let fullWidth = maxValue > 0 ? maxWidth * CGFloat(bar.value) / maxValue : 0
+                    let width = fullWidth * progress
+
+                    Text(bar.label)
+                        .font(.system(size: 11, weight: .medium))
+                        .foregroundStyle(Theme.inkHeader)
+                        .lineLimit(1)
+                        .fixedSize()
+                        .offset(x: labelInset, y: top + labelDrop)
+
+                    BarShape(width: width)
+                        .fill(Theme.brown)
+                        .frame(width: maxWidth, height: barHeight, alignment: .leading)
+                        .offset(y: top + bandInset + labelToBar)
+
+                    Text(Format.money(bar.value))
+                        .font(.system(size: 10.1, weight: .semibold))
+                        .foregroundStyle(Theme.inkSecondary)
+                        .lineLimit(1)
+                        .fixedSize()
+                        .frame(height: barHeight)
+                        .offset(x: width + 6.5, y: top + bandInset + labelToBar)
+                        .opacity(Double(progress))
+                }
+            }
+            .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
+        }
+        .frame(height: contentHeight)
+    }
+}
+
+/// Bar with a square leading edge and rounded trailing corners; animatable width.
+struct BarShape: Shape {
+    var width: CGFloat
+    var cornerRadius: CGFloat = 4
+
+    var animatableData: CGFloat {
+        get { width }
+        set { width = newValue }
+    }
+
+    func path(in rect: CGRect) -> Path {
+        let w = max(0, width)
+        guard w > 0.01 else { return Path() }
+        let r = min(cornerRadius, w, rect.height / 2)
+        let bar = CGRect(x: rect.minX, y: rect.minY, width: w, height: rect.height)
+        return UnevenRoundedRectangle(
+            topLeadingRadius: 0,
+            bottomLeadingRadius: 0,
+            bottomTrailingRadius: r,
+            topTrailingRadius: r,
+            style: .circular
+        ).path(in: bar)
+    }
+}

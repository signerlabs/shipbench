+        let id: String
+        let name: String
+        let image: String
+        /// (category, count, value, containers holding it)
+        let categories: [(String, Int, Int, Int)]
+        let containers: [(name: String, value: Int)]
+        let inRoomValue: Int
+        let items: [ListRow]
+        var containerRows: [ListRow] = []
+
+        var itemCount: Int { categories.reduce(0) { $0 + $1.1 } }
+        var totalValue: Int { categories.reduce(0) { $0 + $1.2 } }
+    }

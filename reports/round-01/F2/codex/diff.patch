@@ -0,0 +1,315 @@
+import SwiftUI
+
+struct ReportView: View {
+    let report: ReportData
+    @Environment(\.dismiss) private var dismiss
+    @State private var selectedCategory: Int?
+    @State private var hasAppeared = false
+    @State private var chartProgress: CGFloat = 0
+    @State private var totalsReady = false
+    @State private var showShare = false
+
+    init(report: ReportData) {
+        self.report = report
+        _chartProgress = State(initialValue: report.isHome ? 1 : 0)
+        _totalsReady = State(initialValue: report.isHome)
+    }
+
+    private var category: ReportCategory? {
+        report.categories.first { $0.id == selectedCategory }
+    }
+
+    var body: some View {
+        ZStack {
+            ReportBackground()
+            ScrollView {
+                VStack(spacing: 16) {
+                    totals
+                    categoryCard
+                    ValueChartCard(entries: report.values, isHome: report.isHome, progress: chartProgress)
+                    inventoryCard
+                    if !report.isHome && report.title == "Bedroom" {
+                        containerCard
+                    }
+                }
+                .padding(.horizontal, 16)
+                .padding(.top, 8)
+                .padding(.bottom, 72)
+            }
+            .ignoresSafeArea(edges: .bottom)
+            .scrollIndicators(.hidden)
+        }
+        .foregroundStyle(ReportTheme.ink)
+        .navigationTitle(report.title)
+        .navigationBarTitleDisplayMode(.inline)
+        .navigationBarBackButtonHidden()
+        .toolbar {
+            ToolbarItem(placement: .topBarLeading) {
+                Button {
+                    if report.isHome { select(nil) } else { dismiss() }
+                } label: {
+                    Image(systemName: "chevron.left")
+                        .font(.system(size: 17, weight: .medium))
+                        .foregroundStyle(.black)
+                }
+                .accessibilityLabel("Back")
+            }
+            ToolbarItem(placement: .topBarTrailing) {
+                Button { showShare = true } label: {
+                    Image(systemName: "square.and.arrow.up")
+                        .font(.system(size: 17))
+                        .foregroundStyle(ReportTheme.brown)
+                }
+                .accessibilityLabel("Share report")
+            }
+        }
+        .sheet(isPresented: $showShare) {
+            ReportShareSheet(text: "\(report.title)\n\(report.count) items\nTotal value: \(ReportTheme.money(report.totalValue))")
+                .presentationDetents([.medium, .large])
+        }
+        .onAppear {
+            guard !hasAppeared else { return }
+            hasAppeared = true
+            if report.isHome {
+                totalsReady = true
+                chartProgress = 1
+            } else {
+                withAnimation(.easeOut(duration: 0.35)) { totalsReady = true }
+                withAnimation(.easeInOut(duration: 1.0)) { chartProgress = 1 }
+            }
+        }
+    }
+
+    private var totals: some View {
+        HStack(spacing: 0) {
+            summary(value: String(!totalsReady ? 0 : category?.count ?? report.count), label: "Items")
+            summary(value: String(!totalsReady ? 0 : category?.locations ?? report.locations), label: report.isHome ? "Rooms" : "Containers")
+            summary(value: ReportTheme.money(!totalsReady ? 0 : category?.value ?? report.totalValue), label: "Total value")
+        }
+        .frame(height: 66)
+        .reportCard()
+    }
+
+    private func summary(value: String, label: String) -> some View {
+        VStack(spacing: 2) {
+            Text(value)
+                .font(.system(size: 19, weight: .semibold))
+                .contentTransition(.numericText())
+            Text(label)
+                .font(.system(size: 11))
+                .foregroundStyle(ReportTheme.muted)
+        }
+        .frame(maxWidth: .infinity)
+    }
+
+    private var categoryCard: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            Text("By category").reportHeading().offset(y: -1)
+            GeometryReader { proxy in
+                HStack(spacing: 12) {
+                    CategoryDonut(categories: report.categories, selected: selectedCategory, progress: chartProgress, select: select)
+                        .overlay {
+                            VStack(spacing: 1) {
+                                Text(String(!totalsReady ? 0 : category?.count ?? report.count))
+                                    .font(.system(size: 22, weight: .bold))
+                                    .contentTransition(.numericText())
+                                Text(category?.name ?? "All items")
+                                    .font(.system(size: 11))
+                                    .foregroundStyle(ReportTheme.muted)
+                            }
+                            .contentShape(Circle())
+                            .onTapGesture { select(nil) }
+                        }
+                        .frame(width: max(150, proxy.size.width - 168.6667))
+                        .offset(y: 1)
+                    categoryLegend
+                        .frame(width: 156.6667, alignment: .leading)
+                }
+            }
+            .frame(height: 190)
+        }
+        .padding(14)
+        .reportCard()
+    }
+
+    private var categoryLegend: some View {
+        HStack(alignment: .top, spacing: 0) {
+            legendColumn(Array(report.categories.prefix(9)))
+                .frame(width: 84, alignment: .leading)
+            legendColumn(Array(report.categories.dropFirst(9)))
+        }
+        .frame(height: 190, alignment: .topLeading)
+    }
+
+    private func legendColumn(_ categories: [ReportCategory]) -> some View {
+        VStack(alignment: .leading, spacing: 0) {
+            ForEach(categories) { item in
+                Button { select(item.id) } label: {
+                    HStack(spacing: 5) {
+                        Circle().fill(item.color).frame(width: 8, height: 8)
+                        Text(item.name)
+                            .font(.system(size: 11))
+                            .foregroundStyle(ReportTheme.muted)
+                            .fixedSize()
+                    }
+                    .frame(height: 64.0 / 3, alignment: .center)
+                    .contentShape(Rectangle())
+                }
+                .buttonStyle(.plain)
+            }
+        }
+    }
+
+    private func select(_ id: Int?) {
+        withAnimation(.spring(response: 0.4, dampingFraction: 0.83)) {
+            selectedCategory = selectedCategory == id ? nil : id
+        }
+    }
+
+    private var inventoryCard: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Text(report.isHome ? "By room" : "In room").reportHeading()
+                Spacer()
+                if !report.isHome {
+                    Text(ReportTheme.money(report.values.first?.value ?? report.totalValue))
+                        .font(.system(size: 12, weight: .semibold))
+                        .foregroundStyle(ReportTheme.muted)
+                }
+            }
+            .padding(.horizontal, 12)
+            .frame(height: 34)
+            ForEach(Array(report.entries.enumerated()), id: \.element.id) { index, entry in
+                if report.isHome {
+                    NavigationLink {
+                        ReportView(report: .room(entry))
+                    } label: {
+                        InventoryRow(entry: entry, isRoom: true, separator: index < report.entries.count - 1)
+                    }
+                    .buttonStyle(ReportRowButtonStyle())
+                } else {
+                    InventoryRow(entry: entry, isRoom: false, separator: index < report.entries.count - 1)
+                }
+            }
+        }
+        .padding(.bottom, 6)
+        .reportCard()
+    }
+
+    private var containerCard: some View {
+        VStack(spacing: 0) {
+            HStack {
+                Text("Seasonal Box").reportHeading()
+                Spacer()
+                Text("$201").font(.system(size: 12, weight: .semibold)).foregroundStyle(ReportTheme.muted)
+            }
+            .padding(.horizontal, 12)
+            .frame(height: 34)
+            InventoryRow(entry: .init(name: "Seasonal Box", subtitle: "Container", image: "box-storage", value: 201), isRoom: false, separator: false)
+        }
+        .padding(.bottom, 6)
+        .reportCard()
+    }
+}
+
+struct ReportBackground: View {
+    var body: some View {
+        ReportTheme.background
+            .overlay {
+                Canvas { context, size in
+                    for x in stride(from: 16.0, to: size.width, by: 24) {
+                        for y in stride(from: 22.0, to: size.height, by: 24) {
+                            let fade = min(1, max(0, (size.height - y) / 240))
+                            context.fill(Path(ellipseIn: CGRect(x: x - 0.8, y: y - 0.8, width: 1.6, height: 1.6)), with: .color(Color(white: 0.3).opacity(0.07 * fade)))
+                        }
+                    }
+                }
+            }
+            .ignoresSafeArea()
+    }
+}
+
+struct InventoryRow: View {
+    let entry: InventoryEntry
+    let isRoom: Bool
+    let separator: Bool
+
+    var body: some View {
+        HStack(spacing: 12) {
+            Group {
+                if isRoom {
+                    Image(entry.image).resizable().scaledToFill()
+                } else {
+                    Image(entry.image).resizable().scaledToFit()
+                }
+            }
+            .frame(width: 44, height: 44)
+            .clipShape(RoundedRectangle(cornerRadius: isRoom ? 10 : 0))
+            VStack(alignment: .leading, spacing: 2) {
+                Text(entry.name).font(.system(size: 15, weight: .medium)).foregroundStyle(ReportTheme.ink)
+                Text(entry.subtitle).font(.system(size: 11)).foregroundStyle(ReportTheme.muted)
+            }
+            .frame(maxWidth: .infinity, alignment: .leading)
+            Text(ReportTheme.money(entry.value))
+                .font(.system(size: 13, weight: .semibold))
+                .foregroundStyle(ReportTheme.secondary)
+            Image(systemName: "chevron.right")
+                .font(.system(size: 12, weight: .semibold))
+                .foregroundStyle(Color.gray.opacity(0.4))
+        }
+        .padding(.horizontal, 12)
+        .frame(height: 62.4)
+        .contentShape(Rectangle())
+        .overlay(alignment: .bottom) {
+            if separator {
+                Rectangle().fill(Color.black.opacity(0.20))
+                    .frame(height: 1 / 3)
+                    .padding(.leading, 68)
+            }
+        }
+    }
+}
+
+struct ReportRowButtonStyle: ButtonStyle {
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label.background(configuration.isPressed ? ReportTheme.brown.opacity(0.07) : .clear)
+    }
+}
+
+extension View {
+    func reportCard() -> some View {
+        background {
+            ReportTheme.card.overlay {
+                GeometryReader { geometry in
+                    let origin = geometry.frame(in: .global).origin
+                    Canvas { context, size in
+                        let firstX = 16 - origin.x.truncatingRemainder(dividingBy: 24)
+                        let firstY = 22 - origin.y.truncatingRemainder(dividingBy: 24)
+                        for x in stride(from: firstX - 24, to: size.width, by: 24) {
+                            for y in stride(from: firstY - 24, to: size.height, by: 24) {
+                                let dot = Path(ellipseIn: CGRect(x: x - 0.8, y: y - 0.8, width: 1.6, height: 1.6))
+                                context.fill(dot, with: .color(Color(white: 0.3).opacity(0.022)))
+                            }
+                        }
+                    }
+                }
+            }
+        }
+            .overlay(RoundedRectangle(cornerRadius: 14).strokeBorder(ReportTheme.border, lineWidth: 0.8))
+            .clipShape(RoundedRectangle(cornerRadius: 14))
+    }
+
+    func reportHeading() -> some View {
+        font(.system(size: 13, weight: .semibold))
+            .foregroundStyle(ReportTheme.secondary)
+            .frame(height: 16, alignment: .leading)
+    }
+}
+
+struct ReportShareSheet: UIViewControllerRepresentable {
+    let text: String
+    func makeUIViewController(context: Context) -> UIActivityViewController {
+        UIActivityViewController(activityItems: [text], applicationActivities: nil)
+    }
+    func updateUIViewController(_ uiViewController: UIActivityViewController, context: Context) {}
+}

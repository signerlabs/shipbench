+++ b/Replica/ReportCharts.swift
@@ -0,0 +1,104 @@
+import SwiftUI
+import Charts
+
+struct CategoryDonut: View {
+    let categories: [ReportCategory]
+    let selected: Int?
+    var progress: CGFloat
+    let select: (Int?) -> Void
+
+    private var total: Double { Double(categories.reduce(0) { $0 + $1.count }) }
+
+    var body: some View {
+        Chart {
+            // Equal empty sectors keep the opening animation centered at the bottom.
+            SectorMark(angle: .value("Items", 180 * (1 - progress)))
+                .foregroundStyle(.clear)
+            ForEach(categories) { item in
+                SectorMark(
+                    angle: .value("Items", Double(item.count) / total * 360 * progress),
+                    innerRadius: .ratio(0.6),
+                    outerRadius: .ratio(selected == item.id ? 1 : 0.9),
+                    angularInset: 1
+                )
+                .cornerRadius(6)
+                .foregroundStyle(item.color.opacity(selected == nil || selected == item.id ? 1 : 0.3))
+            }
+            SectorMark(angle: .value("Items", 180 * (1 - progress)))
+                .foregroundStyle(.clear)
+        }
+        .chartLegend(.hidden)
+        .chartXAxis(.hidden)
+        .chartYAxis(.hidden)
+        .chartOverlay { proxy in
+            GeometryReader { geometry in
+                Color.clear
+                    .contentShape(Rectangle())
+                    .onTapGesture { location in
+                        let center = CGPoint(x: geometry.size.width / 2, y: geometry.size.height / 2)
+                        let dx = location.x - center.x
+                        let dy = location.y - center.y
+                        let radius = hypot(dx, dy)
+                        guard radius > min(geometry.size.width, geometry.size.height) * 0.25 else {
+                            select(nil)
+                            return
+                        }
+                        var angle = atan2(dx, -dy)
+                        if angle < 0 { angle += .pi * 2 }
+                        let value = angle / (.pi * 2) * total
+                        var cumulative = 0.0
+                        for item in categories {
+                            cumulative += Double(item.count)
+                            if value < cumulative {
+                                select(item.id)
+                                return
+                            }
+                        }
+                    }
+            }
+        }
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel("By category")
+        .accessibilityValue(selected.flatMap { id in categories.first { $0.id == id }?.name } ?? "All items")
+    }
+}
+
+struct ValueChartCard: View {
+    let entries: [ValueEntry]
+    let isHome: Bool
+    let progress: CGFloat
+
+    private var rowHeight: CGFloat { isHome ? 43.2 : 48 }
+    private var chartHeight: CGFloat { CGFloat(entries.count) * rowHeight + 6 }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 2) {
+            Text(isHome ? "Value by room" : "Value by location").reportHeading().offset(y: -1)
+            GeometryReader { geometry in
+                let barWidth = geometry.size.width - 50
+                let maximum = Double(entries.map(\.value).max() ?? 1)
+                ForEach(Array(entries.enumerated()), id: \.element.id) { index, entry in
+                    let y = CGFloat(index) * rowHeight
+                    Text(entry.name)
+                        .font(.system(size: 12))
+                        .foregroundStyle(ReportTheme.secondary)
+                        .offset(x: 4, y: y)
+                    HStack(spacing: 6) {
+                        UnevenRoundedRectangle(topLeadingRadius: 0, bottomLeadingRadius: 0, bottomTrailingRadius: 4, topTrailingRadius: 4)
+                            .fill(ReportTheme.brown)
+                            .frame(width: max(0.5, barWidth * Double(entry.value) / maximum * progress), height: isHome ? 18 : 21.4)
+                        Text(ReportTheme.money(entry.value))
+                            .font(.system(size: 10, weight: .medium))
+                            .foregroundStyle(ReportTheme.muted)
+                            .fixedSize()
+                            .opacity(progress)
+                    }
+                    .offset(y: y + (isHome ? 28 : 29))
+                }
+            }
+            .frame(height: chartHeight)
+        }
+        .padding(14)
+        .reportCard()
+    }
+}

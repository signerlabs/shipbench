+import SwiftUI
+
+/// Edit sheet for a habit: rename it and pick a color from `Habit.palette`.
+/// Present with `.sheet(item:)`, passing the tapped habit.
+struct HabitEditView: View {
+    /// The habit handed over by `.sheet(item:)`. Only used for its id, and as a
+    /// fallback if the store no longer has it.
+    let habit: Habit
+
+    @Environment(\.dismiss) private var dismiss
+    private let store = HabitStore.shared
+
+    // Only what the user has changed; untouched fields keep following the store.
+    @State private var editedName: String?
+    @State private var editedColorName: String?
+    @State private var isSaving = false
+
+    /// Palette keys in a stable order (`Habit.palette` is a dictionary).
+    private let colorNames = Habit.palette.keys.sorted()
+
+    private var draft: Habit {
+        var draft = store.habits.first { $0.id == habit.id } ?? habit
+        if let editedName { draft.name = editedName }
+        if let editedColorName { draft.colorName = editedColorName }
+        return draft
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 24) {
+            Text("Edit Habit")
+                .font(.headline)
+                .frame(maxWidth: .infinity)
+
+            VStack(alignment: .leading, spacing: 8) {
+                Text("Name")
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+                TextField("Habit name", text: Binding(
+                    get: { draft.name },
+                    set: { editedName = $0 }
+                ))
+                .submitLabel(.done)
+                .padding()
+                .overlay(
+                    RoundedRectangle(cornerRadius: 16)
+                        .strokeBorder(.secondary.opacity(0.5), lineWidth: 1)
+                )
+            }
+
+            VStack(alignment: .leading, spacing: 8) {
+                Text("Color")
+                    .font(.subheadline)
+                    .foregroundStyle(.secondary)
+                HStack(spacing: 8) {
+                    ForEach(colorNames, id: \.self) { colorName in
+                        colorSwatch(colorName, isSelected: colorName == draft.colorName)
+                    }
+                }
+            }
+
+            Spacer(minLength: 0)
+
+            HStack {
+                Button("Cancel") { dismiss() }
+                    .buttonStyle(.swSecondary)
+
+                Button(action: save) {
+                    Text("Save")
+                        .opacity(isSaving ? 0 : 1)
+                        .overlay {
+                            if isSaving { ProgressView().tint(.white) }
+                        }
+                }
+                .buttonStyle(.swPrimary)
+            }
+            .disabled(isSaving)
+        }
+        .padding()
+        .presentationDetents([.medium])
+        .presentationDragIndicator(.visible)
+        .interactiveDismissDisabled(isSaving)
+    }
+
+    private func colorSwatch(_ colorName: String, isSelected: Bool) -> some View {
+        Button {
+            editedColorName = colorName
+        } label: {
+            Circle()
+                .fill(Habit.palette[colorName] ?? .green)
+                .frame(width: 32, height: 32)
+                .overlay {
+                    if isSelected {
+                        Image(systemName: "checkmark")
+                            .font(.footnote.bold())
+                            .foregroundStyle(.white)
+                    }
+                }
+                .frame(width: 44, height: 44)
+                .contentShape(.rect)
+        }
+        .buttonStyle(.plain)
+        .accessibilityLabel(colorName.capitalized)
+        .accessibilityAddTraits(isSelected ? .isSelected : [])
+    }
+
+    private func save() {
+        let habit = draft
+        isSaving = true
+        Task {
+            do {
+                try await store.save(habit)
+                SWAlertManager.shared.show(.success, message: "Saved")
+                dismiss()
+            } catch {
+                SWAlertManager.shared.show(.error, message: error.localizedDescription)
+            }
+            isSaving = false
+        }
+    }
+}
+
+#Preview {
+    Color.clear
+        .sheet(isPresented: .constant(true)) {
+            HabitEditView(habit: HabitStore.shared.habits[0])
+        }
+        .swAlert()
+}

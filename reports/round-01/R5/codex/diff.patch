+import SwiftUI
+
+struct HabitEditView: View {
+    @Environment(\.dismiss) private var dismiss
+    @State private var draft: Habit
+    @State private var isSaving = false
+
+    init(habit: Habit) {
+        _draft = State(initialValue: habit)
+    }
+
+    var body: some View {
+        NavigationStack {
+            Form {
+                Section("Name") {
+                    TextField("Habit name", text: $draft.name)
+                }
+
+                Section("Color") {
+                    Picker("Color", selection: $draft.colorName) {
+                        ForEach(Habit.palette.keys.sorted(), id: \.self) { colorName in
+                            HStack(spacing: 12) {
+                                Circle()
+                                    .fill(Habit.palette[colorName] ?? .green)
+                                    .frame(width: 16, height: 16)
+                                Text(colorName.capitalized)
+                            }
+                            .tag(colorName)
+                        }
+                    }
+                    .pickerStyle(.inline)
+                    .labelsHidden()
+                }
+            }
+            .disabled(isSaving)
+            .navigationTitle("Edit Habit")
+            .navigationBarTitleDisplayMode(.inline)
+            .safeAreaInset(edge: .bottom) {
+                HStack {
+                    Button("Cancel") { dismiss() }
+                        .buttonStyle(.swSecondary)
+
+                    Button(isSaving ? "Saving…" : "Save", action: save)
+                        .buttonStyle(.swPrimary)
+                }
+                .disabled(isSaving)
+                .padding()
+                .background(.bar)
+            }
+        }
+        .interactiveDismissDisabled(isSaving)
+    }
+
+    private func save() {
+        guard !isSaving else { return }
+        isSaving = true
+
+        Task {
+            defer { isSaving = false }
+
+            do {
+                try await HabitStore.shared.save(draft)
+                dismiss()
+                SWAlertManager.shared.show(.success, message: "Saved")
+            } catch {
+                SWAlertManager.shared.show(.error, message: error.localizedDescription)
+            }
+        }
+    }
+}

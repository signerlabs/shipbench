+        let second: TimeInterval = 800_000_000
+        let synced = Date(timeIntervalSinceReferenceDate: second + 0.5)
+        let macs = [
+            (local: fromA, createdAt: Date(timeIntervalSinceReferenceDate: second + 0.5004), remote: fromB),
+            (local: fromB, createdAt: Date(timeIntervalSinceReferenceDate: second + 0.5002), remote: fromA),
+        ]
+        var kept: [[UUID]] = []

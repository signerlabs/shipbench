+    @Test func twoMacsKeepSameCopyDespiteSubMillisecondDrift() async throws {
+        // 两台 Mac 各把同一段文字收进同一个 Pinboard，创建时间落在同一毫秒内。
+        // 本机那份是原值；对方那份经 iCloud 同步过来，丢了毫秒以下的精度（两份都只剩 .500）

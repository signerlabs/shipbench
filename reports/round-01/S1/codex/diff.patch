+    @Test func pinnedMergeConvergesAfterTimestampPrecisionLoss() async throws {
+        let a = UUID(uuidString: "AAAAAAAA-0000-0000-0000-000000000000")!
+        let b = UUID(uuidString: "BBBBBBBB-0000-0000-0000-000000000000")!
+        let boardID = UUID()
+        let second = Date(timeIntervalSince1970: 1_700_000_000)
+
+        // 两台 Mac 各有一份本机原值，另一份经同步丢了毫秒以下的精度。
+        // 直接比 Date 会让两台 Mac 都留下对方那份，互相同步删除后就一份不剩。
+        for localID in [a, b] {
+            let store = try await makeStore()
+            _ = try await store.createPinboard(id: boardID, name: "Work", color: .orange)
+            let remoteID = localID == a ? b : a
+            let localDate = second.addingTimeInterval(localID == a ? 0.123456 : 0.123654)
+            try await store.insertRemotePinned(id: localID, text: "shared snippet", pinboardID: boardID, createdAt: localDate)
+            try await store.insertRemotePinned(id: remoteID, text: "shared snippet", pinboardID: boardID, createdAt: second.addingTimeInterval(0.123))
+
+            #expect(try await store.mergeCloudChanges())
+            #expect(try await pinboard(store, boardID).map(\.id) == [a])
+            // 检查实际存储，避免只验证到缓存里的去重显示。
+            #expect(try await store.copies(of: a).count == 1)
+            #expect(try await store.copies(of: b).isEmpty)
+            #expect(try await store.mergeCloudChanges() == false)
+        }
+    }
+
+    @Test(arguments: [(0.123456, 0.123), (0.9, 0.1)])
+    func mergeOrderingIgnoresFractionalSeconds(later: TimeInterval, earlier: TimeInterval) {
+        let second = Date(timeIntervalSince1970: 1_700_000_000)
+        let boardA = PinboardRecord()
+        let boardB = PinboardRecord()
+        boardB.uuid = boardA.uuid
+        boardA.createdAt = second.addingTimeInterval(later)
+        boardB.createdAt = second.addingTimeInterval(earlier)
+        boardA.name = "Apple"
+        boardB.name = "Zebra"
+        #expect(CloudMerge.pinboardPrecedes(boardA, boardB))
+        #expect(!CloudMerge.pinboardPrecedes(boardB, boardA))
+
+        let a = PinnedClip()
+        let b = PinnedClip()
+        b.uuid = a.uuid
+        a.pinboardID = boardA.uuid
+        b.pinboardID = boardA.uuid
+        a.createdAt = boardA.createdAt
+        b.createdAt = boardB.createdAt
+        a.lastUsedAt = second.addingTimeInterval(60 + later)
+        b.lastUsedAt = second.addingTimeInterval(60 + earlier)
+        a.title = "Apple"
+        b.title = "Zebra"
+        // 同 uuid 时仍须忽略 createdAt、lastUsedAt 的小数部分，继续按标题比较。
+        #expect(CloudMerge.pinnedPrecedes(a, b))
+        #expect(!CloudMerge.pinnedPrecedes(b, a))
+        #expect(CloudMerge.pinnedPrecedes(PinnedValue(a), PinnedValue(b)))
+        #expect(!CloudMerge.pinnedPrecedes(PinnedValue(b), PinnedValue(a)))
+
+        // 剩余字段也相同就比不出先后，沿用不删除的保护规则。
+        boardB.name = boardA.name
+        b.title = a.title
+        #expect(!CloudMerge.pinboardPrecedes(boardA, boardB))
+        #expect(!CloudMerge.pinboardPrecedes(boardB, boardA))
+        #expect(!CloudMerge.pinnedPrecedes(a, b))
+        #expect(!CloudMerge.pinnedPrecedes(b, a))
+    }
+

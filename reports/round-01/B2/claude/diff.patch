@@ -0,0 +1,89 @@
+// Keyset-pagination cursors for the item list.
+//
+// A cursor records the sort key of the last row returned (not its id), so deleting that row
+// or any earlier row cannot shift later pages. It also pins the filter and the "today" that
+// the filter window was computed from, so a listing that spans local midnight stays consistent.
+
+import { isValidDate } from './dates.ts';
+import { base64UrlDecode, base64UrlEncode } from './crypto.ts';
+
+export type ItemFilter =
+  | { kind: 'all' }
+  | { kind: 'expiring'; days: number; today: string }
+  | { kind: 'expired'; today: string };
+
+export interface ItemCursor {
+  householdId: string;
+  filter: ItemFilter;
+  /** Creation sequence of the last row returned. */
+  seq: number;
+  /** expires_on of the last row returned (filtered listings only). */
+  expiresOn: string | null;
+}
+
+interface Wire {
+  v: 1;
+  h: string;
+  k: 'a' | 'e' | 'x';
+  s: number;
+  d?: string; // last expires_on
+  t?: string; // window anchor ("today")
+  n?: number; // expiring_within_days
+}
+
+const MAX_CURSOR_LENGTH = 512;
+
+export function encodeCursor(c: ItemCursor): string {
+  const wire: Wire = { v: 1, h: c.householdId, k: 'a', s: c.seq };
+  if (c.filter.kind === 'expiring') {
+    wire.k = 'e';
+    wire.n = c.filter.days;
+    wire.t = c.filter.today;
+    wire.d = c.expiresOn ?? undefined;
+  } else if (c.filter.kind === 'expired') {
+    wire.k = 'x';
+    wire.t = c.filter.today;
+    wire.d = c.expiresOn ?? undefined;
+  }
+  return base64UrlEncode(new TextEncoder().encode(JSON.stringify(wire)));
+}
+
+function exactKeys(o: Record<string, unknown>, keys: string[]): boolean {
+  const actual = Object.keys(o).sort();
+  const expected = [...keys].sort();
+  return actual.length === expected.length && actual.every((k, i) => k === expected[i]);
+}
+
+/** Returns null for anything this server did not produce. */
+export function decodeCursor(raw: string): ItemCursor | null {
+  if (raw.length === 0 || raw.length > MAX_CURSOR_LENGTH) return null;
+  const bytes = base64UrlDecode(raw);
+  if (!bytes) return null;
+  let o: unknown;
+  try {
+    o = JSON.parse(new TextDecoder('utf-8', { fatal: true, ignoreBOM: false }).decode(bytes));
+  } catch {
+    return null;
+  }
+  if (typeof o !== 'object' || o === null || Array.isArray(o)) return null;
+  const w = o as Record<string, unknown>;
+  if (w.v !== 1 || typeof w.h !== 'string' || w.h.length === 0) return null;
+  if (typeof w.s !== 'number' || !Number.isSafeInteger(w.s) || w.s < 1) return null;
+  const base = { householdId: w.h, seq: w.s };
+  switch (w.k) {
+    case 'a':
+      if (!exactKeys(w, ['v', 'h', 'k', 's'])) return null;
+      return { ...base, filter: { kind: 'all' }, expiresOn: null };
+    case 'e':
+      if (!exactKeys(w, ['v', 'h', 'k', 's', 'd', 't', 'n'])) return null;
+      if (!isValidDate(w.d) || !isValidDate(w.t)) return null;
+      if (typeof w.n !== 'number' || !Number.isInteger(w.n) || w.n < 0 || w.n > 365) return null;
+      return { ...base, filter: { kind: 'expiring', days: w.n, today: w.t }, expiresOn: w.d };
+    case 'x':
+      if (!exactKeys(w, ['v', 'h', 'k', 's', 'd', 't'])) return null;
+      if (!isValidDate(w.d) || !isValidDate(w.t)) return null;
+      return { ...base, filter: { kind: 'expired', today: w.t }, expiresOn: w.d };
+    default:
+      return null;
+  }
+}

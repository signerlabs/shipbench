+// Unit tests for the pure modules. Run with: npm run test:unit
+
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { decodeCursor, encodeCursor, type ItemCursor } from '../src/cursor.ts';
+import { base64UrlDecode, base64UrlEncode, hashPassword, verifyPassword } from '../src/crypto.ts';
+import { addDays, dateInTimeZone, dayNumber, diffDays, fromDayNumber, isValidDate, normalizeTimeZone } from '../src/dates.ts';
+import { normalizeEmail, parseIntParam, passwordLength } from '../src/validate.ts';
+
+describe('isValidDate', () => {
+  it('accepts real dates only, in strict YYYY-MM-DD form', () => {
+    for (const ok of ['2026-11-20', '2024-02-29', '2000-02-29', '0001-01-01', '9999-12-31', '2026-12-31']) {
+      assert.equal(isValidDate(ok), true, ok);
+    }
+    for (const bad of [
+      '2026-02-30',
+      '2026-2-3',
+      '2026-02-3',
+      '2023-02-29',
+      '1900-02-29',
+      '2026-04-31',
+      '2026-13-01',
+      '2026-00-10',
+      '2026-01-00',
+      '0000-01-01',
+      '20261120',
+      '2026/11/20',
+      '2026-11-20 ',
+      '2026-11-20T00:00',
+      '+2026-11-20',
+      '２０２６-11-20',
+      '',
+      null,
+      20261120,
+    ]) {
+      assert.equal(isValidDate(bad), false, String(bad));
+    }
+  });
+});
+
+describe('day arithmetic', () => {
+  it('matches Date.UTC for a wide range and round-trips', () => {
+    for (let n = dayNumber('1890-01-01'); n <= dayNumber('2110-12-31'); n += 7) {
+      const s = fromDayNumber(n);
+      assert.equal(Date.UTC(+s.slice(0, 4), +s.slice(5, 7) - 1, +s.slice(8, 10)) / 86_400_000, n);
+      assert.equal(dayNumber(s), n);
+    }
+    assert.equal(dayNumber('1970-01-01'), 0);
+    assert.equal(fromDayNumber(dayNumber('0001-01-01')), '0001-01-01');
+  });
+
+  it('adds and subtracts days across month, year and leap boundaries', () => {
+    assert.equal(addDays('2024-02-28', 1), '2024-02-29');
+    assert.equal(addDays('2023-02-28', 1), '2023-03-01');
+    assert.equal(addDays('2026-12-31', 1), '2027-01-01');
+    assert.equal(addDays('2026-11-20', 365), '2027-11-20');
+    assert.equal(addDays('2026-03-01', -1), '2026-02-28');
+    assert.equal(addDays('9999-12-30', 365), '9999-12-31');
+    assert.equal(diffDays('2026-11-20', '2026-11-17'), 3);
+    assert.equal(diffDays('2026-11-16', '2026-11-17'), -1);
+    assert.equal(diffDays('2025-01-01', '2024-01-01'), 366);
+  });
+});
+
+describe('dateInTimeZone', () => {
+  it('returns the local calendar date of an instant', () => {
+    const t = Date.UTC(2026, 10, 19, 16, 30); // 2026-11-19T16:30Z
+    assert.equal(dateInTimeZone(t, 'UTC'), '2026-11-19');
+    assert.equal(dateInTimeZone(t, 'Asia/Singapore'), '2026-11-20');
+    assert.equal(dateInTimeZone(t, 'America/New_York'), '2026-11-19');
+    assert.equal(dateInTimeZone(Date.UTC(2026, 10, 19, 10, 15), 'Pacific/Kiritimati'), '2026-11-20');
+    assert.equal(dateInTimeZone(Date.UTC(2026, 10, 19, 10, 15), 'Pacific/Pago_Pago'), '2026-11-18');
+    // half-hour and 45-minute offsets
+    assert.equal(dateInTimeZone(Date.UTC(2026, 10, 19, 18, 29), 'Asia/Kolkata'), '2026-11-19');
+    assert.equal(dateInTimeZone(Date.UTC(2026, 10, 19, 18, 30), 'Asia/Kolkata'), '2026-11-20');
+    assert.equal(dateInTimeZone(Date.UTC(2026, 10, 19, 10, 15), 'Asia/Kathmandu'), '2026-11-19');
+    assert.equal(dateInTimeZone(Date.UTC(2026, 10, 20, 10, 15), 'Pacific/Chatham'), '2026-11-21');
+  });
+
+  it('handles DST transitions', () => {
+    // US DST ends 2026-11-01 at 06:00Z. 05:30Z is 01:30 EDT; local midnight afterwards is 05:00Z (EST).
+    assert.equal(dateInTimeZone(Date.UTC(2026, 10, 1, 5, 30), 'America/New_York'), '2026-11-01');
+    assert.equal(dateInTimeZone(Date.UTC(2026, 10, 2, 4, 59), 'America/New_York'), '2026-11-01');
+    assert.equal(dateInTimeZone(Date.UTC(2026, 10, 2, 5, 0), 'America/New_York'), '2026-11-02');
+  });
+});
+
+describe('normalizeTimeZone', () => {
+  it('accepts IANA names and canonicalises case', () => {
+    assert.equal(normalizeTimeZone('Asia/Singapore'), 'Asia/Singapore');
+    assert.equal(normalizeTimeZone('asia/singapore'), 'Asia/Singapore');
+    assert.equal(normalizeTimeZone('UTC'), 'UTC');
+    assert.equal(normalizeTimeZone('America/Argentina/Buenos_Aires'), 'America/Argentina/Buenos_Aires');
+    assert.equal(normalizeTimeZone('Etc/GMT+5'), 'Etc/GMT+5');
+  });
+
+  it('rejects anything else', () => {
+    for (const bad of ['', 'Mars/Phobos', 'Asia/Singapur', '+08:00', '-05:00', 'UTC+8', 'Asia/', '/UTC', 'Asia Singapore', 8, null]) {
+      assert.equal(normalizeTimeZone(bad), null, String(bad));
+    }
+  });
+});
+
+describe('cursor', () => {
+  const cases: ItemCursor[] = [
+    { householdId: 'hh_1', filter: { kind: 'all' }, seq: 42, expiresOn: null },
+    { householdId: 'hh_1', filter: { kind: 'expiring', days: 3, today: '2026-11-08' }, seq: 7, expiresOn: '2026-11-09' },
+    { householdId: 'hh_1', filter: { kind: 'expired', today: '2026-11-08' }, seq: 1, expiresOn: '2026-01-01' },
+  ];
+
+  it('round-trips', () => {
+    for (const c of cases) {
+      const encoded = encodeCursor(c);
+      assert.match(encoded, /^[A-Za-z0-9_-]+$/);
+      assert.deepEqual(decodeCursor(encoded), c);
+    }
+  });
+
+  it('rejects anything it did not produce', () => {
+    const wire = (o: unknown) => Buffer.from(JSON.stringify(o)).toString('base64url');
+    for (const bad of [
+      '',
+      'garbage!',
+      'a',
+      wire(null),
+      wire([1]),
+      wire({ v: 2, h: 'hh_1', k: 'a', s: 1 }),
+      wire({ v: 1, h: 'hh_1', k: 'a', s: 0 }),
+      wire({ v: 1, h: 'hh_1', k: 'a', s: 1.5 }),
+      wire({ v: 1, h: 'hh_1', k: 'a', s: '1' }),
+      wire({ v: 1, h: 'hh_1', k: 'a', s: 1, extra: true }),
+      wire({ v: 1, h: 'hh_1', k: 'e', s: 1, d: '2026-02-30', t: '2026-11-08', n: 3 }),
+      wire({ v: 1, h: 'hh_1', k: 'e', s: 1, d: '2026-11-09', t: '2026-11-08', n: 366 }),
+      wire({ v: 1, h: 'hh_1', k: 'x', s: 1, t: '2026-11-08' }),
+      wire({ v: 1, h: 'hh_1', k: 'z', s: 1 }),
+      'x'.repeat(600),
+    ]) {
+      assert.equal(decodeCursor(bad), null, bad);
+    }
+  });
+});
+
+describe('encodings and passwords', () => {
+  it('base64url round-trips and rejects non-canonical input', () => {
+    const bytes = new Uint8Array([0, 1, 2, 250, 251, 252, 253, 254, 255]);
+    assert.deepEqual(base64UrlDecode(base64UrlEncode(bytes)), bytes);
+    assert.equal(base64UrlDecode('ab+/'), null);
+    assert.equal(base64UrlDecode('a'), null);
+    assert.equal(base64UrlDecode('QR'), null); // stray low bits; canonical form is "QQ"
+  });
+
+  it('hashes passwords with a random salt and verifies them', async () => {
+    const a = await hashPassword('correct horse');
+    const b = await hashPassword('correct horse');
+    assert.notEqual(a, b);
+    assert.ok(!a.includes('correct horse'));
+    assert.equal(await verifyPassword('correct horse', a), true);
+    assert.equal(await verifyPassword('correct horsf', a), false);
+    assert.equal(await verifyPassword('correct horse', 'garbage'), false);
+  });
+});
+
+describe('validation helpers', () => {
+  it('normalises emails', () => {
+    assert.equal(normalizeEmail(' A@Example.COM '), 'a@example.com');
+    for (const bad of ['no-at', '@example.com', 'a@', 'a b@example.com', '', 5]) assert.equal(normalizeEmail(bad), null);
+  });
+
+  it('counts password characters by code point', () => {
+    assert.equal(passwordLength('12345678'), 8);
+    assert.equal(passwordLength('😀😀😀😀'), 4);
+  });
+
+  it('parses strict integers', () => {
+    assert.equal(parseIntParam('20'), 20);
+    assert.equal(parseIntParam('0'), 0);
+    for (const bad of ['', '-1', '+1', '1.0', '1e2', ' 1', 'abc', '9999999999']) assert.equal(parseIntParam(bad), null, bad);
+  });
+});

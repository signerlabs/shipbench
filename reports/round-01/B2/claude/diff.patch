+
+async function listAll(user: TestUser, householdId: string, query: Record<string, string>, limit: number) {
+  const items: Json[] = [];
+  let cursor: string | null = null;
+  for (let page = 0; ; page++) {
+    assert.ok(page < 500, 'pagination does not terminate');
+    const q = new URLSearchParams({ ...query, limit: String(limit) });
+    if (cursor !== null) q.set('cursor', cursor);
+    const r = await api('GET', `/v1/households/${householdId}/items?${q}`, { token: user.token });
+    expectStatus(r, 200);
+    assert.ok(r.body.items.length <= limit);
+    items.push(...r.body.items);
+    cursor = r.body.next_cursor;
+    if (cursor === null) return items;
+    assert.equal(typeof cursor, 'string');
+  }
+}
+
+const names = (items: Json[]) => items.map((i) => i.name);

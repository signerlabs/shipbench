@@ -0,0 +1,17 @@
+// Small helpers around D1 results and errors.
+
+function message(e: unknown): string {
+  return e instanceof Error ? e.message : String(e);
+}
+
+export function isUniqueViolation(e: unknown): boolean {
+  return /UNIQUE constraint failed|SQLITE_CONSTRAINT_(PRIMARYKEY|UNIQUE)/.test(message(e));
+}
+
+export function isForeignKeyViolation(e: unknown): boolean {
+  return /FOREIGN KEY constraint failed|SQLITE_CONSTRAINT_FOREIGNKEY/.test(message(e));
+}
+
+export function changes(result: D1Result): number {
+  return result.meta.changes ?? 0;
+}
diff --git a/src/handlers/auth.ts b/src/handlers/auth.ts
new file mode 100644
index 0000000..9474e94
--- /dev/null
+++ b/src/handlers/auth.ts
@@ -0,0 +1,94 @@
+import { fakePasswordCheck, hashPassword, newId, newToken, sha256Hex, TOKEN_RE, verifyPassword } from '../crypto.ts';
+import { changes } from '../db.ts';
+import { badRequest, HttpError, json, readJsonObject } from '../http.ts';
+import type { AuthedContext, Env, RequestContext, User } from '../types.ts';
+import { normalizeEmail, passwordLength } from '../validate.ts';
+
+const SESSION_TTL_MS = 30 * 24 * 60 * 60 * 1000;
+const MIN_PASSWORD_LENGTH = 8;
+
+const unauthorized = (message = 'missing or invalid bearer token'): HttpError => new HttpError(401, message);
+
+/** Resolves the bearer token to a user, or throws 401. */
+export async function authenticate(request: Request, env: Env): Promise<User> {
+  const header = request.headers.get('authorization');
+  if (header === null) throw unauthorized();
+  const match = /^Bearer +(\S+) *$/i.exec(header);
+  const token = match?.[1];
+  if (token === undefined || !TOKEN_RE.test(token)) throw unauthorized();
+  const user = await env.DB.prepare(
+    `SELECT u.id, u.email FROM sessions s JOIN users u ON u.id = s.user_id
+      WHERE s.token_hash = ?1 AND s.expires_at_ms > ?2`,
+  )
+    .bind(await sha256Hex(token), Date.now())
+    .first<User>();
+  if (!user) throw unauthorized();
+  return user;
+}
+
+async function createSession(env: Env, userId: string): Promise<string> {
+  const token = newToken();
+  const now = Date.now();
+  await env.DB.prepare('INSERT INTO sessions (token_hash, user_id, created_at_ms, expires_at_ms) VALUES (?1, ?2, ?3, ?4)')
+    .bind(await sha256Hex(token), userId, now, now + SESSION_TTL_MS)
+    .run();
+  return token;
+}
+
+async function readCredentials(request: Request): Promise<{ email: string; password: string }> {
+  const body = await readJsonObject(request);
+  if (typeof body.email !== 'string') throw badRequest('email is required and must be a string');
+  if (typeof body.password !== 'string') throw badRequest('password is required and must be a string');
+  return { email: body.email, password: body.password };
+}
+
+export async function register({ request, env }: RequestContext): Promise<Response> {
+  const creds = await readCredentials(request);
+  const email = normalizeEmail(creds.email);
+  if (email === null) throw badRequest('email must be a valid address containing "@"');
+  const password = creds.password;
+  if (passwordLength(password) < MIN_PASSWORD_LENGTH) {
+    throw badRequest(`password must be at least ${MIN_PASSWORD_LENGTH} characters`);
+  }
+
+  // Cheap early exit; the UNIQUE constraint below is what actually guarantees one winner.
+  const existing = await env.DB.prepare('SELECT 1 FROM users WHERE email = ?1').bind(email).first();
+  if (existing) throw new HttpError(409, 'email is already registered');
+
+  const id = newId('usr');
+  const passwordHash = await hashPassword(password);
+  const result = await env.DB.prepare(
+    `INSERT INTO users (id, email, password_hash, created_at_ms) VALUES (?1, ?2, ?3, ?4)
+     ON CONFLICT (email) DO NOTHING`,
+  )
+    .bind(id, email, passwordHash, Date.now())
+    .run();
+  if (changes(result) !== 1) throw new HttpError(409, 'email is already registered');
+
+  const token = await createSession(env, id);
+  return json({ user: { id, email }, token }, 201);
+}
+
+export async function login({ request, env }: RequestContext): Promise<Response> {
+  const creds = await readCredentials(request);
+  const password = creds.password;
+  const email = normalizeEmail(creds.email);
+  const row =
+    email === null
+      ? null
+      : await env.DB.prepare('SELECT id, email, password_hash FROM users WHERE email = ?1')
+          .bind(email)
+          .first<{ id: string; email: string; password_hash: string }>();
+  if (!row) {
+    await fakePasswordCheck(password);
+    throw unauthorized('invalid email or password');
+  }
+  if (!(await verifyPassword(password, row.password_hash))) throw unauthorized('invalid email or password');
+
+  const token = await createSession(env, row.id);
+  return json({ user: { id: row.id, email: row.email }, token });
+}
+
+export async function me({ user }: AuthedContext): Promise<Response> {
+  return json({ id: user.id, email: user.email });
+}
diff --git a/src/handlers/households.ts b/src/handlers/households.ts
new file mode 100644
index 0000000..342e29c
--- /dev/null
+++ b/src/handlers/households.ts
@@ -0,0 +1,167 @@
+import { INVITE_CODE_RE, newId, newInviteCode } from '../crypto.ts';
+import { normalizeTimeZone } from '../dates.ts';
+import { changes, isUniqueViolation } from '../db.ts';
+import { badRequest, HttpError, json, noContent, notFound, readJsonObject } from '../http.ts';
+import type { AuthedContext, Env, Household } from '../types.ts';
+import { requiredName } from '../validate.ts';
+
+const INVITE_TTL_MS = 24 * 60 * 60 * 1000;
+
+/**
+ * The household as seen by `userId`. Throws 404 both when it does not exist and when the user
+ * is not a member, so callers cannot probe for other households.
+ */
+export async function loadHousehold(env: Env, householdId: string, userId: string): Promise<Household> {
+  const row = await env.DB.prepare(
+    `SELECT h.id, h.name, h.timezone, m.role FROM memberships m JOIN households h ON h.id = m.household_id
+      WHERE m.household_id = ?1 AND m.user_id = ?2`,
+  )
+    .bind(householdId, userId)
+    .first<Household>();
+  if (!row) throw notFound('household not found');
+  return row;
+}
+
+function view(h: Household): Household {
+  return { id: h.id, name: h.name, timezone: h.timezone, role: h.role };
+}
+
+export async function createHousehold({ request, env, user }: AuthedContext): Promise<Response> {
+  const body = await readJsonObject(request);
+  const name = requiredName(body, 'name');
+  const timezone = normalizeTimeZone(body.timezone);
+  if (timezone === null) throw badRequest('timezone must be a valid IANA time zone name, e.g. "Asia/Singapore"');
+
+  const id = newId('hh');
+  const now = Date.now();
+  await env.DB.batch([
+    env.DB.prepare('INSERT INTO households (id, name, timezone, created_at_ms) VALUES (?1, ?2, ?3, ?4)').bind(
+      id,
+      name,
+      timezone,
+      now,
+    ),
+    env.DB.prepare(
+      "INSERT INTO memberships (household_id, user_id, role, created_at_ms) VALUES (?1, ?2, 'owner', ?3)",
+    ).bind(id, user.id, now),
+  ]);
+  return json(view({ id, name, timezone, role: 'owner' }), 201);
+}
+
+export async function listHouseholds({ env, user }: AuthedContext): Promise<Response> {
+  const { results } = await env.DB.prepare(
+    `SELECT h.id, h.name, h.timezone, m.role FROM memberships m JOIN households h ON h.id = m.household_id
+      WHERE m.user_id = ?1 ORDER BY m.created_at_ms, h.created_at_ms, h.id`,
+  )
+    .bind(user.id)
+    .all<Household>();
+  return json({ households: results.map(view) });
+}
+
+export async function getHousehold({ env, user, params }: AuthedContext): Promise<Response> {
+  return json(view(await loadHousehold(env, params.household_id!, user.id)));
+}
+
+export async function createInvite({ env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  if (household.role !== 'owner') throw new HttpError(403, 'only the owner can create invites');
+
+  for (let attempt = 0; attempt < 5; attempt++) {
+    const code = newInviteCode();
+    const now = Date.now();
+    const expiresAt = now + INVITE_TTL_MS;
+    try {
+      await env.DB.prepare(
+        'INSERT INTO invites (code, household_id, created_by, created_at_ms, expires_at_ms) VALUES (?1, ?2, ?3, ?4, ?5)',
+      )
+        .bind(code, household.id, user.id, now, expiresAt)
+        .run();
+      return json({ code, expires_at_ms: expiresAt }, 201);
+    } catch (e) {
+      if (!isUniqueViolation(e)) throw e; // astronomically unlikely code collision: try another
+    }
+  }
+  throw new HttpError(503, 'could not allocate an invite code, try again');
+}
+
+interface InviteRow {
+  household_id: string;
+  used_by: string | null;
+  expires_at_ms: number;
+}
+
+export async function acceptInvite({ env, user, params }: AuthedContext): Promise<Response> {
+  const code = params.code!.toUpperCase();
+  if (!INVITE_CODE_RE.test(code)) throw notFound('invite not found');
+
+  // The claim and the membership insert run in one D1 batch (a single SQLite transaction).
+  // Only the request whose UPDATE flips used_by from NULL wins; its unique `claim` nonce gates
+  // the INSERT, so concurrent accepts of one code produce exactly one new member.
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const now = Date.now();
+    const claim = newId('clm');
+    const [claimed, , household] = await env.DB.batch([
+      env.DB.prepare(
+        `UPDATE invites SET used_by = ?1, used_at_ms = ?2, claim = ?3
+          WHERE code = ?4 AND used_by IS NULL AND expires_at_ms > ?2
+            AND NOT EXISTS (SELECT 1 FROM memberships m WHERE m.household_id = invites.household_id AND m.user_id = ?1)`,
+      ).bind(user.id, now, claim, code),
+      env.DB.prepare(
+        `INSERT INTO memberships (household_id, user_id, role, created_at_ms)
+         SELECT household_id, ?1, 'member', ?2 FROM invites WHERE code = ?3 AND claim = ?4`,
+      ).bind(user.id, now, code, claim),
+      env.DB.prepare(
+        `SELECT h.id, h.name, h.timezone FROM invites i JOIN households h ON h.id = i.household_id WHERE i.code = ?1`,
+      ).bind(code),
+    ]);
+    if (changes(claimed!) === 1) {
+      const h = household!.results[0] as Omit<Household, 'role'>;
+      return json({ household: view({ ...h, role: 'member' }) });
+    }
+
+    // Lost or not eligible: explain why, in the order 404 > 410 > 409.
+    const invite = await env.DB.prepare('SELECT household_id, used_by, expires_at_ms FROM invites WHERE code = ?1')
+      .bind(code)
+      .first<InviteRow>();
+    if (!invite) throw notFound('invite not found');
+    if (invite.used_by !== null) throw new HttpError(410, 'invite has already been used');
+    if (invite.expires_at_ms <= now) throw new HttpError(410, 'invite has expired');
+    const member = await env.DB.prepare('SELECT 1 FROM memberships WHERE household_id = ?1 AND user_id = ?2')
+      .bind(invite.household_id, user.id)
+      .first();
+    if (member) throw new HttpError(409, 'you are already a member of this household');
+    // State changed between the batch and the diagnosis (e.g. we were just removed); retry.
+  }
+  throw new HttpError(409, 'could not accept invite, try again');
+}
+
+export async function listMembers({ env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const { results } = await env.DB.prepare(
+    `SELECT m.user_id, u.email, m.role FROM memberships m JOIN users u ON u.id = m.user_id
+      WHERE m.household_id = ?1 ORDER BY m.role = 'owner' DESC, m.created_at_ms, m.user_id`,
+  )
+    .bind(household.id)
+    .all<{ user_id: string; email: string; role: string }>();
+  return json({ members: results.map((m) => ({ user_id: m.user_id, email: m.email, role: m.role })) });
+}
+
+export async function removeMember({ env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const targetId = params.user_id!;
+
+  if (targetId === user.id) {
+    if (household.role === 'owner') throw badRequest('the owner cannot leave the household');
+  } else if (household.role !== 'owner') {
+    throw new HttpError(403, 'only the owner can remove other members');
+  }
+
+  // role = 'member' makes it impossible to remove the owner by any path.
+  const result = await env.DB.prepare(
+    "DELETE FROM memberships WHERE household_id = ?1 AND user_id = ?2 AND role = 'member'",
+  )
+    .bind(household.id, targetId)
+    .run();
+  if (changes(result) === 0) throw notFound('member not found');
+  return noContent();
+}
diff --git a/src/handlers/items.ts b/src/handlers/items.ts
new file mode 100644
index 0000000..7e839bd
--- /dev/null
+++ b/src/handlers/items.ts
@@ -0,0 +1,233 @@
+import { newId } from '../crypto.ts';
+import { decodeCursor, encodeCursor, type ItemFilter } from '../cursor.ts';
+import { addDays, dateInTimeZone, diffDays } from '../dates.ts';
+import { changes, isForeignKeyViolation } from '../db.ts';
+import { badRequest, json, noContent, notFound, readJsonObject } from '../http.ts';
+import type { AuthedContext, Env, Household } from '../types.ts';
+import { has, optionalDate, optionalId, parseIntParam, quantity, requiredName } from '../validate.ts';
+import { loadHousehold } from './households.ts';
+
+interface ItemRow {
+  seq: number;
+  id: string;
+  name: string;
+  quantity: number;
+  location_id: string | null;
+  expires_on: string | null;
+}
+
+const ITEM_COLUMNS = 'seq, id, name, quantity, location_id, expires_on';
+
+function today(household: Household): string {
+  return dateInTimeZone(Date.now(), household.timezone);
+}
+
+function view(row: ItemRow, todayDate: string) {
+  return {
+    id: row.id,
+    name: row.name,
+    quantity: row.quantity,
+    location_id: row.location_id,
+    expires_on: row.expires_on,
+    days_left: row.expires_on === null ? null : diffDays(row.expires_on, todayDate),
+  };
+}
+
+const badLocation = () => badRequest('location_id does not refer to a location in this household');
+
+export async function createItem({ request, env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const body = await readJsonObject(request);
+  const name = requiredName(body, 'name');
+  const qty = body.quantity === undefined ? 1 : quantity(body, 'quantity');
+  const locationId = optionalId(body, 'location_id');
+  const expiresOn = optionalDate(body, 'expires_on');
+
+  const now = Date.now();
+  let row: ItemRow | null;
+  try {
+    // The location check lives in the INSERT itself, so it cannot race with a location delete.
+    row = await env.DB.prepare(
+      `INSERT INTO items (id, household_id, location_id, name, quantity, expires_on, created_at_ms, updated_at_ms)
+       SELECT ?1, ?2, ?3, ?4, ?5, ?6, ?7, ?7
+        WHERE ?3 IS NULL OR EXISTS (SELECT 1 FROM locations WHERE id = ?3 AND household_id = ?2)
+       RETURNING ${ITEM_COLUMNS}`,
+    )
+      .bind(newId('itm'), household.id, locationId, name, qty, expiresOn, now)
+      .first<ItemRow>();
+  } catch (e) {
+    if (!isForeignKeyViolation(e)) throw e;
+    row = null;
+  }
+  if (!row) throw badLocation();
+  return json(view(row, today(household)), 201);
+}
+
+async function loadItem(env: Env, householdId: string, itemId: string): Promise<ItemRow> {
+  const row = await env.DB.prepare(`SELECT ${ITEM_COLUMNS} FROM items WHERE id = ?1 AND household_id = ?2`)
+    .bind(itemId, householdId)
+    .first<ItemRow>();
+  if (!row) throw notFound('item not found');
+  return row;
+}
+
+export async function getItem({ env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const row = await loadItem(env, household.id, params.item_id!);
+  return json(view(row, today(household)));
+}
+
+export async function updateItem({ request, env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const itemId = params.item_id!;
+  const current = await loadItem(env, household.id, itemId);
+  const body = await readJsonObject(request);
+
+  const sets: string[] = [];
+  const values: unknown[] = [];
+  const set = (column: string, value: unknown) => {
+    values.push(value);
+    sets.push(`${column} = ?${values.length}`);
+  };
+  if (has(body, 'name')) set('name', requiredName(body, 'name'));
+  if (has(body, 'quantity')) set('quantity', quantity(body, 'quantity'));
+  if (has(body, 'expires_on')) set('expires_on', optionalDate(body, 'expires_on'));
+  let locationId: string | null = null;
+  if (has(body, 'location_id')) {
+    locationId = optionalId(body, 'location_id');
+    set('location_id', locationId);
+  }
+  if (sets.length === 0) return json(view(current, today(household)));
+
+  set('updated_at_ms', Date.now());
+  values.push(itemId, household.id);
+  const idParam = values.length - 1;
+  const householdParam = values.length;
+  let where = `id = ?${idParam} AND household_id = ?${householdParam}`;
+  if (locationId !== null) {
+    values.push(locationId);
+    where += ` AND EXISTS (SELECT 1 FROM locations WHERE id = ?${values.length} AND household_id = ?${householdParam})`;
+  }
+
+  let row: ItemRow | null;
+  try {
+    row = await env.DB.prepare(`UPDATE items SET ${sets.join(', ')} WHERE ${where} RETURNING ${ITEM_COLUMNS}`)
+      .bind(...values)
+      .first<ItemRow>();
+  } catch (e) {
+    if (!isForeignKeyViolation(e)) throw e;
+    throw badLocation();
+  }
+  if (!row) {
+    // Either the item vanished concurrently or the location is not ours.
+    await loadItem(env, household.id, itemId);
+    throw badLocation();
+  }
+  return json(view(row, today(household)));
+}
+
+export async function deleteItem({ env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const result = await env.DB.prepare('DELETE FROM items WHERE id = ?1 AND household_id = ?2')
+    .bind(params.item_id!, household.id)
+    .run();
+  if (changes(result) === 0) throw notFound('item not found');
+  return noContent();
+}
+
+const DEFAULT_LIMIT = 20;
+const MAX_LIMIT = 100;
+const MAX_WINDOW_DAYS = 365;
+
+/** Same filter, ignoring the "today" anchor. */
+function sameFilterShape(a: ItemFilter, b: ItemFilter): boolean {
+  if (a.kind === 'expiring' && b.kind === 'expiring') return a.days === b.days;
+  return a.kind === b.kind;
+}
+
+export async function listItems({ env, user, params, url }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const q = url.searchParams;
+  const todayDate = today(household);
+
+  let limit = DEFAULT_LIMIT;
+  const rawLimit = q.get('limit');
+  if (rawLimit !== null) {
+    const n = parseIntParam(rawLimit);
+    if (n === null || n < 1 || n > MAX_LIMIT) throw badRequest(`limit must be an integer between 1 and ${MAX_LIMIT}`);
+    limit = n;
+  }
+
+  let requested: ItemFilter | null = null;
+  const rawWithin = q.get('expiring_within_days');
+  if (rawWithin !== null) {
+    const n = parseIntParam(rawWithin);
+    if (n === null || n > MAX_WINDOW_DAYS) {
+      throw badRequest(`expiring_within_days must be an integer between 0 and ${MAX_WINDOW_DAYS}`);
+    }
+    requested = { kind: 'expiring', days: n, today: todayDate };
+  }
+  const rawExpired = q.get('expired');
+  if (rawExpired !== null) {
+    if (rawExpired !== 'true' && rawExpired !== 'false') throw badRequest('expired must be "true" or "false"');
+    if (rawExpired === 'true') {
+      if (requested !== null) throw badRequest('expired=true cannot be combined with expiring_within_days');
+      requested = { kind: 'expired', today: todayDate };
+    }
+  }
+
+  let filter: ItemFilter = requested ?? { kind: 'all' };
+  let after: { seq: number; expiresOn: string | null } | null = null;
+  const rawCursor = q.get('cursor');
+  if (rawCursor !== null) {
+    const cursor = decodeCursor(rawCursor);
+    if (cursor === null || cursor.householdId !== household.id) throw badRequest('cursor is not recognised');
+    // A cursor carries its own filter (and the "today" it was anchored to). If the caller repeats
+    // the filter parameters they must agree with it; if they omit them, the cursor's filter applies.
+    if (requested !== null && !sameFilterShape(requested, cursor.filter)) {
+      throw badRequest('cursor does not belong to this filter');
+    }
+    if (requested === null && rawExpired === 'false' && cursor.filter.kind !== 'all') {
+      throw badRequest('cursor does not belong to this filter');
+    }
+    filter = cursor.filter;
+    after = { seq: cursor.seq, expiresOn: cursor.expiresOn };
+  }
+
+  const where: string[] = ['household_id = ?1'];
+  const binds: unknown[] = [household.id];
+  const bind = (v: unknown) => {
+    binds.push(v);
+    return `?${binds.length}`;
+  };
+  let order: string;
+  if (filter.kind === 'all') {
+    order = 'seq';
+    if (after) where.push(`seq > ${bind(after.seq)}`);
+  } else {
+    order = 'expires_on, seq';
+    if (filter.kind === 'expiring') {
+      where.push(`expires_on >= ${bind(filter.today)}`, `expires_on <= ${bind(addDays(filter.today, filter.days))}`);
+    } else {
+      where.push(`expires_on < ${bind(filter.today)}`);
+    }
+    if (after) {
+      const e = bind(after.expiresOn);
+      where.push(`(expires_on > ${e} OR (expires_on = ${e} AND seq > ${bind(after.seq)}))`);
+    }
+  }
+
+  const { results } = await env.DB.prepare(
+    `SELECT ${ITEM_COLUMNS} FROM items WHERE ${where.join(' AND ')} ORDER BY ${order} LIMIT ${bind(limit + 1)}`,
+  )
+    .bind(...binds)
+    .all<ItemRow>();
+
+  const page = results.slice(0, limit);
+  const last = page[page.length - 1];
+  const nextCursor =
+    results.length > limit && last
+      ? encodeCursor({ householdId: household.id, filter, seq: last.seq, expiresOn: last.expires_on })
+      : null;
+  return json({ items: page.map((r) => view(r, todayDate)), next_cursor: nextCursor });
+}
diff --git a/src/handlers/locations.ts b/src/handlers/locations.ts
new file mode 100644
index 0000000..f3959e0
--- /dev/null
+++ b/src/handlers/locations.ts
@@ -0,0 +1,103 @@
+import { newId } from '../crypto.ts';
+import { changes, isForeignKeyViolation } from '../db.ts';
+import { badRequest, HttpError, json, noContent, notFound, readJsonObject } from '../http.ts';
+import type { AuthedContext } from '../types.ts';
+import { optionalId, requiredName } from '../validate.ts';
+import { loadHousehold } from './households.ts';
+
+const MAX_DEPTH = 3; // room > cabinet > shelf
+
+interface LocationRow {
+  id: string;
+  name: string;
+  parent_id: string | null;
+}
+
+interface LocationNode extends LocationRow {
+  children: LocationNode[];
+}
+
+export async function createLocation({ request, env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const body = await readJsonObject(request);
+  const name = requiredName(body, 'name');
+  const parentId = optionalId(body, 'parent_id');
+
+  let depth = 1;
+  if (parentId !== null) {
+    const parent = await env.DB.prepare('SELECT depth FROM locations WHERE id = ?1 AND household_id = ?2')
+      .bind(parentId, household.id)
+      .first<{ depth: number }>();
+    if (!parent) throw badRequest('parent_id does not refer to a location in this household');
+    if (parent.depth >= MAX_DEPTH) throw badRequest(`locations can be nested at most ${MAX_DEPTH} levels deep`);
+    depth = parent.depth + 1;
+  }
+
+  // Re-checks the parent inside the INSERT so a concurrent delete of the parent cannot leave an orphan.
+  const id = newId('loc');
+  let inserted: number;
+  try {
+    const result = await env.DB.prepare(
+      `INSERT INTO locations (id, household_id, parent_id, name, depth, created_at_ms)
+       SELECT ?1, ?2, ?3, ?4, ?5, ?6
+        WHERE ?3 IS NULL OR EXISTS (SELECT 1 FROM locations WHERE id = ?3 AND household_id = ?2 AND depth = ?5 - 1)`,
+    )
+      .bind(id, household.id, parentId, name, depth, Date.now())
+      .run();
+    inserted = changes(result);
+  } catch (e) {
+    if (!isForeignKeyViolation(e)) throw e;
+    inserted = 0;
+  }
+  if (inserted !== 1) throw badRequest('parent_id does not refer to a location in this household');
+  return json({ id, name, parent_id: parentId }, 201);
+}
+
+export async function listLocations({ env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const { results } = await env.DB.prepare(
+    'SELECT id, name, parent_id FROM locations WHERE household_id = ?1 ORDER BY depth, seq',
+  )
+    .bind(household.id)
+    .all<LocationRow>();
+
+  // Parents always sort before their children (ORDER BY depth), so one pass builds the tree.
+  const nodes = new Map<string, LocationNode>();
+  const roots: LocationNode[] = [];
+  for (const row of results) {
+    const node: LocationNode = { id: row.id, name: row.name, parent_id: row.parent_id, children: [] };
+    nodes.set(node.id, node);
+    const parent = row.parent_id === null ? undefined : nodes.get(row.parent_id);
+    if (parent) parent.children.push(node);
+    else roots.push(node);
+  }
+  return json({ locations: roots });
+}
+
+export async function deleteLocation({ env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const locationId = params.location_id!;
+
+  // Single statement: the emptiness check and the delete cannot be interleaved with an insert.
+  let deleted: number;
+  try {
+    const result = await env.DB.prepare(
+      `DELETE FROM locations WHERE id = ?1 AND household_id = ?2
+          AND NOT EXISTS (SELECT 1 FROM locations c WHERE c.parent_id = ?1)
+          AND NOT EXISTS (SELECT 1 FROM items i WHERE i.location_id = ?1)`,
+    )
+      .bind(locationId, household.id)
+      .run();
+    deleted = changes(result);
+  } catch (e) {
+    if (!isForeignKeyViolation(e)) throw e;
+    deleted = 0;
+  }
+  if (deleted === 1) return noContent();
+
+  const exists = await env.DB.prepare('SELECT 1 FROM locations WHERE id = ?1 AND household_id = ?2')
+    .bind(locationId, household.id)
+    .first();
+  if (!exists) throw notFound('location not found');
+  throw new HttpError(409, 'location still contains sub-locations or items');
+}

+// Request-field validation. Every failure is a 400.
+
+import { isValidDate } from './dates.ts';
+import { badRequest, type JsonObject } from './http.ts';
+
+export function has(body: JsonObject, key: string): boolean {
+  return Object.prototype.hasOwnProperty.call(body, key);
+}
+
+/** Required non-blank string; stored trimmed. */
+export function requiredName(body: JsonObject, key: string): string {
+  const value = body[key];
+  if (typeof value !== 'string') throw badRequest(`${key} must be a non-empty string`);
+  const trimmed = value.trim();
+  if (trimmed.length === 0) throw badRequest(`${key} must not be empty`);
+  return trimmed;
+}
+
+/** Absent or null -> null; otherwise must be a string. */
+export function optionalId(body: JsonObject, key: string): string | null {
+  const value = body[key];
+  if (value === undefined || value === null) return null;
+  if (typeof value !== 'string') throw badRequest(`${key} must be a string or null`);
+  return value;
+}
+
+export function quantity(body: JsonObject, key: string): number {
+  const value = body[key];
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0) {
+    throw badRequest(`${key} must be a non-negative integer`);
+  }
+  return value === 0 ? 0 : value; // normalise -0
+}
+
+/** Absent or null -> null; otherwise must be a real YYYY-MM-DD date. */
+export function optionalDate(body: JsonObject, key: string): string | null {
+  const value = body[key];
+  if (value === undefined || value === null) return null;
+  if (!isValidDate(value)) throw badRequest(`${key} must be a real date formatted YYYY-MM-DD, or null`);
+  return value;
+}
+
+export function normalizeEmail(value: unknown): string | null {
+  if (typeof value !== 'string') return null;
+  const email = value.trim().toLowerCase();
+  const at = email.lastIndexOf('@');
+  if (email.length > 254 || at <= 0 || at === email.length - 1 || /[\s\u0000-\u001f\u007f]/.test(email)) {
+    return null;
+  }
+  return email;
+}
+
+/** Password length in Unicode code points, so "8 characters" means what a user expects. */
+export function passwordLength(password: string): number {
+  return Array.from(password).length;
+}
+
+/** Strict decimal integer from a query string, or null if malformed. */
+export function parseIntParam(raw: string): number | null {
+  if (!/^\d{1,9}$/.test(raw)) return null;
+  return Number(raw);
+}

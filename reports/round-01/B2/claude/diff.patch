+import { json } from '../http.ts';
+import type { AuthedContext } from '../types.ts';
+import { loadHousehold } from './households.ts';
+
+export async function listReminders({ env, user, params }: AuthedContext): Promise<Response> {
+  const household = await loadHousehold(env, params.household_id!, user.id);
+  const { results } = await env.DB.prepare(
+    `SELECT r.id, r.item_id, i.name AS item_name, r.expires_on, r.remind_on
+       FROM reminders r JOIN items i ON i.id = r.item_id
+      WHERE r.household_id = ?1
+      ORDER BY r.remind_on, r.expires_on, i.seq`,
+  )
+    .bind(household.id)
+    .all<{ id: string; item_id: string; item_name: string; expires_on: string; remind_on: string }>();
+  return json({
+    reminders: results.map((r) => ({
+      id: r.id,
+      item_id: r.item_id,
+      item_name: r.item_name,
+      expires_on: r.expires_on,
+      remind_on: r.remind_on,
+    })),
+  });
+}
diff --git a/src/http.ts b/src/http.ts
new file mode 100644
index 0000000..51e3ea7
--- /dev/null
+++ b/src/http.ts
@@ -0,0 +1,83 @@
+// HTTP plumbing: errors, JSON responses, bounded body reading.
+
+export class HttpError extends Error {
+  readonly status: number;
+  constructor(status: number, message: string) {
+    super(message);
+    this.status = status;
+  }
+}
+
+export const badRequest = (message: string): HttpError => new HttpError(400, message);
+export const notFound = (message = 'not found'): HttpError => new HttpError(404, message);
+
+const JSON_HEADERS = {
+  'content-type': 'application/json; charset=utf-8',
+  'cache-control': 'no-store',
+};
+
+export function json(data: unknown, status = 200): Response {
+  return new Response(JSON.stringify(data), { status, headers: JSON_HEADERS });
+}
+
+export function noContent(): Response {
+  return new Response(null, { status: 204, headers: { 'cache-control': 'no-store' } });
+}
+
+export function errorResponse(status: number, message: string, headers?: Record<string, string>): Response {
+  return new Response(JSON.stringify({ error: message }), { status, headers: { ...JSON_HEADERS, ...headers } });
+}
+
+export const MAX_BODY_BYTES = 64 * 1024;
+
+/** Reads at most MAX_BODY_BYTES; anything larger is a 413 whether or not Content-Length was sent. */
+async function readBodyBytes(request: Request): Promise<Uint8Array> {
+  const declared = request.headers.get('content-length');
+  if (declared !== null && /^\d+$/.test(declared.trim()) && Number(declared.trim()) > MAX_BODY_BYTES) {
+    throw new HttpError(413, `request body must not exceed ${MAX_BODY_BYTES} bytes`);
+  }
+  if (request.body === null) return new Uint8Array(0);
+  const reader = request.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    total += value.byteLength;
+    if (total > MAX_BODY_BYTES) {
+      await reader.cancel().catch(() => {});
+      throw new HttpError(413, `request body must not exceed ${MAX_BODY_BYTES} bytes`);
+    }
+    chunks.push(value);
+  }
+  const bytes = new Uint8Array(total);
+  let offset = 0;
+  for (const c of chunks) {
+    bytes.set(c, offset);
+    offset += c.byteLength;
+  }
+  return bytes;
+}
+
+export type JsonObject = Record<string, unknown>;
+
+/** Parses the request body as a JSON object; 400 for anything else, 413 if too large. */
+export async function readJsonObject(request: Request): Promise<JsonObject> {
+  const bytes = await readBodyBytes(request);
+  let text: string;
+  try {
+    text = new TextDecoder('utf-8', { fatal: true, ignoreBOM: false }).decode(bytes);
+  } catch {
+    throw badRequest('request body is not valid UTF-8');
+  }
+  let value: unknown;
+  try {
+    value = JSON.parse(text);
+  } catch {
+    throw badRequest('request body is not valid JSON');
+  }
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw badRequest('request body must be a JSON object');
+  }
+  return value as JsonObject;
+}

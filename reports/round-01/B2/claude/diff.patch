index 0000000..1f2f83b
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,107 @@
+import { authenticate, login, me, register } from './handlers/auth.ts';
+import {
+  acceptInvite,
+  createHousehold,
+  createInvite,
+  getHousehold,
+  listHouseholds,
+  listMembers,
+  removeMember,
+} from './handlers/households.ts';
+import { createItem, deleteItem, getItem, listItems, updateItem } from './handlers/items.ts';
+import { createLocation, deleteLocation, listLocations } from './handlers/locations.ts';
+import { listReminders } from './handlers/reminders.ts';
+import { errorResponse, HttpError } from './http.ts';
+import { generateReminders } from './scheduled.ts';
+import type { AuthedContext, Env, RequestContext } from './types.ts';
+
+type PublicHandler = (ctx: RequestContext) => Promise<Response>;
+type AuthedHandler = (ctx: AuthedContext) => Promise<Response>;
+
+type Route =
+  | { method: string; pattern: string[]; auth: false; handler: PublicHandler }
+  | { method: string; pattern: string[]; auth: true; handler: AuthedHandler };
+
+const routes: Route[] = [];
+const pub = (method: string, path: string, handler: PublicHandler) =>
+  routes.push({ method, pattern: path.split('/').filter(Boolean), auth: false, handler });
+const authed = (method: string, path: string, handler: AuthedHandler) =>
+  routes.push({ method, pattern: path.split('/').filter(Boolean), auth: true, handler });
+
+pub('POST', '/v1/auth/register', register);
+pub('POST', '/v1/auth/login', login);
+authed('GET', '/v1/me', me);
+authed('POST', '/v1/households', createHousehold);
+authed('GET', '/v1/households', listHouseholds);
+authed('GET', '/v1/households/:household_id', getHousehold);
+authed('POST', '/v1/households/:household_id/invites', createInvite);
+authed('POST', '/v1/invites/:code/accept', acceptInvite);
+authed('GET', '/v1/households/:household_id/members', listMembers);
+authed('DELETE', '/v1/households/:household_id/members/:user_id', removeMember);
+authed('POST', '/v1/households/:household_id/locations', createLocation);
+authed('GET', '/v1/households/:household_id/locations', listLocations);
+authed('DELETE', '/v1/households/:household_id/locations/:location_id', deleteLocation);
+authed('POST', '/v1/households/:household_id/items', createItem);
+authed('GET', '/v1/households/:household_id/items', listItems);
+authed('GET', '/v1/households/:household_id/items/:item_id', getItem);
+authed('PATCH', '/v1/households/:household_id/items/:item_id', updateItem);
+authed('DELETE', '/v1/households/:household_id/items/:item_id', deleteItem);
+authed('GET', '/v1/households/:household_id/reminders', listReminders);
+
+function match(pattern: string[], segments: string[]): Record<string, string> | null {
+  if (pattern.length !== segments.length) return null;
+  const params: Record<string, string> = {};
+  for (let i = 0; i < pattern.length; i++) {
+    const p = pattern[i]!;
+    const s = segments[i]!;
+    if (p.startsWith(':')) params[p.slice(1)] = s;
+    else if (p !== s) return null;
+  }
+  return params;
+}
+
+async function route(request: Request, env: Env): Promise<Response> {
+  const url = new URL(request.url);
+  let segments: string[];
+  try {
+    segments = url.pathname.split('/').filter(Boolean).map(decodeURIComponent);
+  } catch {
+    throw new HttpError(404, 'not found');
+  }
+
+  const allowed: string[] = [];
+  for (const r of routes) {
+    const params = match(r.pattern, segments);
+    if (params === null) continue;
+    if (r.method !== request.method) {
+      allowed.push(r.method);
+      continue;
+    }
+    const ctx: RequestContext = { request, env, url, params };
+    if (!r.auth) return r.handler(ctx);
+    const user = await authenticate(request, env);
+    return r.handler({ ...ctx, user });
+  }
+  if (allowed.length > 0) {
+    return errorResponse(405, 'method not allowed', { allow: allowed.join(', ') });
+  }
+  throw new HttpError(404, 'not found');
+}
+
+export default {
+  async fetch(request, env): Promise<Response> {
+    try {
+      return await route(request, env);
+    } catch (e) {
+      if (e instanceof HttpError) return errorResponse(e.status, e.message);
+      console.error('unhandled error', request.method, new URL(request.url).pathname, e);
+      return errorResponse(500, 'internal server error');
+    }
+  },
+
+  async scheduled(event, env): Promise<void> {
+    // Awaited (not waitUntil) so the run is complete when the trigger returns.
+    const created = await generateReminders(env, event.scheduledTime);
+    console.log(`reminders: ${created} created for scheduledTime=${new Date(event.scheduledTime).toISOString()}`);
+  },
+} satisfies ExportedHandler<Env>;
diff --git a/src/scheduled.ts b/src/scheduled.ts
new file mode 100644
index 0000000..0475c0f
--- /dev/null
+++ b/src/scheduled.ts
@@ -0,0 +1,52 @@
+// Hourly reminder generation.
+
+import { addDays, dateInTimeZone } from './dates.ts';
+import type { Env } from './types.ts';
+
+export const REMINDER_WINDOW_DAYS = 3;
+const BATCH_SIZE = 50;
+
+/**
+ * For every household, creates one reminder per item whose expires_on lies in
+ * [today, today + 3], where "today" is the date of `scheduledTime` in the household's time zone.
+ *
+ * Idempotent: UNIQUE (item_id, remind_on) plus ON CONFLICT DO NOTHING means repeated or
+ * concurrent runs for the same local day never duplicate a reminder.
+ */
+export async function generateReminders(env: Env, scheduledTime: number): Promise<number> {
+  const { results: zones } = await env.DB.prepare('SELECT DISTINCT timezone FROM households').all<{
+    timezone: string;
+  }>();
+
+  const now = Date.now();
+  const statements: D1PreparedStatement[] = [];
+  for (const { timezone } of zones) {
+    let today: string;
+    try {
+      today = dateInTimeZone(scheduledTime, timezone);
+    } catch (e) {
+      console.error(`skipping households in unknown time zone ${timezone}`, e);
+      continue;
+    }
+    // One statement per distinct time zone covers every household in it.
+    statements.push(
+      env.DB.prepare(
+        `INSERT INTO reminders (id, household_id, item_id, remind_on, expires_on, created_at_ms)
+         SELECT 'rem_' || lower(hex(randomblob(12))), i.household_id, i.id, ?1, i.expires_on, ?2
+           FROM items i JOIN households h ON h.id = i.household_id
+          WHERE h.timezone = ?3 AND i.expires_on >= ?1 AND i.expires_on <= ?4
+         ON CONFLICT (item_id, remind_on) DO NOTHING`,
+      ).bind(today, now, timezone, addDays(today, REMINDER_WINDOW_DAYS)),
+    );
+  }
+
+  let created = 0;
+  for (let i = 0; i < statements.length; i += BATCH_SIZE) {
+    const results = await env.DB.batch(statements.slice(i, i + BATCH_SIZE));
+    for (const r of results) created += r.meta.changes ?? 0;
+  }
+
+  // Housekeeping: drop expired sessions (wall-clock based; unrelated to the reminder "today").
+  await env.DB.prepare('DELETE FROM sessions WHERE expires_at_ms <= ?1').bind(now).run();
+  return created;
+}

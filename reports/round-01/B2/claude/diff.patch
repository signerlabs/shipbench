@@ -0,0 +1,126 @@
+// Calendar-date and time-zone helpers. Pure functions, no Workers APIs, so they are
+// unit-testable under plain Node as well.
+
+const DATE_RE = /^(\d{4})-(\d{2})-(\d{2})$/;
+const MAX_DATE = '9999-12-31';
+const MIN_DATE = '0001-01-01';
+
+function isLeapYear(y: number): boolean {
+  return (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
+}
+
+function daysInMonth(y: number, m: number): number {
+  if (m === 2) return isLeapYear(y) ? 29 : 28;
+  return m === 4 || m === 6 || m === 9 || m === 11 ? 30 : 31;
+}
+
+function parts(s: string): [number, number, number] | null {
+  const match = DATE_RE.exec(s);
+  if (!match) return null;
+  const y = Number(match[1]);
+  const m = Number(match[2]);
+  const d = Number(match[3]);
+  if (y < 1 || m < 1 || m > 12 || d < 1 || d > daysInMonth(y, m)) return null;
+  return [y, m, d];
+}
+
+/** True for a real Gregorian calendar date written exactly as YYYY-MM-DD (years 0001-9999). */
+export function isValidDate(value: unknown): value is string {
+  return typeof value === 'string' && parts(value) !== null;
+}
+
+/** Days since 1970-01-01 (proleptic Gregorian). Howard Hinnant's days_from_civil. */
+export function dayNumber(date: string): number {
+  const p = parts(date);
+  if (!p) throw new RangeError(`invalid date: ${date}`);
+  let [y] = p;
+  const [, m, d] = p;
+  if (m <= 2) y -= 1;
+  const era = Math.floor(y / 400);
+  const yoe = y - era * 400;
+  const mp = (m + 9) % 12;
+  const doy = Math.floor((153 * mp + 2) / 5) + d - 1;
+  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy;
+  return era * 146097 + doe - 719468;
+}
+
+/** Inverse of dayNumber. */
+export function fromDayNumber(n: number): string {
+  const z = n + 719468;
+  const era = Math.floor(z / 146097);
+  const doe = z - era * 146097;
+  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365);
+  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100));
+  const mp = Math.floor((5 * doy + 2) / 153);
+  const d = doy - Math.floor((153 * mp + 2) / 5) + 1;
+  const m = mp < 10 ? mp + 3 : mp - 9;
+  const y = yoe + era * 400 + (m <= 2 ? 1 : 0);
+  return `${String(y).padStart(4, '0')}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
+}
+
+/** date + n days, clamped to the representable YYYY-MM-DD range. */
+export function addDays(date: string, n: number): string {
+  const result = dayNumber(date) + n;
+  if (result > dayNumber(MAX_DATE)) return MAX_DATE;
+  if (result < dayNumber(MIN_DATE)) return MIN_DATE;
+  return fromDayNumber(result);
+}
+
+/** a - b in whole days. */
+export function diffDays(a: string, b: string): number {
+  return dayNumber(a) - dayNumber(b);
+}
+
+const formatters = new Map<string, Intl.DateTimeFormat>();
+
+function formatterFor(timeZone: string): Intl.DateTimeFormat {
+  let f = formatters.get(timeZone);
+  if (!f) {
+    f = new Intl.DateTimeFormat('en-US', {
+      timeZone,
+      calendar: 'gregory',
+      numberingSystem: 'latn',
+      year: 'numeric',
+      month: '2-digit',
+      day: '2-digit',
+    });
+    formatters.set(timeZone, f);
+  }
+  return f;
+}
+
+/** The calendar date (YYYY-MM-DD) of instant `epochMs` as observed in `timeZone`. */
+export function dateInTimeZone(epochMs: number, timeZone: string): string {
+  let y = '';
+  let m = '';
+  let d = '';
+  for (const p of formatterFor(timeZone).formatToParts(new Date(epochMs))) {
+    if (p.type === 'year') y = p.value;
+    else if (p.type === 'month') m = p.value;
+    else if (p.type === 'day') d = p.value;
+  }
+  const date = `${y.padStart(4, '0')}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`;
+  if (!isValidDate(date)) throw new RangeError(`cannot represent instant ${epochMs} in ${timeZone}`);
+  return date;
+}
+
+// IANA names look like "UTC", "Asia/Singapore", "America/Argentina/Buenos_Aires", "Etc/GMT+8".
+// This excludes things Intl would also accept that are not IANA names, e.g. "+08:00".
+const TZ_NAME_RE = /^[A-Za-z][A-Za-z0-9_+-]*(?:\/[A-Za-z0-9_+-]+)*$/;
+
+/**
+ * Validates an IANA time zone name. Returns the name to store (with canonical casing when
+ * the input differs only by case), or null if it is not a time zone the runtime knows.
+ */
+export function normalizeTimeZone(value: unknown): string | null {
+  if (typeof value !== 'string' || value.length === 0 || value.length > 64 || !TZ_NAME_RE.test(value)) {
+    return null;
+  }
+  let resolved: string;
+  try {
+    resolved = new Intl.DateTimeFormat('en-US', { timeZone: value }).resolvedOptions().timeZone;
+  } catch {
+    return null;
+  }
+  return resolved.toLowerCase() === value.toLowerCase() ? resolved : value;
+}

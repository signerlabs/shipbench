+    await newItem(user, h.id, { name: 'plus3-second', expires_on: addDays(t, 3) });
+    await newItem(user, h.id, { name: 'far', expires_on: addDays(t, 300) });
+
+    const within3 = await listAll(user, h.id, { expiring_within_days: '3' }, 100);
+    assert.deepEqual(names(within3), ['today', 'tomorrow', 'plus3-first', 'plus3-second']);
+    assert.deepEqual(within3.map((i) => i.days_left), [0, 1, 3, 3]);
+
+    assert.deepEqual(names(await listAll(user, h.id, { expiring_within_days: '0' }, 100)), ['today']);
+    assert.deepEqual(names(await listAll(user, h.id, { expiring_within_days: '365' }, 2)), [
+      'today',
+      'tomorrow',
+      'plus3-first',
+      'plus3-second',
+      'plus4',
+      'far',
+    ]);
+
+    const expired = await listAll(user, h.id, { expired: 'true' }, 1);
+    assert.deepEqual(names(expired), ['two-days-ago', 'yesterday']);
+    assert.deepEqual(expired.map((i) => i.days_left), [-2, -1]);
+
+    assert.equal((await listAll(user, h.id, { expired: 'false' }, 100)).length, 9);
+    assert.deepEqual(names(await listAll(user, h.id, {}, 4)), [
+      'yesterday',
+      'tomorrow',
+      'today',
+      'plus3-first',
+      'no-expiry',
+      'plus4',
+      'two-days-ago',
+      'plus3-second',
+      'far',
+    ]);
+  });
+
+  it('keeps filtered paging correct while returned items are deleted', async () => {
+    const user = await newUser();
+    const tz = 'Europe/Berlin';
+    const h = await newHousehold(user, tz);
+    const t = todayIn(tz);
+    const made: Json[] = [];
+    for (let i = 0; i < 10; i++) made.push(await newItem(user, h.id, { name: `d${i % 3}-${i}`, expires_on: addDays(t, i % 3) }));
+    await newItem(user, h.id, { name: 'outside', expires_on: addDays(t, 9) });
+    // Expected order: by date (i % 3), then creation.
+    const expected = [...made].sort((a, b) => a.expires_on.localeCompare(b.expires_on)).map((i) => i.name);
+
+    const p = `/v1/households/${h.id}/items`;
+    const seen: string[] = [];
+    let cursor: string | null = null;
+    do {
+      const q = new URLSearchParams({ expiring_within_days: '2', limit: '3' });
+      if (cursor) q.set('cursor', cursor);
+      const r = await api('GET', `${p}?${q}`, { token: user.token });
+      expectStatus(r, 200);
+      seen.push(...names(r.body.items));
+      for (const item of r.body.items) expectStatus(await api('DELETE', `${p}/${item.id}`, { token: user.token }), 204);
+      cursor = r.body.next_cursor;
+    } while (cursor);
+    assert.deepEqual(seen, expected);
+  });
+
+  it('rejects a cursor used with a different filter or another household', async () => {
+    const user = await newUser();
+    const h = await newHousehold(user);
+    const h2 = await newHousehold(user);
+    for (let i = 0; i < 3; i++) await newItem(user, h.id, { name: `x${i}`, expires_on: todayIn(h.timezone) });
+    const r = await api('GET', `/v1/households/${h.id}/items?limit=1&expiring_within_days=5`, { token: user.token });
+    const cursor = encodeURIComponent(r.body.next_cursor);
+    expectError(await api('GET', `/v1/households/${h.id}/items?cursor=${cursor}&expired=true`, { token: user.token }), 400);
+    expectError(
+      await api('GET', `/v1/households/${h.id}/items?cursor=${cursor}&expiring_within_days=6`, { token: user.token }),
+      400,
+    );
+    expectError(await api('GET', `/v1/households/${h2.id}/items?cursor=${cursor}`, { token: user.token }), 400);
+    // Same filter repeated, or omitted (the cursor carries it), both continue the listing.
+    const same = await api('GET', `/v1/households/${h.id}/items?cursor=${cursor}&expiring_within_days=5&limit=5`, {
+      token: user.token,
+    });
+    assert.deepEqual(names(same.body.items), ['x1', 'x2']);
+    const omitted = await api('GET', `/v1/households/${h.id}/items?cursor=${cursor}&limit=5`, { token: user.token });
+    assert.deepEqual(names(omitted.body.items), ['x1', 'x2']);
+  });
+
+  it('lists concurrently created items exactly once', async () => {
+    const user = await newUser();
+    const h = await newHousehold(user);
+    const created = await Promise.all(Array.from({ length: 20 }, (_, i) => newItem(user, h.id, { name: `c${i}` })));
+    const listed = await listAll(user, h.id, {}, 6);
+    assert.deepEqual(listed.map((i) => i.id).sort(), created.map((i) => i.id).sort());
+  });
+});
+
+describe('reminders', () => {
+  // 2027-03-09T16:30Z is 2027-03-10 00:30 in Singapore (UTC+8) but still 03-09 in UTC.
+  const T0 = Date.UTC(2027, 2, 9, 16, 30);
+  const HOUR = 3_600_000;
+
+  async function reminders(user: TestUser, householdId: string): Promise<Json[]> {
+    const r = await api('GET', `/v1/households/${householdId}/reminders`, { token: user.token });
+    expectStatus(r, 200);
+    return r.body.reminders;
+  }
+  const summary = (rs: Json[]) => rs.map((r) => `${r.remind_on} ${r.item_name} ${r.expires_on}`);
+
+  it('creates one reminder per item per local day, using scheduledTime in the household zone', async () => {
+    const user = await newUser();
+    const outsider = await newUser();
+    const h = await newHousehold(user, 'Asia/Singapore');
+    await newItem(user, h.id, { name: 'expired', expires_on: '2027-03-09' });
+    const milk = await newItem(user, h.id, { name: 'milk', expires_on: '2027-03-10' });
+    await newItem(user, h.id, { name: 'bread', expires_on: '2027-03-13' });
+    await newItem(user, h.id, { name: 'cheese', expires_on: '2027-03-14' });
+    await newItem(user, h.id, { name: 'salt' });
+    await newItem(user, h.id, { name: 'eggs', expires_on: '2027-03-11' });
+
+    await triggerCron(T0);
+    let rs = await reminders(user, h.id);
+    assert.deepEqual(summary(rs), [
+      '2027-03-10 milk 2027-03-10',
+      '2027-03-10 eggs 2027-03-11',
+      '2027-03-10 bread 2027-03-13',
+    ]);
+    assert.deepEqual(Object.keys(rs[0]).sort(), ['expires_on', 'id', 'item_id', 'item_name', 'remind_on']);
+    assert.equal(rs[0].item_id, milk.id);
+
+    // Re-runs later the same local day, including several at once, add nothing.
+    await triggerCron(T0 + 5 * HOUR);
+    await Promise.all(Array.from({ length: 8 }, () => triggerCron(T0 + 10 * HOUR)));
+    rs = await reminders(user, h.id);
+    assert.equal(rs.length, 3);
+
+    // Next local day: a fresh reminder for whatever is still within range.
+    await triggerCron(T0 + 24 * HOUR);
+    rs = await reminders(user, h.id);
+    assert.deepEqual(summary(rs), [
+      '2027-03-10 milk 2027-03-10',
+      '2027-03-10 eggs 2027-03-11',
+      '2027-03-10 bread 2027-03-13',
+      '2027-03-11 eggs 2027-03-11',
+      '2027-03-11 bread 2027-03-13',
+      '2027-03-11 cheese 2027-03-14',
+    ]);
+    assert.equal(new Set(rs.map((r) => r.id)).size, 6);
+
+    expectError(await api('GET', `/v1/households/${h.id}/reminders`, { token: outsider.token }), 404);
+  });
+
+  it('computes "today" per household time zone', async () => {
+    const user = await newUser();
+    // At 2028-07-01T05:00Z it is 2028-07-01 in Tokyo but still 2028-06-30 in Los Angeles.
+    const at = Date.UTC(2028, 6, 1, 5, 0);
+    const tokyo = await newHousehold(user, 'Asia/Tokyo');
+    const la = await newHousehold(user, 'America/Los_Angeles');
+    for (const h of [tokyo, la]) {
+      await newItem(user, h.id, { name: 'jun30', expires_on: '2028-06-30' });
+      await newItem(user, h.id, { name: 'jul03', expires_on: '2028-07-03' });
+      await newItem(user, h.id, { name: 'jul04', expires_on: '2028-07-04' });
+    }
+    await triggerCron(at);
+    assert.deepEqual(summary(await reminders(user, tokyo.id)), ['2028-07-01 jul03 2028-07-03', '2028-07-01 jul04 2028-07-04']);
+    assert.deepEqual(summary(await reminders(user, la.id)), ['2028-06-30 jun30 2028-06-30', '2028-06-30 jul03 2028-07-03']);
+  });
+
+  it('follows renames and disappears with the item', async () => {
+    const user = await newUser();
+    const h = await newHousehold(user, 'UTC');
+    const item = await newItem(user, h.id, { name: 'yoghurt', expires_on: '2029-01-02' });
+    await triggerCron(Date.UTC(2029, 0, 1, 12));
+    const p = `/v1/households/${h.id}/items/${item.id}`;
+    expectStatus(await api('PATCH', p, { token: user.token, body: { name: 'greek yoghurt' } }), 200);
+    assert.deepEqual(summary(await reminders(user, h.id)), ['2029-01-01 greek yoghurt 2029-01-02']);
+    expectStatus(await api('DELETE', p, { token: user.token }), 204);
+    assert.deepEqual(await reminders(user, h.id), []);
+  });
+});
diff --git a/test/server.ts b/test/server.ts
new file mode 100644
index 0000000..06faf0b
--- /dev/null
+++ b/test/server.ts
@@ -0,0 +1,90 @@
+// Boots a real `wrangler dev --local` against a throw-away D1 database, the same way the
+// service is run for acceptance, and exposes small helpers for HTTP calls and direct SQL.
+
+import { spawn, execFile, type ChildProcess } from 'node:child_process';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { createServer } from 'node:net';
+import { join, resolve } from 'node:path';
+import { promisify } from 'node:util';
+
+const execFileAsync = promisify(execFile);
+const ROOT = resolve(import.meta.dirname, '..');
+const WRANGLER = join(ROOT, 'node_modules', '.bin', 'wrangler');
+
+async function freePort(): Promise<number> {
+  return new Promise((ok, fail) => {
+    const srv = createServer();
+    srv.once('error', fail);
+    srv.listen(0, '127.0.0.1', () => {
+      const addr = srv.address();
+      srv.close(() => (typeof addr === 'object' && addr ? ok(addr.port) : fail(new Error('no port'))));
+    });
+  });
+}
+
+export interface TestServer {
+  base: string;
+  /** Runs SQL directly against the local D1 database (for test setup such as expiring an invite). */
+  sql(command: string): Promise<Record<string, unknown>[]>;
+  stop(): Promise<void>;
+}
+
+export async function startServer(): Promise<TestServer> {
+  const stateDir = mkdtempSync(join(ROOT, '.test-state-'));
+  const env = { ...process.env, WRANGLER_SEND_METRICS: 'false', CI: '1', NO_COLOR: '1' };
+
+  await execFileAsync(WRANGLER, ['d1', 'migrations', 'apply', 'DB', '--local', '--persist-to', stateDir], {
+    cwd: ROOT,
+    env,
+  });
+
+  const port = await freePort();
+  const child: ChildProcess = spawn(
+    WRANGLER,
+    ['dev', '--local', '--ip', '127.0.0.1', '--port', String(port), '--persist-to', stateDir, '--inspector-port', '0'],
+    { cwd: ROOT, env, stdio: ['ignore', 'pipe', 'pipe'] },
+  );
+  let log = '';
+  child.stdout?.on('data', (d) => (log += d));
+  child.stderr?.on('data', (d) => (log += d));
+
+  const base = `http://127.0.0.1:${port}`;
+  const deadline = Date.now() + 60_000;
+  for (;;) {
+    if (child.exitCode !== null) throw new Error(`wrangler dev exited early:\n${log}`);
+    try {
+      const res = await fetch(`${base}/v1/me`);
+      await res.body?.cancel();
+      if (res.status === 401) break;
+    } catch {
+      // not listening yet
+    }
+    if (Date.now() > deadline) {
+      child.kill('SIGTERM');
+      throw new Error(`wrangler dev did not become ready:\n${log}`);
+    }
+    await new Promise((r) => setTimeout(r, 250));
+  }
+
+  return {
+    base,
+    async sql(command) {
+      const { stdout } = await execFileAsync(
+        WRANGLER,
+        ['d1', 'execute', 'DB', '--local', '--persist-to', stateDir, '--json', '--command', command],
+        { cwd: ROOT, env },
+      );
+      const parsed = JSON.parse(stdout) as { results: Record<string, unknown>[] }[];
+      return parsed.flatMap((r) => r.results);
+    },
+    async stop() {
+      if (child.exitCode === null) {
+        const exited = new Promise((r) => child.once('exit', r));
+        child.kill('SIGTERM');
+        await Promise.race([exited, new Promise((r) => setTimeout(r, 5000))]);
+        if (child.exitCode === null) child.kill('SIGKILL');
+      }
+      rmSync(stateDir, { recursive: true, force: true });
+    },
+  };
+}

+-- Household items & expiry reminders: initial schema.
+-- All timestamps are Unix epoch milliseconds; all calendar dates are 'YYYY-MM-DD' text
+-- (lexicographic order == chronological order for 4-digit years).
+
+CREATE TABLE users (
+  id            TEXT    PRIMARY KEY,
+  email         TEXT    NOT NULL UNIQUE,          -- always stored lower-case
+  password_hash TEXT    NOT NULL,                 -- pbkdf2_sha256$iterations$salt$hash
+  created_at_ms INTEGER NOT NULL
+);
+
+-- Opaque bearer tokens; only the SHA-256 of the token is stored.
+CREATE TABLE sessions (
+  token_hash    TEXT    PRIMARY KEY,
+  user_id       TEXT    NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  created_at_ms INTEGER NOT NULL,
+  expires_at_ms INTEGER NOT NULL
+);
+CREATE INDEX sessions_user ON sessions(user_id);
+
+CREATE TABLE households (
+  id            TEXT    PRIMARY KEY,
+  name          TEXT    NOT NULL,
+  timezone      TEXT    NOT NULL,                    -- IANA time zone name
+  created_at_ms INTEGER NOT NULL
+);
+CREATE INDEX households_timezone ON households(timezone);
+
+CREATE TABLE memberships (
+  household_id  TEXT    NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  user_id       TEXT    NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  role          TEXT    NOT NULL CHECK (role IN ('owner', 'member')),
+  created_at_ms INTEGER NOT NULL,
+  PRIMARY KEY (household_id, user_id)
+);
+CREATE INDEX memberships_user ON memberships(user_id);
+
+CREATE TABLE invites (
+  code          TEXT    PRIMARY KEY,
+  household_id  TEXT    NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  created_by    TEXT    NOT NULL REFERENCES users(id),
+  created_at_ms INTEGER NOT NULL,
+  expires_at_ms INTEGER NOT NULL,
+  used_by       TEXT    REFERENCES users(id),
+  used_at_ms    INTEGER,
+  claim         TEXT                                -- per-request nonce set by the winning accept
+);
+CREATE INDEX invites_household ON invites(household_id);
+
+CREATE TABLE locations (
+  seq           INTEGER PRIMARY KEY AUTOINCREMENT,  -- creation order
+  id            TEXT    NOT NULL UNIQUE,
+  household_id  TEXT    NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  parent_id     TEXT    REFERENCES locations(id),
+  name          TEXT    NOT NULL,
+  depth         INTEGER NOT NULL CHECK (depth BETWEEN 1 AND 3),
+  created_at_ms INTEGER NOT NULL
+);
+CREATE INDEX locations_household ON locations(household_id, seq);
+CREATE INDEX locations_parent ON locations(parent_id);
+
+CREATE TABLE items (
+  seq           INTEGER PRIMARY KEY AUTOINCREMENT,  -- creation order, never reused; pagination key
+  id            TEXT    NOT NULL UNIQUE,
+  household_id  TEXT    NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  location_id   TEXT    REFERENCES locations(id),
+  name          TEXT    NOT NULL,
+  quantity      INTEGER NOT NULL CHECK (quantity >= 0),
+  expires_on    TEXT,
+  created_at_ms INTEGER NOT NULL,
+  updated_at_ms INTEGER NOT NULL
+);
+CREATE INDEX items_household_seq ON items(household_id, seq);
+CREATE INDEX items_household_expiry ON items(household_id, expires_on, seq);
+CREATE INDEX items_location ON items(location_id);
+
+CREATE TABLE reminders (
+  id            TEXT    PRIMARY KEY,
+  household_id  TEXT    NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  item_id       TEXT    NOT NULL REFERENCES items(id) ON DELETE CASCADE,
+  remind_on     TEXT    NOT NULL,
+  expires_on    TEXT    NOT NULL,                   -- the expiry date that triggered the reminder
+  created_at_ms INTEGER NOT NULL,
+  UNIQUE (item_id, remind_on)
+);
+CREATE INDEX reminders_household ON reminders(household_id, remind_on, expires_on);

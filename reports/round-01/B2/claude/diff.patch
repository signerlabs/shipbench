+// End-to-end tests against a real `wrangler dev --local` + local D1.
+// Run with: npm run test:api
+
+import assert from 'node:assert/strict';
+import { after, before, describe, it } from 'node:test';
+import { startServer, type TestServer } from './server.ts';
+
+let server: TestServer;
+before(async () => {
+  server = await startServer();
+});
+after(async () => {
+  await server?.stop();
+});
+
+// ---------------------------------------------------------------------------------------------
+// helpers (deliberately independent of src/ so the service is checked against the spec)
+
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+type Json = any;
+interface Res {
+  status: number;
+  body: Json;
+  headers: Headers;
+}
+
+interface CallOptions {
+  token?: string;
+  body?: unknown;
+  raw?: BodyInit;
+  headers?: Record<string, string>;
+}
+
+async function api(method: string, path: string, opts: CallOptions = {}): Promise<Res> {
+  const headers: Record<string, string> = { ...opts.headers };
+  if (opts.token !== undefined) headers.authorization = `Bearer ${opts.token}`;
+  let body: BodyInit | undefined;
+  if (opts.raw !== undefined) body = opts.raw;
+  else if (opts.body !== undefined) {
+    body = JSON.stringify(opts.body);
+    headers['content-type'] = 'application/json';
+  }
+  const init: RequestInit & { duplex?: 'half' } = { method, headers, body };
+  if (body instanceof ReadableStream) init.duplex = 'half';
+  const res = await fetch(server.base + path, init);
+  const text = await res.text();
+  let parsed: Json = null;
+  if (text.length > 0) {
+    try {
+      parsed = JSON.parse(text);
+    } catch {
+      parsed = text;
+    }
+  }
+  return { status: res.status, body: parsed, headers: res.headers };
+}
+
+function expectError(res: Res, status: number): void {
+  assert.equal(res.status, status, `expected ${status}, got ${res.status}: ${JSON.stringify(res.body)}`);
+  assert.equal(typeof res.body?.error, 'string', `error body should be {"error": "..."}: ${JSON.stringify(res.body)}`);
+}
+
+function expectStatus(res: Res, status: number): void {
+  assert.equal(res.status, status, `expected ${status}, got ${res.status}: ${JSON.stringify(res.body)}`);
+}
+
+let seq = 0;
+const uniqueEmail = () => `u${Date.now().toString(36)}${(seq++).toString(36)}${Math.random().toString(36).slice(2, 6)}@example.com`;
+const PASSWORD = 'correct horse';
+
+interface TestUser {
+  id: string;
+  email: string;
+  token: string;
+}
+
+async function newUser(): Promise<TestUser> {
+  const email = uniqueEmail();
+  const r = await api('POST', '/v1/auth/register', { body: { email, password: PASSWORD } });
+  expectStatus(r, 201);
+  return { id: r.body.user.id, email, token: r.body.token };
+}
+
+async function newHousehold(user: TestUser, timezone = 'Asia/Singapore', name = '我家'): Promise<Json> {
+  const r = await api('POST', '/v1/households', { token: user.token, body: { name, timezone } });
+  expectStatus(r, 201);
+  return r.body;
+}
+
+async function invite(owner: TestUser, householdId: string): Promise<string> {
+  const r = await api('POST', `/v1/households/${householdId}/invites`, { token: owner.token });
+  expectStatus(r, 201);
+  return r.body.code;
+}
+
+async function join(owner: TestUser, householdId: string, user: TestUser): Promise<void> {
+  const code = await invite(owner, householdId);
+  expectStatus(await api('POST', `/v1/invites/${code}/accept`, { token: user.token }), 200);
+}
+
+async function newItem(user: TestUser, householdId: string, body: Record<string, unknown>): Promise<Json> {
+  const r = await api('POST', `/v1/households/${householdId}/items`, { token: user.token, body });
+  expectStatus(r, 201);
+  return r.body;
+}
+
+async function newLocation(user: TestUser, householdId: string, name: string, parentId: string | null = null) {
+  const r = await api('POST', `/v1/households/${householdId}/locations`, {
+    token: user.token,
+    body: { name, parent_id: parentId },
+  });
+  expectStatus(r, 201);
+  return r.body as { id: string; name: string; parent_id: string | null };

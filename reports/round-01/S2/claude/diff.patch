+    /// 翻页途中删掉或取用了上一页的最后一条（游标指向的那条）：下一页仍从游标处接着往下，
+    /// 不从第一条重新开始（删掉后索引里找不到它），也不和已显示的重复（取用后它跳到最前、索引里的位置变了）。
+    /// "note" 走 trigram 索引，"ot" 走 1–2 个字符的扫描
+    @Test(arguments: ["note", "ot"])
+    func searchPagingContinuesAfterCursorItemChanges(needle: String) async throws {
+        let (repository, _) = makeRepository()
+        for index in 1...8 { _ = try await repository.ingest(text("note \(index)")) }
+        let query = ClipQuery(scope: .history, searchText: needle)
+
+        let first = try await repository.page(query, after: nil, limit: 2)
+        #expect(first.items.map(\.preview) == ["note 8", "note 7"])
+        // 搜索结果里删除 = 两边都删
+        _ = try await repository.remove(first.items[1].id, from: .everywhere)
+        let second = try await repository.page(query, after: first.nextCursor, limit: 2)
+        #expect(second.items.map(\.preview) == ["note 6", "note 5"])
+
+        // 粘贴：取用后跳到最前
+        _ = try await repository.markUsed(second.items[1].id)
+        let third = try await repository.page(query, after: second.nextCursor, limit: 2)
+        #expect(third.items.map(\.preview) == ["note 4", "note 3"])
+
+        // 又复制了一次同样的内容：同样跳到最前
+        _ = try await repository.ingest(text("note 3"))
+        let fourth = try await repository.page(query, after: third.nextCursor, limit: 2)
+        #expect(fourth.items.map(\.preview) == ["note 2", "note 1"])
+        #expect(fourth.nextCursor == nil)
+
+        // 从头再搜：删掉的不在，取用过的排在最前
+        let all = try await repository.page(query, after: nil, limit: 100)
+        #expect(all.items.map(\.preview) == ["note 3", "note 5", "note 8", "note 6", "note 4", "note 2", "note 1"])
+    }
+

+    /// 两台 Mac 各建了几个 Pinboard：各自的排序键都是 0、1、2…，同步合并后两两相同
+    private func makeStoreWithPinboardsFromTwoMacs() async throws -> ClipStore {
+        let store = try await makeStore()
+        // 这台 Mac 建的（uuid 故意比另一台的大：排序键相同时按 uuid，另一台的排在前面）
+        for (index, name) in ["A", "B", "C"].enumerated() {
+            _ = try await store.createPinboard(id: UUID(uuidString: "F000000\(index)-0000-0000-0000-000000000000")!, name: name, color: .red)
+        }
+        // 另一台 Mac 建的，同步过来
+        for (index, name) in ["D", "E", "F"].enumerated() {
+            try await store.insertRemotePinboard(
+                id: UUID(uuidString: "0000000\(index)-0000-0000-0000-000000000000")!, name: name,
+                createdAt: .now.addingTimeInterval(-3600), isExample: false, sortKey: Double(index)
+            )
+        }
+        _ = try await store.mergeCloudChanges()
+        return store
+    }
+
+    @Test func pinboardsFromTwoMacsSortByUUIDWhenKeysTie() async throws {
+        let store = try await makeStoreWithPinboardsFromTwoMacs()
+        // 排序键相同按 uuid 定先后：各台 Mac 排出同一个顺序（与库里的行序无关）
+        #expect(try await store.pinboards().map(\.name) == ["D", "A", "E", "B", "F", "C"])
+    }
+
+    /// 按界面上的顺序挪一个（与 movePinboard 同样的规则：挪过头就停在两头），返回挪完应有的顺序
+    private func moved(_ order: [String], _ name: String, by offset: Int) throws -> [String] {
+        var order = order
+        let index = try #require(order.firstIndex(of: name))
+        order.remove(at: index)
+        order.insert(name, at: min(max(index + offset, 0), order.count))
+        return order
+    }
+
+    private func movePinboard(_ store: ClipStore, named name: String, by offset: Int) async throws {
+        let id = try #require(try await store.pinboards().first { $0.name == name }?.id)
+        try await store.movePinboard(id, by: offset)
+    }
+
+    /// 合并后拖动任意一个到任意位置：松手后停在新位置，不弹回原处（落点两边的排序键常常相同，取中点等于没挪）
+    @Test(arguments: ["A", "B", "C", "D", "E", "F"], [-5, -4, -3, -2, -1, 1, 2, 3, 4, 5])
+    func pinboardFromTwoMacsStaysWhereDropped(name: String, offset: Int) async throws {
+        let store = try await makeStoreWithPinboardsFromTwoMacs()
+        let expected = try moved(try await store.pinboards().map(\.name), name, by: offset)
+        try await movePinboard(store, named: name, by: offset)
+        #expect(try await store.pinboards().map(\.name) == expected)
+        // 写进了库：重新合并、装缓存后还是这样
+        _ = try await store.mergeCloudChanges()
+        #expect(try await store.pinboards().map(\.name) == expected)
+    }
+
+    @Test func pinboardsFromTwoMacsCanBeReorderedRepeatedly() async throws {
+        let store = try await makeStoreWithPinboardsFromTwoMacs()
+        var expected = try await store.pinboards().map(\.name)

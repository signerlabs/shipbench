+import Foundation
+import SQLite3
+import Testing
+@testable import ClipData
+
+@Suite struct SearchIndexTests {
+    @Test(arguments: [0, 1])
+    func legacyOrderingIsUpgradedWithoutLosingRows(version: Int) throws {
+        let directory = FileManager.default.temporaryDirectory.appending(path: "ClipIndexTests-\(UUID())")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+        let url = directory.appending(path: "Search.sqlite")
+        let older = UUID()
+        let newer = UUID()
+        // 真正的旧表结构：rank 既是毫秒时间也是 FTS 行号，没有完整时间列。
+        do {
+            var db: OpaquePointer?
+            try #require(sqlite3_open(url.path(percentEncoded: false), &db) == SQLITE_OK)
+            defer { sqlite3_close_v2(db) }
+            let sql = """
+                CREATE VIRTUAL TABLE clip_search USING fts5(uuid UNINDEXED, body, tokenize='trigram');
+                CREATE TABLE clip_rank(uuid TEXT PRIMARY KEY, rank INTEGER NOT NULL);
+                INSERT INTO clip_search(rowid, uuid, body) VALUES
+                    (1700000000000, '\(older.uuidString)', 'legacy older'),
+                    (1700000001000, '\(newer.uuidString)', 'legacy newer');
+                INSERT INTO clip_rank(uuid, rank) VALUES
+                    ('\(older.uuidString)', 1700000000000),
+                    ('\(newer.uuidString)', 1700000001000);
+                PRAGMA user_version = \(version);
+                """
+            try #require(sqlite3_exec(db, sql, nil, nil, nil) == SQLITE_OK)
+        }
+        do {
+            let index = try SearchIndex.open(url: url)
+            #expect(!index.wasReset)
+            #expect(index.needsRepair)
+            #expect(try index.count() == 2)
+            #expect(try index.search("legacy", after: nil, limit: 10) == [newer, older])
+        }
+        let timestamp = Date(timeIntervalSinceReferenceDate: 800_000_000.0001)
+        do {
+            let index = try SearchIndex.open(url: url)
+            #expect(index.needsRepair)
+            // 后台修补写回真实时间，旧行号不再影响排序。
+            try index.apply([
+                (older, .init(lastUsedAt: timestamp, body: "legacy older")),
+                (newer, .init(lastUsedAt: timestamp.addingTimeInterval(0.0001), body: "legacy newer")),
+            ])
+            try index.setNeedsRepair(false)
+        }
+        let index = try SearchIndex.open(url: url)
+        #expect(!index.wasReset)
+        #expect(!index.needsRepair)
+        let cursor = ClipCursor(lastUsedAt: timestamp.addingTimeInterval(0.0001), id: newer)
+        try index.apply([(newer, nil)])
+        #expect(try index.search("legacy", after: cursor, limit: 10) == [older])
+        #expect(try index.search("le", after: cursor, limit: 10) == [older])
+    }
+}

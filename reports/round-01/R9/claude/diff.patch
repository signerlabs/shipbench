diff --git a/Sprout/Models/Expense.swift b/Sprout/Models/Expense.swift
index c94a548..00db9b8 100644
--- a/Sprout/Models/Expense.swift
+++ b/Sprout/Models/Expense.swift
@@ -10,3 +10,46 @@ struct Expense: Identifiable, Hashable, Codable {
     var date: String
     var note: String
 }
+
+extension Expense {
+    /// Amounts above this (in the user's currency) are flagged as large.
+    static let largeAmountThreshold: Decimal = 50
+
+    var isLarge: Bool { amount > Self.largeAmountThreshold }
+
+    /// `date` as noon of that day in the user's time zone, or nil if the server sent something that isn't a real date.
+    var day: Date? { ExpenseDay.date(from: date) }
+}
+
+/// Converts between the server's plain calendar dates ("2026-11-20": ISO 8601, Gregorian, no time, no time zone) and `Date`.
+///
+/// A day is anchored at **noon in the user's current time zone**. Parsing it as UTC midnight and then showing it in
+/// local time would put US users on the previous day; noon leaves ±12 hours of slack either way.
+enum ExpenseDay {
+    /// "2026-11-20" → noon on that day in `timeZone`. Nil unless `string` is exactly a valid yyyy-MM-dd date.
+    static func date(from string: String, timeZone: TimeZone = .current) -> Date? {
+        let parts = string.split(separator: "-", omittingEmptySubsequences: false)
+        guard parts.count == 3,
+              parts.map(\.count) == [4, 2, 2],
+              parts.allSatisfy({ $0.allSatisfy { $0.isASCII && $0.isNumber } }),
+              let year = Int(parts[0]), let month = Int(parts[1]), let day = Int(parts[2])
+        else { return nil }
+        let calendar = gregorian(in: timeZone)
+        let components = DateComponents(year: year, month: month, day: day, hour: 12)
+        guard components.isValidDate(in: calendar) else { return nil }
+        return calendar.date(from: components)
+    }
+
+    /// The calendar day `date` falls on in `timeZone`, in the server's format.
+    static func string(from date: Date, timeZone: TimeZone = .current) -> String {
+        let parts = gregorian(in: timeZone).dateComponents([.year, .month, .day], from: date)
+        return String(format: "%04d-%02d-%02d", parts.year ?? 0, parts.month ?? 0, parts.day ?? 0)
+    }
+
+    /// The server's dates are always Gregorian, whatever calendar the user has picked.
+    private static func gregorian(in timeZone: TimeZone) -> Calendar {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = timeZone
+        return calendar
+    }
+}
diff --git a/Sprout/Models/LocalMoney.swift b/Sprout/Models/LocalMoney.swift
new file mode 100644
index 0000000..7ce7816
--- /dev/null
+++ b/Sprout/Models/LocalMoney.swift
@@ -0,0 +1,74 @@
+import Foundation
+
+/// Money in the user's region: the currency of `locale`, written the way that region writes numbers.
+/// Formatting and parsing share the one locale, so what the app shows is what it accepts back.
+struct LocalMoney {
+    let locale: Locale
+
+    var currencyCode: String { locale.currency?.identifier ?? "USD" }
+
+    /// "$1,234.50" in the US, "1.234,50 €" in Germany, "1 234,50 €" in France.
+    func format(_ amount: Decimal) -> String {
+        amount.formatted(.currency(code: currencyCode).locale(locale))
+    }
+
+    /// An example amount written the local way ("12.50" / "12,50"), for hints and error messages.
+    var sampleInput: String {
+        (Decimal(1250) / 100).formatted(.number.precision(.fractionLength(fractionDigits)).locale(locale))
+    }
+
+    /// Strictly parses an amount the user typed. Returns nil unless the whole text is one number written the local
+    /// way: digits, optional grouping separators in the right places, and at most one local decimal separator
+    /// followed by no more digits than the currency has ("1,234.50" in the US, "1.234,50" in Germany,
+    /// "1 234,50" in France).
+    ///
+    /// Foundation's number parsers are too forgiving for money: they stop at the first character they don't
+    /// understand and keep what they had, so in Germany "12.5" comes back as 12 and "19.99" as 1999, and "12abc"
+    /// comes back as 12 everywhere.
+    func parse(_ text: String) -> Decimal? {
+        let text = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        let halves = text.components(separatedBy: locale.decimalSeparator ?? ".")
+        guard halves.count <= 2 else { return nil }
+        let fraction = halves.count == 2 ? halves[1] : ""
+        guard fraction.count <= fractionDigits,
+              fraction.allSatisfy(Self.isDigit),
+              let integer = integerDigits(halves[0]),
+              !(integer + fraction).isEmpty
+        else { return nil }
+        let normalized = "\(integer.isEmpty ? "0" : integer).\(fraction.isEmpty ? "0" : fraction)"
+        return Decimal(string: normalized, locale: Locale(identifier: "en_US_POSIX"))
+    }
+
+    /// Number of digits after the decimal separator for the currency (2 for USD and EUR).
+    private var fractionDigits: Int {
+        let formatter = NumberFormatter()
+        formatter.numberStyle = .currency
+        formatter.locale = locale
+        formatter.currencyCode = currencyCode
+        return formatter.maximumFractionDigits
+    }
+
+    /// "1,234" → "1234". Grouping separators are optional; where used, the first group is 1–3 digits not starting
+    /// with 0 and every later group has exactly three ("0,001" is not a way to write 1).
+    private func integerDigits(_ text: String) -> String? {
+        let groups = text.split(omittingEmptySubsequences: false, whereSeparator: isGroupingSeparator)
+        guard groups.allSatisfy({ $0.allSatisfy(Self.isDigit) }) else { return nil }
+        if groups.count > 1 {
+            guard (1...3).contains(groups[0].count), groups[0].first != "0",
+                  groups.dropFirst().allSatisfy({ $0.count == 3 })
+            else { return nil }
+        }
+        return groups.joined()
+    }
+
+    /// French groups digits with a narrow no-break space; people type an ordinary space, so any space counts there.
+    private func isGroupingSeparator(_ character: Character) -> Bool {
+        let separator = locale.groupingSeparator ?? ","
+        if !separator.isEmpty, separator.allSatisfy(\.isWhitespace) { return character.isWhitespace }
+        return String(character) == separator
+    }
+
+    nonisolated private static func isDigit(_ character: Character) -> Bool {
+        character.isASCII && character.isNumber
+    }
+}
diff --git a/Sprout/Services/ExpenseStore.swift b/Sprout/Services/ExpenseStore.swift
new file mode 100644
index 0000000..ba5b2c2
--- /dev/null
+++ b/Sprout/Services/ExpenseStore.swift
@@ -0,0 +1,46 @@
+import Foundation
+import Observation
+
+/// Fitness expenses for the spending page, loaded from and saved to `ExpenseAPI`.
+@Observable
+final class ExpenseStore {
+    /// Newest day first, as the server orders them.
+    private(set) var expenses: [Expense] = []
+    /// Whether a fetch has succeeded yet. Until then there is no trustworthy list or total to show.
+    private(set) var hasLoaded = false
+
+    @ObservationIgnored private var loadGeneration = 0
+    /// Expenses the server accepted while the latest fetch was in flight; that fetch may not include them yet.
+    @ObservationIgnored private var recentAdds: [(expense: Expense, generation: Int)] = []
+
+    func load() async throws {
+        loadGeneration += 1
+        let generation = loadGeneration
+        let fetched = try await ExpenseAPI.shared.fetch()
+        // A newer fetch started while this one was in flight; its result is the one to keep.
+        guard generation == loadGeneration else { return }
+        // Anything saved before this fetch started is already in `fetched`.
+        recentAdds.removeAll { $0.generation < generation }
+        let fetchedIDs = Set(fetched.map(\.id))
+        let notYetFetched = recentAdds.map(\.expense).filter { !fetchedIDs.contains($0.id) }
+        expenses = (notYetFetched + fetched).sorted { $0.date > $1.date }
+        hasLoaded = true
+    }
+
+    /// Saves `amount` as spent today (the user's local day). The list changes only once the server has accepted it.
+    func addToday(amount: Decimal) async throws {
+        let expense = Expense(id: UUID().uuidString, amount: amount, date: ExpenseDay.string(from: .now), note: "")
+        try await ExpenseAPI.shared.add(expense)
+        recentAdds.append((expense: expense, generation: loadGeneration))
+        let index = expenses.firstIndex { $0.date <= expense.date } ?? expenses.endIndex
+        expenses.insert(expense, at: index)
+    }
+
+    /// Sum of the expenses dated in the same month as `reference`, in the user's calendar and time zone.
+    func total(inMonthOf reference: Date, calendar: Calendar = .current) -> Decimal {
+        expenses.reduce(into: 0) { sum, expense in
+            guard let day = expense.day, calendar.isDate(day, equalTo: reference, toGranularity: .month) else { return }
+            sum += expense.amount
+        }
+    }
+}

diff --git a/Sprout/Views/ExpenseListView.swift b/Sprout/Views/ExpenseListView.swift
new file mode 100644
index 0000000..9ac6c55
--- /dev/null
+++ b/Sprout/Views/ExpenseListView.swift
@@ -0,0 +1,195 @@
+import SwiftUI
+import UIKit
+
+/// Fitness spending: this month's total in the user's currency, every expense, and "+" to log one for today.
+struct ExpenseListView: View {
+    @State private var store = ExpenseStore()
+    @State private var isAddSheetPresented = false
+    /// Message from the last failed fetch, shown in place of the list until a fetch succeeds.
+    @State private var loadError: String?
+    /// "Today" and "this month" are judged against this; refreshed when the day or time zone changes.
+    @State private var now = Date.now
+    @Environment(\.locale) private var locale
+
+    var body: some View {
+        let money = LocalMoney(locale: locale)
+        List {
+            if store.hasLoaded {
+                Section {
+                    SWKPICard(
+                        title: "Spent This Month",
+                        value: money.format(store.total(inMonthOf: now)),
+                        icon: "dumbbell.fill",
+                        tint: .accent
+                    ) {
+                        Text(now, format: .dateTime.month(.wide).year())
+                            .font(.caption2)
+                            .foregroundStyle(.secondary)
+                    }
+                    .listRowInsets(EdgeInsets())
+                    .listRowBackground(Color.clear)
+                }
+
+                Section("Expenses") {
+                    if store.expenses.isEmpty {
+                        Text("No expenses yet. Tap + to log today's.")
+                            .foregroundStyle(.secondary)
+                    }
+                    ForEach(store.expenses) { expense in
+                        ExpenseRow(expense: expense, money: money, now: now)
+                    }
+                }
+            }
+        }
+        .animation(.default, value: store.expenses)
+        .overlay {
+            if !store.hasLoaded, let loadError {
+                ContentUnavailableView {
+                    Label("Couldn't Load Expenses", systemImage: "exclamationmark.triangle")
+                } description: {
+                    Text(loadError)
+                } actions: {
+                    Button("Try Again") {
+                        Task { await loadFirstTime() }
+                    }
+                }
+            }
+        }
+        .navigationTitle("Fitness Spending")
+        .toolbar {
+            ToolbarItem(placement: .topBarTrailing) {
+                Button("Log Expense", systemImage: "plus") {
+                    isAddSheetPresented = true
+                }
+                .disabled(!store.hasLoaded)
+            }
+        }
+        .sheet(isPresented: $isAddSheetPresented) {
+            SWAddSheet(
+                isPresented: $isAddSheetPresented,
+                title: "Log Today's Spending",
+                placeHolderText: "Amount, e.g. \(money.sampleInput)",
+                minLines: 1
+            ) { text in
+                logExpense(text, money: money)
+            }
+            .keyboardType(.decimalPad)
+        }
+        .swPageLoading(.expenses)
+        .task { await loadFirstTime() }
+        .refreshable { await load() }
+        .onReceive(NotificationCenter.default.publisher(for: UIApplication.significantTimeChangeNotification)) { _ in
+            now = .now
+        }
+    }
+
+    private func loadFirstTime() async {
+        guard !store.hasLoaded else { return }
+        SWLoadingManager.shared.show(page: .expenses)
+        await load()
+        SWLoadingManager.shared.hide(page: .expenses)
+    }
+
+    private func load() async {
+        now = .now
+        do {
+            try await store.load()
+            loadError = nil
+        } catch {
+            // Leaving the page cancels the fetch; that's not a failure to report.
+            guard !Task.isCancelled else { return }
+            loadError = error.localizedDescription
+            SWAlertManager.shared.show(.error, message: error.localizedDescription)
+        }
+    }
+
+    private func logExpense(_ text: String, money: LocalMoney) {
+        guard let amount = money.parse(text), amount > 0 else {
+            SWAlertManager.shared.show(.error, message: "Enter a valid amount, like \(money.sampleInput).")
+            return
+        }
+        Task {
+            now = .now
+            do {
+                try await store.addToday(amount: amount)
+                SWAlertManager.shared.show(.success, message: "Logged")
+            } catch {
+                SWAlertManager.shared.show(.error, message: error.localizedDescription)
+            }
+        }
+    }
+}
+
+// MARK: - Row
+
+private struct ExpenseRow: View {
+    let expense: Expense
+    let money: LocalMoney
+    let now: Date
+
+    var body: some View {
+        HStack(spacing: 12) {
+            VStack(alignment: .leading, spacing: 4) {
+                HStack(spacing: 8) {
+                    dayText
+                        .font(.headline)
+                    if isToday {
+                        SWStatusBadge(text: "Today", style: .info)
+                    }
+                }
+                if !expense.note.isEmpty {
+                    Text(expense.note)
+                        .font(.subheadline)
+                        .foregroundStyle(.secondary)
+                }
+            }
+
+            Spacer(minLength: 8)
+
+            VStack(alignment: .trailing, spacing: 4) {
+                Text(money.format(expense.amount))
+                    .font(.body.weight(.semibold))
+                    .monospacedDigit()
+                if expense.isLarge {
+                    SWStatusBadge(text: "Large", style: .error)
+                }
+            }
+        }
+        .padding(.vertical, 2)
+        .accessibilityElement(children: .combine)
+    }
+
+    /// "Nov 20" in the US, "20. Nov." in Germany, "20 nov." in France; the year is added outside the current one.
+    @ViewBuilder private var dayText: some View {
+        if let day = expense.day {
+            let isThisYear = Calendar.current.isDate(day, equalTo: now, toGranularity: .year)
+            Text(day, format: isThisYear ? .dateTime.month(.abbreviated).day() : .dateTime.year().month(.abbreviated).day())
+        } else {
+            // Not a real date: show what the server sent rather than guess.
+            Text(expense.date)
+        }
+    }
+
+    private var isToday: Bool {
+        guard let day = expense.day else { return false }
+        return Calendar.current.isDate(day, inSameDayAs: now)
+    }
+}
+
+#Preview("en_US") {
+    NavigationStack { ExpenseListView() }
+        .environment(\.locale, Locale(identifier: "en_US"))
+        .swAlert()
+}
+
+#Preview("de_DE") {
+    NavigationStack { ExpenseListView() }
+        .environment(\.locale, Locale(identifier: "de_DE"))
+        .swAlert()
+}
+
+#Preview("fr_FR") {
+    NavigationStack { ExpenseListView() }
+        .environment(\.locale, Locale(identifier: "fr_FR"))
+        .swAlert()
+}

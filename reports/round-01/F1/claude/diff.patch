+
+/// Step 2 — 世界各地都有好店: the folded map scales in, pins drop onto it one by one
+/// and the shop counter rolls up to 2000 in step with the pins.
+struct MapScene: View {
+    /// Seconds since this step started (the tap that brought it in).
+    let t: Double
+    /// Identifies this run of the scene so the counter restarts when the step is re-entered.
+    let runID: Date
+
+    private struct Pin {
+        let red: Bool
+        let x: CGFloat
+        let y: CGFloat
+    }
+
+    /// In drop order.
+    private let pins: [Pin] = [
+        Pin(red: true, x: 125, y: 246),
+        Pin(red: false, x: 306, y: 250.5),
+        Pin(red: false, x: 217, y: 303),
+        Pin(red: true, x: 99, y: 358),
+        Pin(red: false, x: 340, y: 334.5),
+        Pin(red: false, x: 175.5, y: 410.5),
+        Pin(red: true, x: 273.5, y: 422),
+        Pin(red: false, x: 264.5, y: 334.5),
+    ]
+
+    static let pinStart = 0.503
+    static let pinInterval = 0.152
+
+    var body: some View {
+        ZStack(alignment: .topLeading) {
+            map
+            ForEach(pins.indices, id: \.self) { i in
+                pinView(pins[i], index: i)
+            }
+            ShopCounter(runID: runID)
+                .opacity(Motion.progress(t, start: 0.47, duration: 0.15))
+                .placed(centerX: 220.5, y: AppFont.barlow.top(baseline: 591.3, size: 50), width: 440)
+        }
+        .canvasLayer()
+    }
+
+    private var map: some View {
+        let grow = Motion.easeOut(Motion.progress(t, start: 0.16, duration: 0.3))
+        return Image("welcome-map")
+            .resizable()
+            .interpolation(.high)
+            .frame(width: 378, height: 378)
+            .shadow(color: .black.opacity(0.13), radius: 12, x: 0, y: 6)
+            .scaleEffect(0.85 + 0.15 * grow)
+            .position(x: 220, y: 340.5)
+    }
+
+    private func pinView(_ pin: Pin, index: Int) -> some View {
+        let local = t - (Self.pinStart + Self.pinInterval * Double(index))
+        // Drops 27 pt on a bouncy spring: overshoots ~6 pt into the map, then settles.
+        let drop = -27 * (1 - Motion.spring(local, response: 0.343, damping: 0.456))
+        let opacity = Motion.progress(local, duration: 0.06)
+        return Image(pin.red ? "icon-pin-red" : "icon-pin")
+            .resizable()
+            .interpolation(.high)
+            .frame(width: 45, height: 45)
+            .offset(y: drop)
+            .opacity(local > 0 ? opacity : 0)
+            .position(x: pin.x, y: pin.y)
+    }
+}
+
+/// "2000 多家小店" — the number rolls with SwiftUI's numeric content transition.
+private struct ShopCounter: View {
+    let runID: Date
+
+    @State private var value = 0
+
+    /// Shown as each pin starts to fall.
+    private static let steps = [250, 550, 700, 1150, 1200, 1550, 1700, 2000]
+
+    var body: some View {
+        HStack(alignment: .firstTextBaseline, spacing: 5) {
+            Text(String(value))
+                .font(AppFont.barlow.font(50))
+                .foregroundStyle(Palette.orange)
+                .contentTransition(.numericText(value: Double(value)))
+            Text("多家小店")
+                .font(AppFont.smiley.font(23))
+                .foregroundStyle(Palette.ink)
+        }
+        .task(id: runID) {
+            value = 0
+            for (i, next) in Self.steps.enumerated() {
+                let fireAt = runID.addingTimeInterval(0.48 + 0.143 * Double(i))
+                let wait = fireAt.timeIntervalSinceNow
+                if wait > 0 {
+                    try? await Task.sleep(for: .seconds(wait), tolerance: .zero, clock: .continuous)
+                }
+                if Task.isCancelled { return }
+                withAnimation(.snappy(duration: 0.3)) {
+                    value = next
+                }
+            }
+        }
+    }
+}

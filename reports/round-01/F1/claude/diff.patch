+
+/// A bundled font plus the vertical metrics SwiftUI uses for its line box,
+/// so text can be placed by baseline exactly where the reference puts it.
+struct AppFont {
+    /// PostScript name of the font (bundled, or PingFang SC which ships with iOS).
+    let name: String
+    let ascent: CGFloat
+    let descent: CGFloat
+
+    static let barlow = AppFont(name: "BarlowCondensed-Bold", ascent: 1.0, descent: 0.2)
+    static let smiley = AppFont(name: "SmileySans-Oblique", ascent: 0.97, descent: 0.23)
+    static let marker = AppFont(name: "LXGWMarkerGothic-Regular", ascent: 0.982, descent: 0.198)
+    static let pingFang = AppFont(name: "PingFangSC-Regular", ascent: 1.06, descent: 0.34)
+
+    func font(_ size: CGFloat) -> Font {
+        .custom(name, fixedSize: size)
+    }
+
+    /// Top of the text's line box for a given baseline.
+    func top(baseline: CGFloat, size: CGFloat) -> CGFloat {
+        baseline - ascent * size
+    }
+
+    static func registerBundledFonts() {
+        let files = ["BarlowCondensed-Bold", "SmileySans-Oblique", "LXGWMarkerGothic-Regular"]
+        for file in files {
+            guard let url = Bundle.main.url(forResource: file, withExtension: "ttf") else { continue }
+            CTFontManagerRegisterFontsForURL(url as CFURL, .process, nil)
+        }
+    }
+}
+
+/// The page is laid out on the iPhone 18 Pro Max canvas (440 × 956 pt).
+enum Canvas {
+    static let width: CGFloat = 440
+    static let height: CGFloat = 956
+}
+
+extension View {
+    /// Places a view's top-leading corner at (x, y) inside a top-leading canvas ZStack.
+    func placed(x: CGFloat, y: CGFloat) -> some View {
+        fixedSize().offset(x: x, y: y)
+    }
+
+    /// Horizontally centers a view on `centerX` with its top at `y` inside a top-leading canvas ZStack.
+    func placed(centerX: CGFloat, y: CGFloat, width: CGFloat = 400) -> some View {
+        fixedSize()
+            .frame(width: width)
+            .offset(x: centerX - width / 2, y: y)
+    }
+
+    /// Full-canvas layer, so transforms can use canvas coordinates as anchors.
+    func canvasLayer() -> some View {
+        frame(width: Canvas.width, height: Canvas.height, alignment: .topLeading)
+    }
+}
+
+extension UnitPoint {
+    static func canvas(_ x: CGFloat, _ y: CGFloat) -> UnitPoint {
+        UnitPoint(x: x / Canvas.width, y: y / Canvas.height)
+    }
+}

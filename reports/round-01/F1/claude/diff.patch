+import SwiftUI
+
+/// Step 3 — 一键导航到门口: the shop slides in, a pin drops at the start of a dotted
+/// route, a paper plane flies the route leaving an orange trail, and "到了" pops
+/// up when it reaches the door.
+struct NavigateScene: View {
+    /// Seconds since this step started (the tap that brought it in).
+    let t: Double
+
+    private let routeAppear = 0.42
+    private let flightStart = 0.71
+    private let flightDuration = 1.4
+    private let trailLag = 0.075
+    private var arrival: Double { flightStart + flightDuration }
+
+    var body: some View {
+        ZStack(alignment: .topLeading) {
+            shop
+            routeDots
+            startPin
+            plane
+            arrivedBubble
+        }
+        .canvasLayer()
+    }
+
+    // MARK: Shop
+
+    private var shop: some View {
+        let settle = Motion.easeOut(Motion.progress(t, start: 0.16, duration: 0.3))
+        let bump = Motion.pulse(t - (arrival + 0.11), attack: 0.12, release: 0.3)
+        return Image("welcome-shop")
+            .resizable()
+            .interpolation(.high)
+            .frame(width: 256, height: 256)
+            .shadow(color: .black.opacity(0.13), radius: 12, x: 0, y: 6)
+            .scaleEffect(0.975 + 0.025 * settle + 0.047 * bump, anchor: UnitPoint(x: 0.5, y: 0.82))
+            .position(x: 276, y: 283 + 5 * (1 - settle))
+    }
+
+    // MARK: Route
+
+    private var routeOpacity: Double {
+        Motion.progress(t, start: routeAppear, duration: 0.25)
+    }
+
+    private var routeDots: some View {
+        let trail = Route.length * flightProgress(at: t - trailLag)
+        return ZStack(alignment: .topLeading) {
+            ForEach(Route.dots.indices, id: \.self) { i in
+                let reached = t > flightStart + trailLag && Route.dotArc[i] <= trail + 0.5
+                // Each dot is a short round-capped dash lying along the route.
+                Capsule()
+                    .fill(reached ? Palette.orange : Palette.pathGrey)
+                    .frame(width: 6.6, height: 5.4)
+                    .rotationEffect(.radians(Route.dotHeading[i]))
+                    .position(Route.dots[i])
+            }
+        }
+        .canvasLayer()
+        .opacity(routeOpacity)
+    }
+
+    private var startPin: some View {
+        let local = t - (routeAppear + 0.06)
+        let p = Motion.spring(local, response: 0.3, damping: 0.9)
+        let scale = 0.35 + 0.65 * p
+        return Image("icon-pin")
+            .resizable()
+            .interpolation(.high)
+            .frame(width: 52, height: 52)
+            .scaleEffect(scale)
+            .offset(x: -16 * (1 - p), y: -150 * (1 - p))
+            .opacity(local > 0 ? Motion.progress(local, duration: 0.1) : 0)
+            .position(x: 86.5, y: 535)
+    }
+
+    // MARK: Plane
+
+    private func flightProgress(at time: Double) -> Double {
+        Motion.bezier(0.1, 0, 0.9, 1, Motion.progress(time, start: flightStart, duration: flightDuration))
+    }
+
+    private var plane: some View {
+        let arc = Route.length * flightProgress(at: t)
+        let sample = Route.sample(at: arc)
+        let fadeIn = Motion.progress(t, start: flightStart, duration: 0.07)
+        let fadeOut = 1 - Motion.progress(t, start: arrival + 0.17, duration: 0.12)
+        return Image("icon-paper-plane")
+            .resizable()
+            .interpolation(.high)
+            .frame(width: 55, height: 55)
+            // The artwork points up-right (-45°); turn it to face along the route.
+            .rotationEffect(.radians(sample.heading + .pi / 4))
+            .opacity(t > flightStart ? fadeIn * fadeOut : 0)
+            .position(sample.point)
+    }
+
+    // MARK: Arrival
+
+    private var arrivedBubble: some View {
+        let local = t - (arrival + 0.12)
+        let scale = 0.5 + 0.5 * Motion.spring(local, response: 0.46, damping: 0.53)
+        let opacity = Motion.progress(local, duration: 0.15)
+        return Text("到了")
+            .font(AppFont.smiley.font(23))
+            .foregroundStyle(.white)
+            .frame(width: 74, height: 43.6)
+            .background(Capsule().fill(Palette.green))
+            .shadow(color: .black.opacity(0.04), radius: 4, x: 0, y: 2)
+            .scaleEffect(scale)
+            .opacity(local > 0 ? opacity : 0)
+            .position(x: 276, y: 443.7)
+    }
+}
+
+/// The dotted route from the pin to the shop door, measured from the reference
+/// (dots are evenly spaced ~14.8 pt apart along the curve).
+private enum Route {
+    static let dots: [CGPoint] = [
+        CGPoint(x: 86.9, y: 559.5), CGPoint(x: 101.7, y: 560.5), CGPoint(x: 116.5, y: 561.4),
+        CGPoint(x: 131.3, y: 561.9), CGPoint(x: 146.2, y: 561.8), CGPoint(x: 161.0, y: 560.5),
+        CGPoint(x: 175.6, y: 557.9), CGPoint(x: 189.3, y: 552.2), CGPoint(x: 199.4, y: 541.7),
+        CGPoint(x: 202.1, y: 527.3), CGPoint(x: 199.7, y: 512.6), CGPoint(x: 195.2, y: 498.6),
+        CGPoint(x: 190.0, y: 484.6), CGPoint(x: 185.1, y: 470.4), CGPoint(x: 181.5, y: 456.1),
+        CGPoint(x: 180.5, y: 441.2), CGPoint(x: 183.9, y: 426.9), CGPoint(x: 192.6, y: 415.1),
+        CGPoint(x: 204.9, y: 406.7), CGPoint(x: 218.5, y: 400.8), CGPoint(x: 232.9, y: 397.0),
+        CGPoint(x: 247.4, y: 394.3), CGPoint(x: 262.2, y: 392.4),
+    ]
+
+    /// Dense Catmull-Rom samples through the dots, with cumulative arc length.
+    static let samples: [(point: CGPoint, arc: Double)] = {
+        var points: [CGPoint] = []
+        let n = dots.count
+        for i in 0..<(n - 1) {
+            let p0 = dots[max(i - 1, 0)], p1 = dots[i], p2 = dots[i + 1], p3 = dots[min(i + 2, n - 1)]
+            let steps = 12
+            for s in 0..<steps {
+                let u = Double(s) / Double(steps)
+                points.append(catmullRom(p0, p1, p2, p3, u))
+            }
+        }
+        points.append(dots[n - 1])
+        // The plane glides a few points past the last dot before it stops at the door.
+        let last = dots[n - 1], prev = dots[n - 2]
+        let dx = last.x - prev.x, dy = last.y - prev.y
+        let len = max(hypot(dx, dy), 0.001)
+        points.append(CGPoint(x: last.x + dx / len * 3, y: last.y + dy / len * 3))
+        var result: [(CGPoint, Double)] = []
+        var arc = 0.0
+        for (i, p) in points.enumerated() {
+            if i > 0 {
+                let q = points[i - 1]
+                arc += hypot(Double(p.x - q.x), Double(p.y - q.y))
+            }
+            result.append((p, arc))
+        }
+        return result
+    }()
+
+    static let length: Double = samples.last?.arc ?? 1
+
+    /// Arc length at which each dot sits.
+    static let dotArc: [Double] = {
+        dots.map { dot in
+            samples.min(by: { distance($0.point, dot) < distance($1.point, dot) })?.arc ?? 0
+        }
+    }()
+
+    /// Direction of travel at each dot.
+    static let dotHeading: [Double] = dotArc.map { sample(at: $0).heading }
+
+    static func sample(at arc: Double) -> (point: CGPoint, heading: Double) {
+        let a = Motion.clamp(arc, 0, length)
+        var i = 1
+        while i < samples.count - 1 && samples[i].arc < a { i += 1 }
+        let lo = samples[i - 1], hi = samples[i]
+        let span = max(hi.arc - lo.arc, 1e-6)
+        let f = (a - lo.arc) / span
+        let here = CGPoint(x: lo.point.x + (hi.point.x - lo.point.x) * f,
+                           y: lo.point.y + (hi.point.y - lo.point.y) * f)
+        // Heading from a short look-around window so the plane turns smoothly.
+        let ahead = point(atArc: min(a + 6, length))
+        let behind = point(atArc: max(a - 6, 0))
+        let heading = atan2(Double(ahead.y - behind.y), Double(ahead.x - behind.x))
+        return (here, heading)
+    }
+
+    private static func point(atArc a: Double) -> CGPoint {
+        var i = 1
+        while i < samples.count - 1 && samples[i].arc < a { i += 1 }
+        let lo = samples[i - 1], hi = samples[i]
+        let f = (a - lo.arc) / max(hi.arc - lo.arc, 1e-6)
+        return CGPoint(x: lo.point.x + (hi.point.x - lo.point.x) * f,
+                       y: lo.point.y + (hi.point.y - lo.point.y) * f)
+    }
+
+    private static func distance(_ a: CGPoint, _ b: CGPoint) -> Double {
+        hypot(Double(a.x - b.x), Double(a.y - b.y))
+    }
+
+    private static func catmullRom(_ p0: CGPoint, _ p1: CGPoint, _ p2: CGPoint, _ p3: CGPoint, _ u: Double) -> CGPoint {
+        let u2 = u * u, u3 = u2 * u
+        func c(_ a: CGFloat, _ b: CGFloat, _ c: CGFloat, _ d: CGFloat) -> CGFloat {
+            let a = Double(a), b = Double(b), cc = Double(c), d = Double(d)
+            return CGFloat(0.5 * ((2 * b) + (-a + cc) * u + (2 * a - 5 * b + 4 * cc - d) * u2 + (-a + 3 * b - 3 * cc + d) * u3))
+        }
+        return CGPoint(x: c(p0.x, p1.x, p2.x, p3.x), y: c(p0.y, p1.y, p2.y, p3.y))
+    }
+}

diff --git a/Replica/Onboarding/FollowScene.swift b/Replica/Onboarding/FollowScene.swift
new file mode 100644
index 0000000..994b474
--- /dev/null
+++ b/Replica/Onboarding/FollowScene.swift
@@ -0,0 +1,249 @@
+import SwiftUI
+
+/// Step 1 — 跟着推荐者去吃: recommender avatars pop in, a pinned note slides up
+/// and types itself out, three flames pop, then a bowl of noodles lands and floats.
+struct FollowScene: View {
+    /// Seconds since this step started.
+    let t: Double
+
+    private struct Recommender {
+        let image: String
+        let name: String
+        let centerX: CGFloat
+        let centerY: CGFloat
+        let diameter: CGFloat
+        let fill: Color
+        let selected: Bool
+        let labelSize: CGFloat
+        let labelBaseline: CGFloat
+        /// Vertical center of the whole column (avatar + name), used as the pop anchor.
+        let anchorY: CGFloat
+        let delay: Double
+    }
+
+    private let recommenders: [Recommender] = [
+        Recommender(image: "welcome-suipo", name: "特厨隋坡", centerX: 103.3, centerY: 212, diameter: 87,
+                    fill: Palette.avatarYellow, selected: false, labelSize: 15, labelBaseline: 276,
+                    anchorY: 224, delay: -0.04),
+        Recommender(image: "welcome-wulala", name: "特别乌啦啦", centerX: 220, centerY: 195.8, diameter: 114.8,
+                    fill: Palette.avatarMint, selected: true, labelSize: 17.25, labelBaseline: 275.5,
+                    anchorY: 209, delay: 0.02),
+        Recommender(image: "welcome-jason", name: "刘雨鑫JASON", centerX: 336.7, centerY: 212, diameter: 87,
+                    fill: Palette.avatarMint, selected: false, labelSize: 15, labelBaseline: 276,
+                    anchorY: 224, delay: 0.21),
+    ]
+
+    var body: some View {
+        ZStack(alignment: .topLeading) {
+            ForEach(recommenders.indices, id: \.self) { i in
+                avatarColumn(recommenders[i])
+            }
+            NoteCard(t: t)
+            noodles
+        }
+        .canvasLayer()
+    }
+
+    private func avatarColumn(_ r: Recommender) -> some View {
+        let local = t - r.delay
+        let scale = 0.3 + 0.7 * Motion.spring(local, response: 0.5, damping: 0.72)
+        let opacity = Motion.progress(local, duration: 0.2)
+        let font = AppFont.smiley
+        return ZStack(alignment: .topLeading) {
+            ZStack {
+                Circle().fill(r.fill)
+                Image(r.image)
+                    .resizable()
+                    .interpolation(.high)
+                    .frame(width: r.selected ? r.diameter : 88, height: r.selected ? r.diameter : 88)
+                if r.selected {
+                    Circle().strokeBorder(Palette.orange, lineWidth: 3.2)
+                }
+            }
+            .frame(width: r.diameter, height: r.diameter)
+            .clipShape(Circle())
+            .position(x: r.centerX, y: r.centerY)
+
+            Text(r.name)
+                .font(font.font(r.labelSize))
+                .foregroundStyle(Palette.ink)
+                .placed(centerX: r.centerX, y: font.top(baseline: r.labelBaseline, size: r.labelSize), width: 160)
+        }
+        .canvasLayer()
+        .scaleEffect(scale, anchor: .canvas(r.centerX, r.anchorY))
+        .opacity(opacity)
+    }
+
+    private var noodles: some View {
+        let local = t - 2.17
+        let scale = 0.4 + 0.6 * Motion.spring(local, response: 0.42, damping: 0.55)
+        let opacity = Motion.progress(local, duration: 0.12)
+        // Gentle float once it has settled: up 4 pt and back, 1.5 s each way.
+        let floatPhase = max(0, t - 3.05)
+        let float = floatPhase > 0 ? -2 * (1 - cos(Double.pi * floatPhase / 1.5)) : 0
+        return Image("welcome-noodles")
+            .resizable()
+            .interpolation(.high)
+            .frame(width: 139.5, height: 139.5)
+            .shadow(color: .black.opacity(0.13), radius: 11, x: 0, y: 6)
+            .scaleEffect(scale)
+            .opacity(opacity)
+            .position(x: 341, y: 553 + float)
+    }
+}
+
+/// The pinned recommendation note. Laid out in its own unrotated 340 × 202 space,
+/// then tilted 1.5° counter-clockwise like the reference.
+private struct NoteCard: View {
+    /// Seconds since the step started.
+    let t: Double
+
+    private static let text = "这是上海我最喜欢吃的河南拉面之一，面条劲道，特别是蒜的味道很好。"
+    private static let characters = Array(text)
+
+    private let start = 0.45
+    private let typingStart = 0.47
+    private let perCharacter = 0.032
+
+    var body: some View {
+        let local = t - start
+        let rise = 1 - Motion.spring(local, response: 0.485, damping: 0.68)
+        let opacity = Motion.progress(local, duration: 0.2)
+        return card
+            .rotationEffect(.degrees(-1.5))
+            .position(x: 220, y: 402.6 + 30 * rise)
+            .opacity(opacity)
+    }
+
+    private var typedText: String {
+        guard t >= typingStart else { return "" }
+        let count = min(Self.characters.count, Int((t - typingStart) / perCharacter) + 1)
+        return String(Self.characters.prefix(count))
+    }
+
+    private var card: some View {
+        let pingFang = AppFont.pingFang
+        let smiley = AppFont.smiley
+        return ZStack(alignment: .topLeading) {
+            // Second sheet peeking out behind: a bit shorter and turned the other way.
+            sheet(fill: Palette.paperBack, width: 338.6, height: 187.2)
+                .rotationEffect(.degrees(4.25))
+                .position(x: 171.9, y: 94.55)
+            sheet(fill: Palette.paper, width: 340, height: 202)
+
+            ForEach(0..<3, id: \.self) { i in
+                Rectangle()
+                    .fill(Palette.rule)
+                    .frame(width: 309, height: 0.75)
+                    .offset(x: 15.5, y: [84.5, 116.7, 149.0][i])
+            }
+
+            HStack(alignment: .center, spacing: 6.6) {
+                Text("特别乌啦啦")
+                    .font(smiley.font(21.7))
+                    .foregroundStyle(Palette.ink)
+                Text("推荐")
+                    .font(pingFang.font(14.7))
+                    .foregroundStyle(Palette.meta)
+            }
+            .placed(x: 15.5, y: smiley.top(baseline: 42.8, size: 21.7))
+
+            Text(typedText)
+                .font(pingFang.font(20.6))
+                .foregroundStyle(Palette.noteBody)
+                .lineSpacing(3.4)
+                .frame(width: 310, alignment: .topLeading)
+                .fixedSize(horizontal: false, vertical: true)
+                .offset(x: 15.4, y: pingFang.top(baseline: 81.5, size: 20.6))
+
+            Text("推荐度")
+                .font(pingFang.font(12.5))
+                .foregroundStyle(Palette.meta)
+                .placed(x: 15.3, y: pingFang.top(baseline: 185.4, size: 12.5))
+
+            ForEach(0..<3, id: \.self) { i in
+                flame(index: i)
+            }
+
+            PushPin()
+                .position(x: 23.3, y: 5.3)
+        }
+        .frame(width: 340, height: 202, alignment: .topLeading)
+    }
+
+    private func sheet(fill: Color, width: CGFloat, height: CGFloat) -> some View {
+        RoundedRectangle(cornerRadius: 3, style: .continuous)
+            .fill(fill)
+            .overlay(
+                RoundedRectangle(cornerRadius: 3, style: .continuous)
+                    .strokeBorder(Palette.paperEdge, lineWidth: 0.9)
+            )
+            .frame(width: width, height: height)
+            .shadow(color: .black.opacity(0.07), radius: 5, x: 0, y: 2)
+    }
+
+    private func flame(index i: Int) -> some View {
+        let local = t - (1.633 + 0.183 * Double(i))
+        let scale = 0.3 + 0.7 * Motion.spring(local, response: 0.25, damping: 0.55)
+        let opacity = Motion.progress(local, duration: 0.08)
+        return Image("icon-flame")
+            .resizable()
+            .interpolation(.high)
+            .frame(width: 24.5, height: 24.5)
+            .scaleEffect(scale)
+            .opacity(opacity)
+            .position(x: 69.1 + 25.4 * CGFloat(i), y: 177.2)
+    }
+}
+
+/// Green clay thumbtack holding the note: a flat disc with a domed cap,
+/// a short needle and a soft shadow on the paper.
+private struct PushPin: View {
+    var body: some View {
+        ZStack {
+            Circle()
+                .fill(Color.black.opacity(0.16))
+                .frame(width: 12, height: 12)
+                .blur(radius: 1.6)
+                .offset(x: -8.5, y: 9.5)
+            Capsule()
+                .fill(Color(r: 125, g: 113, b: 106))
+                .frame(width: 1.2, height: 5)
+                .rotationEffect(.degrees(35))
+                .offset(x: -6.6, y: 7.6)
+            Ellipse()
+                .fill(
+                    LinearGradient(
+                        colors: [Color(r: 72, g: 160, b: 132), Color(r: 16, g: 116, b: 86), Color(r: 0, g: 72, b: 50)],
+                        startPoint: UnitPoint(x: 0.15, y: 0.1),
+                        endPoint: UnitPoint(x: 0.8, y: 0.95)
+                    )
+                )
+                .overlay(
+                    Ellipse()
+                        .strokeBorder(Color.white.opacity(0.12), lineWidth: 1)
+                        .blur(radius: 0.4)
+                )
+                .frame(width: 19.6, height: 19.2)
+                .shadow(color: .black.opacity(0.18), radius: 1.2, x: 0.4, y: 1.2)
+            // Groove the cap sits in.
+            Circle()
+                .fill(Color(r: 6, g: 70, b: 50).opacity(0.7))
+                .frame(width: 11.4, height: 11.4)
+                .blur(radius: 0.7)
+                .offset(x: 0.3, y: 0.2)
+            Circle()
+                .fill(
+                    RadialGradient(
+                        colors: [Color(r: 64, g: 166, b: 136), Color(r: 21, g: 128, b: 99), Color(r: 5, g: 93, b: 65)],
+                        center: UnitPoint(x: 0.32, y: 0.26),
+                        startRadius: 0,
+                        endRadius: 6.5
+                    )
+                )
+                .frame(width: 10, height: 10)
+                .offset(x: -0.4, y: -1.0)
+        }
+        .frame(width: 24, height: 24)
+    }
+}

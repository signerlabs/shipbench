+++ b/Replica/Onboarding/OnboardingView.swift
@@ -0,0 +1,377 @@
+import SwiftUI
+import QuartzCore
+
+/// New-user onboarding for 烟火小店: three steps, each with an animated illustration.
+///
+/// Everything is laid out on the 440 × 956 pt canvas of the iPhone 18 Pro Max and
+/// driven by a single animation timeline, so page transitions and each step's
+/// choreography stay in lockstep with the reference recording.
+struct OnboardingView: View {
+    private struct PageTransition {
+        let from: Int
+        let to: Int
+        let start: Date
+        var direction: CGFloat { to > from ? 1 : -1 }
+    }
+
+    private static let stepCount = 3
+    private static let transitionDuration = 0.5
+
+    /// Longest choreography of a step (step 3 settles ~2.6 s after its tap).
+    private static let sceneDuration = 3.5
+
+    @State private var step = 0
+    @State private var transition: PageTransition?
+    @State private var sceneStarts = Array(repeating: Date.distantFuture, count: stepCount)
+    /// Stops per-frame updates once a step has finished animating (step 1 floats forever).
+    @State private var timelinePaused = false
+    @State private var idleToken = 0
+    @State private var firstFrames: FirstFramesWaiter?
+
+    var body: some View {
+        GeometryReader { geo in
+            let scale = min(geo.size.width / Canvas.width, geo.size.height / Canvas.height)
+            TimelineView(.animation(minimumInterval: nil, paused: timelinePaused)) { context in
+                canvas(now: context.date)
+                    .canvasLayer()
+                    .scaleEffect(scale, anchor: .topLeading)
+                    .frame(width: Canvas.width * scale, height: Canvas.height * scale, alignment: .topLeading)
+            }
+            .frame(width: geo.size.width, height: geo.size.height)
+        }
+        .background(Palette.background)
+        .ignoresSafeArea()
+        .onAppear {
+            guard sceneStarts[0] == .distantFuture, firstFrames == nil else { return }
+            // Start step 1 once frames are actually reaching the screen (a cold launch can
+            // stall the first commit), plus a beat for the launch zoom to land.
+            let waiter = FirstFramesWaiter(frames: 3) {
+                let start = Date().addingTimeInterval(Self.launchDelay)
+                sceneStarts[0] = start
+                firstFrames = nil
+                scheduleScriptedTaps(from: start)
+            }
+            firstFrames = waiter
+            waiter.start()
+        }
+    }
+
+    private static let launchDelay = 0.17
+
+    /// Capture aid for side-by-side comparison with the reference recording without touch
+    /// input: launch with `-scriptedTaps 6.47,11.57` to press "下一步" that many seconds into
+    /// step 1. Inert unless that launch argument is passed.
+    private func scheduleScriptedTaps(from start: Date) {
+        let args = ProcessInfo.processInfo.arguments
+        guard let i = args.firstIndex(of: "-scriptedTaps"), i + 1 < args.count else { return }
+        let times = args[i + 1].split(separator: ",").compactMap { Double($0) }
+        Task { @MainActor in
+            for time in times.sorted() {
+                let delay = start.addingTimeInterval(time).timeIntervalSinceNow
+                if delay > 0 {
+                    // Zero tolerance: GCD timers would otherwise coalesce by up to ~10% of the delay.
+                    try? await Task.sleep(for: .seconds(delay), tolerance: .zero, clock: .continuous)
+                }
+                advance()
+            }
+        }
+    }
+
+    // MARK: Timeline
+
+    /// Page transition progress (0…1) on the reference's ease curve.
+    private func transitionProgress(at now: Date) -> Double {
+        guard let transition else { return 1 }
+        let linear = now.timeIntervalSince(transition.start) / Self.transitionDuration
+        return Motion.bezier(0.45, 0.2, 0.3, 0.95, Motion.clamp(linear))
+    }
+
+    private func isTransitioning(at now: Date) -> Bool {
+        guard let transition else { return false }
+        return now.timeIntervalSince(transition.start) < Self.transitionDuration
+    }
+
+    @ViewBuilder
+    private func canvas(now: Date) -> some View {
+        let p = transitionProgress(at: now)
+        let active = isTransitioning(at: now) ? transition : nil
+        let visibleSteps = active.map { [$0.from, $0.to] } ?? [step]
+
+        ZStack(alignment: .topLeading) {
+            Palette.background
+
+            ForEach(visibleSteps, id: \.self) { s in
+                page(s, now: now, p: p, transition: active)
+            }
+
+            header(p: p, transition: active)
+            primaryButton(now: now)
+        }
+    }
+
+    private func page(_ s: Int, now: Date, p: Double, transition: PageTransition?) -> some View {
+        let t = now.timeIntervalSince(sceneStarts[s])
+        var illustrationOffset: CGFloat = 0
+        var illustrationOpacity = 1.0
+        var textOffset: CGFloat = 0
+        var numberOffset: CGFloat = 0
+        var textOpacity = 1.0
+
+        if let transition {
+            let d = transition.direction
+            let q = CGFloat(p)
+            if s == transition.to {
+                // Incoming: slides in from the trailing side; the illustration fades in late.
+                illustrationOffset = d * Canvas.width * (1 - q)
+                illustrationOpacity = pow(p, 4.5)
+                textOffset = d * 400 * (1 - q)
+                numberOffset = d * 464 * (1 - q)
+                textOpacity = pow(p, 1.5)
+            } else {
+                // Outgoing: pushed off the leading side; only the copy fades.
+                illustrationOffset = -d * Canvas.width * q
+                textOffset = -d * 400 * q
+                numberOffset = -d * 464 * q
+                textOpacity = 1 - p
+            }
+        }
+
+        return StepPage(
+            step: s,
+            t: t,
+            runID: sceneStarts[s],
+            illustrationOffset: illustrationOffset,
+            illustrationOpacity: illustrationOpacity,
+            textOffset: textOffset,
+            numberOffset: numberOffset,
+            textOpacity: textOpacity
+        )
+    }
+
+    // MARK: Header
+
+    private func header(p: Double, transition: PageTransition?) -> some View {
+        let from = transition?.from ?? step
+        let backOpacity = Motion.lerp(from > 0 ? 1 : 0, step > 0 ? 1 : 0, p)
+
+        return ZStack(alignment: .topLeading) {
+            Button(action: goBack) {
+                ZStack {
+                    Circle().fill(Palette.backButton)
+                    Image(systemName: "chevron.left")
+                        .font(.system(size: 16, weight: .semibold))
+                        .foregroundStyle(Palette.ink)
+                }
+                .frame(width: 44, height: 44)
+                .contentShape(Circle())
+            }
+            .buttonStyle(PressScaleStyle(scale: 0.94))
+            .opacity(backOpacity)
+            .allowsHitTesting(step > 0)
+            .position(x: 42, y: 92)
+
+            HStack(spacing: 6) {
+                ForEach(0..<Self.stepCount, id: \.self) { i in
+                    let fill = Motion.lerp(i <= from ? 1 : 0, i <= step ? 1 : 0, p)
+                    Capsule()
+                        .fill(Palette.track)
+                        .overlay(alignment: .leading) {
+                            GeometryReader { g in
+                                Capsule()
+                                    .fill(Palette.orange)
+                                    .frame(width: g.size.width * CGFloat(fill))
+                                    .opacity(fill > 0.001 ? 1 : 0)
+                            }
+                        }
+                }
+            }
+            .frame(width: 290, height: 5)
+            .position(x: 222.7, y: 92.2)
+
+            Button(action: skip) {
+                Text("跳过")
+                    .font(AppFont.pingFang.font(15))
+                    .foregroundStyle(Palette.secondary)
+                    .padding(.horizontal, 4)
+                    .frame(height: 44)
+                    .contentShape(Rectangle())
+            }
+            .buttonStyle(PressScaleStyle(scale: 0.94))
+            // Text origin lands at x 385.9 with its baseline at y 97.2.
+            .placed(x: 381.9, y: AppFont.pingFang.top(baseline: 97.2, size: 15)
+                    - (44 - 15 * (AppFont.pingFang.ascent + AppFont.pingFang.descent)) / 2)
+        }
+        .canvasLayer()
+    }
+
+    // MARK: Primary button
+
+    private func primaryButton(now: Date) -> some View {
+        let label = Self.buttonLabel(for: step)
+        var oldLabel: String?
+        var oldOpacity = 0.0
+        var newOpacity = 1.0
+        if let transition, Self.buttonLabel(for: transition.from) != label {
+            let tt = now.timeIntervalSince(transition.start)
+            oldOpacity = 1 - Motion.progress(tt, start: 0.03, duration: 0.1)
+            newOpacity = Motion.progress(tt, start: 0.17, duration: 0.15)
+            if oldOpacity > 0 { oldLabel = Self.buttonLabel(for: transition.from) }
+        }
+
+        return Button(action: advance) {
+            ZStack {
+                Capsule().fill(Palette.green)
+                if let oldLabel {
+                    buttonText(oldLabel).opacity(oldOpacity)
+                }
+                buttonText(label).opacity(newOpacity)
+            }
+            .frame(width: 400, height: 56)
+            .contentShape(Capsule())
+        }
+        .buttonStyle(PressScaleStyle(scale: 0.99))
+        .position(x: 220, y: 882)
+    }
+
+    private func buttonText(_ s: String) -> some View {
+        Text(s)
+            .font(AppFont.smiley.font(20))
+            .foregroundStyle(.white)
+    }
+
+    private static func buttonLabel(for step: Int) -> String {
+        step == stepCount - 1 ? "继续" : "下一步"
+    }
+
+    // MARK: Actions
+
+    private func advance() {
+        guard step < Self.stepCount - 1 else { return }
+        go(to: step + 1)
+    }
+
+    private func goBack() {
+        guard step > 0 else { return }
+        go(to: step - 1)
+    }
+
+    private func skip() {
+        guard step < Self.stepCount - 1 else { return }
+        go(to: Self.stepCount - 1)
+    }
+
+    private func go(to target: Int) {
+        let now = Date()
+        guard !isTransitioning(at: now), target != step else { return }
+        transition = PageTransition(from: step, to: target, start: now)
+        sceneStarts[target] = now
+        step = target
+        scheduleIdle(after: target)
+    }
+
+    private func scheduleIdle(after target: Int) {
+        timelinePaused = false
+        idleToken += 1
+        let token = idleToken
+        guard target != 0 else { return }
+        Task { @MainActor in
+            try? await Task.sleep(for: .seconds(Self.sceneDuration))
+            if token == idleToken { timelinePaused = true }
+        }
+    }
+}
+
+/// One step's illustration plus its numbered title and subtitle.
+private struct StepPage: View {
+    let step: Int
+    let t: Double
+    let runID: Date
+    let illustrationOffset: CGFloat
+    let illustrationOpacity: Double
+    let textOffset: CGFloat
+    let numberOffset: CGFloat
+    let textOpacity: Double
+
+    private static let titles = ["跟着推荐者去吃", "世界各地都有好店", "一键导航到门口"]
+    private static let subtitles = [
+        "关注你喜欢的推荐者，跟着他们一家家吃过去",
+        "遍布 200 多座城市，出差旅行走到哪儿都能吃上",
+        "看中的店点一下，直接导航带你过去",
+    ]
+
+    var body: some View {
+        ZStack(alignment: .topLeading) {
+            illustration
+                .offset(x: illustrationOffset)
+                .opacity(illustrationOpacity)
+
+            HStack(alignment: .firstTextBaseline, spacing: 12) {
+                Text(String(step + 1))
+                    .font(AppFont.barlow.font(46))
+                    .foregroundStyle(Palette.orange)
+                    .offset(x: numberOffset - textOffset)
+                Text(Self.titles[step])
+                    .font(AppFont.smiley.font(30))
+                    .foregroundStyle(Palette.ink)
+            }
+            .placed(x: 20, y: AppFont.barlow.top(baseline: 691.4, size: 46))
+            .offset(x: textOffset)
+            .opacity(textOpacity)
+
+            Text(Self.subtitles[step])
+                .font(AppFont.marker.font(17))
+                .foregroundStyle(Palette.secondary)
+                .placed(x: 20, y: AppFont.marker.top(baseline: 725.3, size: 17))
+                .offset(x: textOffset)
+                .opacity(textOpacity)
+        }
+        .canvasLayer()
+    }
+
+    @ViewBuilder
+    private var illustration: some View {
+        switch step {
+        case 0: FollowScene(t: t)
+        case 1: MapScene(t: t, runID: runID)
+        default: NavigateScene(t: t)
+        }
+    }
+}
+
+/// Calls back after the display has ticked a few times, i.e. once the main thread is
+/// free and the first frames have been committed.
+private final class FirstFramesWaiter: NSObject {
+    private var link: CADisplayLink?
+    private var remaining: Int
+    private let completion: () -> Void
+
+    init(frames: Int, completion: @escaping () -> Void) {
+        self.remaining = frames
+        self.completion = completion
+    }
+
+    func start() {
+        let link = CADisplayLink(target: self, selector: #selector(tick))
+        link.add(to: .main, forMode: .common)
+        self.link = link
+    }
+
+    @objc private func tick() {
+        remaining -= 1
+        guard remaining <= 0 else { return }
+        link?.invalidate()
+        link = nil
+        completion()
+    }
+}
+
+/// Subtle press feedback used by the onboarding buttons.
+private struct PressScaleStyle: ButtonStyle {
+    var scale: CGFloat
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .scaleEffect(configuration.isPressed ? scale : 1)
+            .animation(.easeOut(duration: 0.12), value: configuration.isPressed)
+    }
+}

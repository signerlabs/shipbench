@@ -0,0 +1,80 @@
+import Foundation
+
+/// Time-based easing helpers. Every animation on the onboarding page is a pure
+/// function of "seconds since something happened", which keeps the choreography
+/// deterministic and lets several overlapping effects share one timeline.
+enum Motion {
+    static func clamp(_ x: Double, _ lo: Double = 0, _ hi: Double = 1) -> Double {
+        min(max(x, lo), hi)
+    }
+
+    /// Linear 0…1 progress of `t` inside `[start, start + duration]`.
+    static func progress(_ t: Double, start: Double = 0, duration: Double) -> Double {
+        guard duration > 0 else { return t >= start ? 1 : 0 }
+        return clamp((t - start) / duration)
+    }
+
+    static func lerp(_ a: Double, _ b: Double, _ p: Double) -> Double {
+        a + (b - a) * p
+    }
+
+    /// Step response of a SwiftUI-style spring (`response`, `dampingFraction`), 0 → 1.
+    static func spring(_ t: Double, response: Double, damping: Double) -> Double {
+        guard t > 0 else { return 0 }
+        let w = 2 * Double.pi / response
+        if damping >= 1 {
+            return 1 - (1 + w * t) * exp(-w * t)
+        }
+        let wd = w * sqrt(1 - damping * damping)
+        return 1 - exp(-damping * w * t) * (cos(wd * t) + damping * w / wd * sin(wd * t))
+    }
+
+    /// CSS-style cubic bezier timing curve evaluated at linear progress `x`.
+    static func bezier(_ x1: Double, _ y1: Double, _ x2: Double, _ y2: Double, _ x: Double) -> Double {
+        if x <= 0 { return 0 }
+        if x >= 1 { return 1 }
+        func bx(_ t: Double) -> Double { 3 * (1 - t) * (1 - t) * t * x1 + 3 * (1 - t) * t * t * x2 + t * t * t }
+        func by(_ t: Double) -> Double { 3 * (1 - t) * (1 - t) * t * y1 + 3 * (1 - t) * t * t * y2 + t * t * t }
+        func dbx(_ t: Double) -> Double {
+            3 * (1 - t) * (1 - t) * x1 + 6 * (1 - t) * t * (x2 - x1) + 3 * t * t * (1 - x2)
+        }
+        var t = x
+        for _ in 0..<8 {
+            let d = dbx(t)
+            if abs(d) < 1e-6 { break }
+            t = clamp(t - (bx(t) - x) / d)
+        }
+        if abs(bx(t) - x) > 1e-4 {
+            var lo = 0.0, hi = 1.0
+            for _ in 0..<40 {
+                let m = (lo + hi) / 2
+                if bx(m) < x { lo = m } else { hi = m }
+            }
+            t = (lo + hi) / 2
+        }
+        return by(t)
+    }
+
+    static func easeOut(_ p: Double) -> Double {
+        let q = 1 - clamp(p)
+        return 1 - q * q * q
+    }
+
+    static func easeIn(_ p: Double) -> Double {
+        let q = clamp(p)
+        return q * q
+    }
+
+    static func easeInOut(_ p: Double) -> Double {
+        bezier(0.42, 0, 0.58, 1, clamp(p))
+    }
+
+    /// 0 → 1 → 0 hump over `duration`, with a quick attack and a softer release.
+    static func pulse(_ t: Double, attack: Double, release: Double) -> Double {
+        guard t > 0 else { return 0 }
+        if t < attack { return easeOut(t / attack) }
+        let r = (t - attack) / release
+        guard r < 1 else { return 0 }
+        return 1 - easeInOut(r)
+    }
+}

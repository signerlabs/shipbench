diff --git a/src/index.ts b/src/index.ts
new file mode 100644
index 0000000..033edcf
--- /dev/null
+++ b/src/index.ts
@@ -0,0 +1,109 @@
+import { parseEvent, toSubscription, type SubscriptionRow } from "./subscriptions";
+
+export interface Env {
+  DB: D1Database;
+  WEBHOOK_SECRET: string;
+  API_TOKEN: string;
+}
+
+function json(body: unknown, status = 200, headers: Record<string, string> = {}): Response {
+  return Response.json(body, {
+    status,
+    headers: { "Cache-Control": "no-store", ...headers },
+  });
+}
+
+function authorized(request: Request, secret: string | undefined): boolean {
+  return typeof secret === "string" && secret.length > 0 &&
+    request.headers.get("Authorization") === `Bearer ${secret}`;
+}
+
+function unauthorized(): Response {
+  return json({ error: "Unauthorized" }, 401, { "WWW-Authenticate": "Bearer" });
+}
+
+async function webhook(request: Request, env: Env): Promise<Response> {
+  if (!authorized(request, env.WEBHOOK_SECRET)) return unauthorized();
+  if (request.method !== "POST") {
+    return json({ error: "Method not allowed" }, 405, { Allow: "POST" });
+  }
+
+  let body: unknown;
+  try {
+    body = await request.json();
+  } catch {
+    return json({ error: "Invalid JSON" }, 400);
+  }
+
+  const event = parseEvent(body);
+  if (!event) return json({ error: "Invalid subscription event" }, 400);
+
+  // One atomic write: no read-before-write race and no separate processed flag.
+  // A duplicate ID cannot replace the original payload, even for another user.
+  await env.DB.prepare(`
+    INSERT INTO subscription_events
+      (id, type, app_user_id, event_timestamp_ms, product_id, expiration_at_ms, received_at_ms)
+    VALUES (?, ?, ?, ?, ?, ?, ?)
+    ON CONFLICT (id) DO NOTHING
+  `).bind(
+    event.id,
+    event.type,
+    event.app_user_id,
+    event.event_timestamp_ms,
+    event.product_id,
+    event.expiration_at_ms,
+    Date.now(),
+  ).run();
+
+  return json({ ok: true });
+}
+
+async function subscription(request: Request, env: Env, encodedUserId: string): Promise<Response> {
+  if (!authorized(request, env.API_TOKEN)) return unauthorized();
+  if (request.method !== "GET") {
+    return json({ error: "Method not allowed" }, 405, { Allow: "GET" });
+  }
+
+  let appUserId: string;
+  try {
+    appUserId = decodeURIComponent(encodedUserId);
+  } catch {
+    return json({ error: "Invalid user ID encoding" }, 400);
+  }
+
+  // All fields come from one database snapshot. Optional fields inherit the
+  // latest supplied value in event-time order, even when older events arrive late.
+  // Equal timestamps use the lexicographically greatest ID as a stable tie-break.
+  const row = await env.DB.prepare(`
+    SELECT type,
+      (SELECT product_id FROM known_subscription_events
+       WHERE app_user_id = ?1 AND product_id IS NOT NULL
+       ORDER BY event_timestamp_ms DESC, id DESC LIMIT 1) AS product_id,
+      (SELECT expiration_at_ms FROM known_subscription_events
+       WHERE app_user_id = ?1 AND expiration_at_ms IS NOT NULL
+       ORDER BY event_timestamp_ms DESC, id DESC LIMIT 1) AS expires_at_ms
+    FROM known_subscription_events
+    WHERE app_user_id = ?1
+    ORDER BY event_timestamp_ms DESC, id DESC LIMIT 1
+  `).bind(appUserId).first<SubscriptionRow>();
+
+  return json(toSubscription(appUserId, row, Date.now()));
+}
+
+export default {
+  async fetch(request: Request, env: Env): Promise<Response> {
+    const pathname = new URL(request.url).pathname;
+    try {
+      if (pathname === "/v1/webhooks/subscription") return await webhook(request, env);
+
+      const match = /^\/v1\/users\/([^/]+)\/subscription$/.exec(pathname);
+      if (match?.[1]) return await subscription(request, env, match[1]);
+
+      return json({ error: "Not found" }, 404);
+    } catch (error) {
+      // Return a non-2xx response so the sender retries a failed database write.
+      console.error("Subscription request failed", error);
+      return json({ error: "Internal server error" }, 500);
+    }
+  },
+} satisfies ExportedHandler<Env>;
diff --git a/src/subscriptions.ts b/src/subscriptions.ts
new file mode 100644
index 0000000..0da099e
--- /dev/null
+++ b/src/subscriptions.ts
@@ -0,0 +1,99 @@
+export interface SubscriptionEvent {
+  id: string;
+  type: string;
+  app_user_id: string;
+  event_timestamp_ms: number;
+  product_id: string | null;
+  expiration_at_ms: number | null;
+}
+
+const EVENT_STATUS = {
+  INITIAL_PURCHASE: "active",
+  RENEWAL: "active",
+  CANCELLATION: "cancelled",
+  UNCANCELLATION: "active",
+  EXPIRATION: "expired",
+  REFUND: "refunded",
+} as const;
+
+export interface SubscriptionRow {
+  type: keyof typeof EVENT_STATUS;
+  product_id: string | null;
+  expires_at_ms: number | null;
+}
+
+export interface Subscription {
+  app_user_id: string;
+  status: "none" | "active" | "cancelled" | "expired" | "refunded";
+  active: boolean;
+  product_id: string | null;
+  expires_at_ms: number | null;
+  will_renew: boolean;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isNonEmptyString(value: unknown): value is string {
+  return typeof value === "string" && value.trim().length > 0;
+}
+
+function isTimestamp(value: unknown): value is number {
+  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0;
+}
+
+export function parseEvent(body: unknown): SubscriptionEvent | null {
+  if (!isRecord(body) || !isRecord(body.event)) return null;
+  const event = body.event;
+  if (
+    !isNonEmptyString(event.id) ||
+    !isNonEmptyString(event.type) ||
+    !isNonEmptyString(event.app_user_id) ||
+    !isTimestamp(event.event_timestamp_ms)
+  ) {
+    return null;
+  }
+  if (event.product_id != null && !isNonEmptyString(event.product_id)) return null;
+  if (event.expiration_at_ms != null && !isTimestamp(event.expiration_at_ms)) return null;
+
+  return {
+    id: event.id,
+    type: event.type,
+    app_user_id: event.app_user_id,
+    event_timestamp_ms: event.event_timestamp_ms,
+    product_id: event.product_id ?? null,
+    expiration_at_ms: event.expiration_at_ms ?? null,
+  };
+}
+
+export function toSubscription(
+  appUserId: string,
+  row: SubscriptionRow | null,
+  now: number,
+): Subscription {
+  if (!row) {
+    return {
+      app_user_id: appUserId,
+      status: "none",
+      active: false,
+      product_id: null,
+      expires_at_ms: null,
+      will_renew: false,
+    };
+  }
+
+  const eventStatus = EVENT_STATUS[row.type];
+  const canHaveAccess = eventStatus === "active" || eventStatus === "cancelled";
+  // Never grant indefinite access when no event has supplied an expiry.
+  const active = canHaveAccess && row.expires_at_ms !== null && row.expires_at_ms > now;
+
+  return {
+    app_user_id: appUserId,
+    status: canHaveAccess && !active ? "expired" : eventStatus,
+    active,
+    product_id: row.product_id,
+    expires_at_ms: row.expires_at_ms,
+    will_renew: active && eventStatus === "active",
+  };
+}
diff --git a/test/api.test.mjs b/test/api.test.mjs
new file mode 100644
index 0000000..4c7ad93
--- /dev/null
+++ b/test/api.test.mjs
@@ -0,0 +1,361 @@
+import assert from "node:assert/strict";
+import { after, before, beforeEach, test } from "node:test";
+import { createTestHarness } from "wrangler";
+
+// Test-only credentials override .dev.vars. The harness uses isolated local D1
+// storage and builds/runs the actual Worker with the project's Wrangler config.
+const secrets = { WEBHOOK_SECRET: "test-webhook-secret", API_TOKEN: "test-api-token" };
+const server = createTestHarness({
+  workers: [{ configPath: "./wrangler.jsonc", secrets }],
+});
+const worker = server.getWorker();
+let db;
+const now = Date.now();
+const day = 86_400_000;
+const future = now + day;
+
+before(async () => {
+  await server.listen();
+  await worker.applyD1Migrations("DB");
+  db = (await worker.getEnv()).DB;
+}, { timeout: 60_000 });
+
+after(async () => {
+  await server.close();
+});
+
+beforeEach(async () => {
+  await db.prepare("DELETE FROM subscription_events").run();
+});
+
+function event(overrides = {}) {
+  return {
+    id: "evt_1",
+    type: "INITIAL_PURCHASE",
+    app_user_id: "user_1",
+    product_id: "pro_monthly",
+    event_timestamp_ms: now - 10_000,
+    expiration_at_ms: future,
+    ...overrides,
+  };
+}
+
+function post(value, authorization = `Bearer ${secrets.WEBHOOK_SECRET}`) {
+  return server.fetch("/v1/webhooks/subscription", {
+    method: "POST",
+    headers: {
+      "Content-Type": "application/json",
+      ...(authorization === null ? {} : { Authorization: authorization }),
+    },
+    body: typeof value === "string" ? value : JSON.stringify(value),
+  });
+}
+
+async function send(value) {
+  const response = await post({ event: value });
+  assert.equal(response.status, 200);
+  assert.deepEqual(await response.json(), { ok: true });
+}
+
+function get(user = "user_1", authorization = `Bearer ${secrets.API_TOKEN}`) {
+  return server.fetch(`/v1/users/${encodeURIComponent(user)}/subscription`, {
+    headers: authorization === null ? {} : { Authorization: authorization },
+  });
+}
+
+async function state(user = "user_1") {
+  const response = await get(user);
+  assert.equal(response.status, 200);
+  assert.match(response.headers.get("Content-Type"), /application\/json/);
+  assert.equal(response.headers.get("Cache-Control"), "no-store");
+  return response.json();
+}
+
+async function countEvents() {
+  return db.prepare("SELECT COUNT(*) AS count FROM subscription_events").first("count");
+}
+
+function expected(overrides = {}) {
+  return {
+    app_user_id: "user_1",
+    status: "active",
+    active: true,
+    product_id: "pro_monthly",
+    expires_at_ms: future,
+    will_renew: true,
+    ...overrides,
+  };
+}
+
+test("both endpoints require their own bearer secret before processing data", async () => {
+  for (const authorization of [null, "", "Basic abc", "Bearer wrong", `Bearer ${secrets.API_TOKEN}`]) {
+    const response = await post({ event: event() }, authorization);
+    assert.equal(response.status, 401);
+    assert.equal(response.headers.get("WWW-Authenticate"), "Bearer");
+    await response.json();
+  }
+  for (const authorization of [null, "", "Bearer wrong", `Bearer ${secrets.WEBHOOK_SECRET}`]) {
+    const response = await get("user_1", authorization);
+    assert.equal(response.status, 401);
+    await response.json();
+  }
+  const invalidJson = await post("{", null);
+  assert.equal(invalidJson.status, 401);
+  await invalidJson.json();
+  assert.equal(await countEvents(), 0);
+});
+
+for (const [label, body] of [
+  ["empty body", ""], ["malformed JSON", "{"], ["null", "null"],
+  ["array", "[]"], ["missing event", "{}"], ["null event", '{"event":null}'],
+  ["array event", '{"event":[]}'],
+]) {
+  test(`returns 400 for ${label}`, async () => {
+    const response = await post(body);
+    assert.equal(response.status, 400);
+    await response.json();
+    assert.equal(await countEvents(), 0);
+  });
+}
+
+for (const field of ["id", "type", "app_user_id", "event_timestamp_ms"]) {
+  test(`returns 400 for missing ${field}`, async () => {
+    const value = event();
+    delete value[field];
+    const response = await post({ event: value });
+    assert.equal(response.status, 400);
+    await response.json();
+    assert.equal(await countEvents(), 0);
+  });
+}
+
+test("validates field types and finite nonnegative integer timestamps", async () => {
+  for (const override of [
+    { id: null }, { id: "" }, { id: 123 }, { type: [] }, { type: " " },
+    { app_user_id: false }, { app_user_id: "" }, { event_timestamp_ms: null },
+    { event_timestamp_ms: "1730000000000" }, { event_timestamp_ms: -1 },
+    { event_timestamp_ms: 1.5 }, { event_timestamp_ms: Number.MAX_SAFE_INTEGER + 1 },
+    { expiration_at_ms: "tomorrow" }, { expiration_at_ms: -1 }, { product_id: {} },
+  ]) {
+    const response = await post({ event: event(override) });
+    assert.equal(response.status, 400, JSON.stringify(override));
+    await response.json();
+  }
+  const overflow = await post('{"event":{"id":"x","type":"RENEWAL","app_user_id":"u","event_timestamp_ms":1e400}}');
+  assert.equal(overflow.status, 400);
+  await overflow.json();
+  assert.equal(await countEvents(), 0);
+});
+
+test("a user with no known subscription returns the complete none response", async () => {
+  assert.deepEqual(await state(), expected({
+    status: "none", active: false, product_id: null, expires_at_ms: null, will_renew: false,
+  }));
+});
+
+test("purchase, cancellation, uncancellation, renewal, expiration and refund lifecycle", async () => {
+  await send(event());
+  assert.deepEqual(await state(), expected());
+
+  await send(event({ id: "cancel", type: "CANCELLATION", event_timestamp_ms: now - 9000,
+    product_id: undefined, expiration_at_ms: undefined }));
+  assert.deepEqual(await state(), expected({ status: "cancelled", will_renew: false }));
+
+  await send(event({ id: "uncancel", type: "UNCANCELLATION", event_timestamp_ms: now - 8000 }));
+  assert.deepEqual(await state(), expected());
+
+  await send(event({ id: "renew", type: "RENEWAL", event_timestamp_ms: now - 7000,
+    product_id: "pro_yearly", expiration_at_ms: future + day }));
+  assert.deepEqual(await state(), expected({ product_id: "pro_yearly", expires_at_ms: future + day }));
+
+  await send(event({ id: "expire", type: "EXPIRATION", event_timestamp_ms: now - 6000,
+    product_id: null, expiration_at_ms: null }));
+  assert.deepEqual(await state(), expected({ status: "expired", active: false, will_renew: false,
+    product_id: "pro_yearly", expires_at_ms: future + day }));
+
+  await send(event({ id: "repurchase", event_timestamp_ms: now - 5000 }));
+  assert.deepEqual(await state(), expected());
+
+  await send(event({ id: "refund", type: "REFUND", event_timestamp_ms: now - 4000 }));
+  assert.deepEqual(await state(), expected({ status: "refunded", active: false, will_renew: false }));
+
+  await send(event({ id: "renew-after-refund", type: "RENEWAL", event_timestamp_ms: now - 3000 }));
+  assert.deepEqual(await state(), expected());
+});
+
+for (const type of ["INITIAL_PURCHASE", "RENEWAL", "UNCANCELLATION", "CANCELLATION"]) {
+  test(`${type} automatically expires without an EXPIRATION webhook`, async () => {
+    await send(event({ type, expiration_at_ms: now - 1 }));
+    assert.deepEqual(await state(), expected({
+      status: "expired", active: false, will_renew: false, expires_at_ms: now - 1,
+    }));
+  });
+}
+
+test("only the four required fields are needed; zero timestamps and null optional fields are accepted", async () => {
+  await send({ id: "minimal", type: "INITIAL_PURCHASE", app_user_id: "user_1", event_timestamp_ms: 0 });
+  assert.deepEqual(await state(), expected({ status: "expired", active: false, will_renew: false,
+    product_id: null, expires_at_ms: null }));
+  await send(event({ id: "zero-expiry", event_timestamp_ms: 1, expiration_at_ms: 0, product_id: null }));
+  assert.deepEqual(await state(), expected({ status: "expired", active: false, will_renew: false,
+    product_id: null, expires_at_ms: 0 }));
+});
+
+test("duplicate IDs cannot replace the payload or affect another user", async () => {
+  const original = event();
+  await send(original);
+  await send(original);
+  await send(event({ type: "REFUND", event_timestamp_ms: now }));
+  await send(event({ app_user_id: "user_2", event_timestamp_ms: now }));
+  assert.equal(await countEvents(), 1);
+  assert.deepEqual(await state(), expected());
+  assert.equal((await state("user_2")).status, "none");
+});
+
+test("late and replayed old events never replace newer state or metadata", async () => {
+  await send(event({ id: "latest", type: "REFUND", event_timestamp_ms: now }));
+  const old = event({ id: "old", type: "RENEWAL", product_id: "old_product", expiration_at_ms: future + day });
+  await send(old);
+  await send(old);
+  await send({ ...old, event_timestamp_ms: now + 1000 });
+  assert.equal(await countEvents(), 2);
+  assert.deepEqual(await state(), expected({ status: "refunded", active: false, will_renew: false }));
+});
+
+test("an older refund or expiration cannot revoke a newer renewal", async () => {
+  await send(event({ id: "latest", type: "RENEWAL", event_timestamp_ms: now }));
+  await send(event({ id: "old-refund", type: "REFUND", event_timestamp_ms: now - 2 }));
+  await send(event({ id: "old-expiry", type: "EXPIRATION", event_timestamp_ms: now - 1 }));
+  assert.deepEqual(await state(), expected());
+});
+
+test("a cancellation received before its purchase inherits expiry without losing cancellation", async () => {
+  await send(event({ id: "cancel", type: "CANCELLATION", event_timestamp_ms: now,
+    expiration_at_ms: undefined, product_id: undefined }));
+  assert.equal((await state()).active, false);
+  await send(event());
+  assert.deepEqual(await state(), expected({ status: "cancelled", will_renew: false }));
+});
+
+test("unknown event types are acknowledged and deduplicated without changing state", async () => {
+  const unknown = event({ id: "unknown", type: "NEW_PLATFORM_EVENT", event_timestamp_ms: now + day,
+    expiration_at_ms: future + day, product_id: "unrecognized_product" });
+  await send(unknown);
+  await send(unknown);
+  assert.equal((await state()).status, "none");
+  await send(event());
+  assert.deepEqual(await state(), expected());
+  await send({ ...unknown, id: "unknown2" });
+  assert.deepEqual(await state(), expected());
+  await send({ ...unknown, type: "REFUND" });
+  assert.deepEqual(await state(), expected());
+  assert.equal(await countEvents(), 3);
+});
+
+test("equal timestamps use a stable event-ID ordering regardless of arrival order", async () => {
+  for (const [user, reverse] of [["forward", false], ["reverse", true]]) {
+    const events = [
+      event({ id: `${user}-a`, app_user_id: user }),
+      event({ id: `${user}-z`, app_user_id: user, type: "REFUND" }),
+    ];
+    for (const value of reverse ? events.reverse() : events) await send(value);
+    assert.equal((await state(user)).status, "refunded");
+  }
+});
+
+for (const latestType of ["RENEWAL", "REFUND", "CANCELLATION"]) {
+  test(`concurrent, unordered, repeated deliveries converge to the latest ${latestType}`, async () => {
+    const events = Array.from({ length: 40 }, (_, i) => event({
+      id: `concurrent-${i}`, type: i === 39 ? latestType : ["REFUND", "RENEWAL", "EXPIRATION"][i % 3],
+      event_timestamp_ms: now - 1000 + i, product_id: `product-${i}`, expiration_at_ms: future + i,
+    }));
+    // Deterministic permutation, with the newest event interleaved and duplicates
+    // running in the same burst. No serialized read-before-write can be assumed.
+    const unordered = Array.from({ length: 40 }, (_, i) => events[(i * 17) % 40]);
+    const responses = await Promise.all([...unordered, ...unordered.slice(0, 20)]
+      .map(value => post({ event: value })));
+    for (const response of responses) {
+      assert.equal(response.status, 200);
+      assert.deepEqual(await response.json(), { ok: true });
+    }
+    assert.equal(await countEvents(), 40);
+    assert.deepEqual(await state(), expected({
+      status: latestType === "REFUND" ? "refunded" : latestType === "CANCELLATION" ? "cancelled" : "active",
+      active: latestType !== "REFUND", will_renew: latestType === "RENEWAL",
+      product_id: "product-39", expires_at_ms: future + 39,
+    }));
+  });
+}
+
+test("concurrent deliveries of one ID commit exactly one immutable event", async () => {
+  const responses = await Promise.all(Array.from({ length: 30 }, () => post({ event: event() })));
+  for (const response of responses) {
+    assert.equal(response.status, 200);
+    assert.deepEqual(await response.json(), { ok: true });
+  }
+  assert.equal(await countEvents(), 1);
+  assert.deepEqual(await state(), expected());
+});
+
+test("encoded user IDs and SQL-looking input are handled as literal values", async () => {
+  const user = "用户 /a+b?x=#' OR 1=1 --";
+  await send(event({ app_user_id: user }));
+  assert.deepEqual(await state(user), expected({ app_user_id: user }));
+  assert.equal((await state()).status, "none");
+  const response = await server.fetch("/v1/users/%E0%A4%A/subscription", {
+    headers: { Authorization: `Bearer ${secrets.API_TOKEN}` },
+  });
+  assert.equal(response.status, 400);
+  await response.json();
+});
+
+test("a failed write returns 500, leaves no processed marker, and can be retried", async () => {
+  await db.prepare(`CREATE TRIGGER reject_test_event BEFORE INSERT ON subscription_events
+    WHEN NEW.id = 'retry-me' BEGIN SELECT RAISE(ABORT, 'simulated storage failure'); END`).run();
+  try {
+    const response = await post({ event: event({ id: "retry-me" }) });
+    assert.equal(response.status, 500);
+    assert.deepEqual(await response.json(), { error: "Internal server error" });
+    assert.equal(await countEvents(), 0);
+    assert.equal((await state()).status, "none");
+  } finally {
+    await db.prepare("DROP TRIGGER reject_test_event").run();
+  }
+  await send(event({ id: "retry-me" }));
+  assert.equal(await countEvents(), 1);
+  assert.deepEqual(await state(), expected());
+});
+
+test("unsupported paths and methods return JSON errors", async () => {
+  const missing = await server.fetch("/unknown");
+  assert.equal(missing.status, 404);
+  await missing.json();
+  const wrongMethod = await server.fetch("/v1/webhooks/subscription", {
+    headers: { Authorization: `Bearer ${secrets.WEBHOOK_SECRET}` },
+  });
+  assert.equal(wrongMethod.status, 405);
+  assert.equal(wrongMethod.headers.get("Allow"), "POST");
+  await wrongMethod.json();
+});
+
+test("empty or missing configured secrets fail closed", async () => {
+  const unconfigured = createTestHarness({ workers: [{ config: {
+    name: "unconfigured-subscription-service",
+    main: "./src/index.ts",
+    compatibility_date: "2026-11-08",
+    vars: { WEBHOOK_SECRET: "" },
+  } }] });
+  try {
+    await unconfigured.listen();
+    for (const [path, authorization] of [
+      ["/v1/webhooks/subscription", "Bearer "],
+      ["/v1/users/user_1/subscription", "Bearer undefined"],
+    ]) {
+      const response = await unconfigured.fetch(path, { headers: { Authorization: authorization } });
+      assert.equal(response.status, 401);
+      await response.json();
+    }
+  } finally {
+    await unconfigured.close();
+  }
+});
diff --git a/test/subscriptions.test.mjs b/test/subscriptions.test.mjs
new file mode 100644
index 0000000..ed01150
--- /dev/null
+++ b/test/subscriptions.test.mjs
@@ -0,0 +1,34 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { toSubscription } from "../src/subscriptions.ts";
+
+const expiry = 1_730_000_000_000;
+
+for (const type of ["INITIAL_PURCHASE", "RENEWAL", "UNCANCELLATION", "CANCELLATION"]) {
+  test(`${type}: entitlement ends exactly at the expiration millisecond`, () => {
+    const row = { type, product_id: "pro_monthly", expires_at_ms: expiry };
+    assert.deepEqual(toSubscription("user_1", row, expiry - 1), {
+      app_user_id: "user_1",
+      status: type === "CANCELLATION" ? "cancelled" : "active",
+      active: true,
+      product_id: "pro_monthly",
+      expires_at_ms: expiry,
+      will_renew: type !== "CANCELLATION",
+    });
+    for (const now of [expiry, expiry + 1]) {
+      const result = toSubscription("user_1", row, now);
+      assert.equal(result.status, "expired");
+      assert.equal(result.active, false);
+      assert.equal(result.will_renew, false);
+    }
+  });
+}
+
+for (const [type, status] of [["REFUND", "refunded"], ["EXPIRATION", "expired"]]) {
+  test(`${type}: future expiration does not grant access`, () => {
+    const result = toSubscription("user_1", { type, product_id: null, expires_at_ms: expiry }, expiry - 1);
+    assert.equal(result.status, status);
+    assert.equal(result.active, false);
+    assert.equal(result.will_renew, false);
+  });
+}

# Copy to runner/local.env (git-ignored) and adjust. Paths only; never put secrets in this file.
SHIPBENCH_USER=agenteval
# SHIPBENCH_USER_HOME=/Users/agenteval
# UDID of the agent user's own iOS simulator (xcrun simctl list devices, run as that user)
SHIPBENCH_SIMULATOR=
# Where results go (default: runs/ in the repository)
# SHIPBENCH_RUNS=/path/to/runs
# Credentials: either set the variable itself in your shell, or point to a file containing KEY=value
# CLAUDE_CODE_OAUTH_TOKEN / SHIPBENCH_CLAUDE_TOKEN_ENV=~/path/claude.env   (from `claude setup-token`)
SHIPBENCH_CLAUDE_TOKEN_ENV=
# Codex with a ChatGPT login: path to auth.json (refreshed tokens are written back to this file)
SHIPBENCH_CODEX_AUTH=
# Qwen Code via Alibaba Cloud Model Studio: DASHSCOPE_API_KEY / SHIPBENCH_DASHSCOPE_ENV=~/path/dashscope.env
SHIPBENCH_DASHSCOPE_ENV=
